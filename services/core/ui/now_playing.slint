import { Theme } from "theme.slint";

export component NowPlayingView inherits Rectangle {
    in property <string> track_title: "Waiting for Bluetooth Connection...";
    in property <string> track_artist: "DietPi Audiophile Speaker";
    in property <string> track_album: "High-Resolution DSP Sink";
    in property <string> stream_details: "aptX-HD 576k | 48kHz/16-bit -> DSP 32-bit";
    in property <string> position_text: "00:00";
    in property <string> duration_text: "00:00";
    in property <float> progress_ratio: 0.0;
    in property <bool> is_playing: false;
    in property <bool> is_muted: false;
    in property <bool> has_cover_art: false;
    in property <image> cover_image;
    in property <float> left_peak_ratio: 0.0;
    in property <float> right_peak_ratio: 0.0;
    in-out property <float> volume_value: 75.0;

    callback toggle_play_pause();
    callback next_track();
    callback previous_track();
    callback seek(float);
    callback toggle_mute();
    callback volume_changed(float);
    callback stream_pill_clicked();

    HorizontalLayout {
        padding: 16px;
        spacing: 20px;

        // Left Column: 260x260 Cover Art / Procedural Vinyl Box
        Rectangle {
            width: 260px;
            height: 260px;
            border-radius: 16px;
            clip: true;
            background: Theme.active.card_surface;
            border-width: 1px;
            border-color: Theme.active.card_border;

            // 1. Cover Art Image (if available)
            if root.has_cover_art : Image {
                width: 100%;
                height: 100%;
                source: root.cover_image;
                image-fit: cover;
            }

            // 2. Procedural Vinyl Fallback Disc
            if !root.has_cover_art : Rectangle {
                width: 100%;
                height: 100%;
                background: #0d1117;

                // Outer Disc Rim
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 240px;
                    height: 240px;
                    border-radius: 120px;
                    background: #141922;
                    border-width: 2px;
                    border-color: #21262d;

                    // Groove Ring 1
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 196px;
                        height: 196px;
                        border-radius: 98px;
                        border-width: 1px;
                        border-color: #1e2430;

                        // Groove Ring 2
                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 154px;
                            height: 154px;
                            border-radius: 77px;
                            border-width: 1px;
                            border-color: #262e3d;

                            // Center Record Label
                            Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 100px;
                                height: 100px;
                                border-radius: 50px;
                                background: Theme.active.card_surface;
                                border-width: 2px;
                                border-color: Theme.active.primary_accent;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;

                                    HorizontalLayout {
                                        alignment: center;
                                        height: 14px;
                                        if root.is_playing : Path {
                                            width: 10px;
                                            height: 12px;
                                            MoveTo { x: 1; y: 0; }
                                            LineTo { x: 10; y: 6; }
                                            LineTo { x: 1; y: 12; }
                                            Close {}
                                            fill: Theme.active.primary_accent;
                                        }
                                        if !root.is_playing : HorizontalLayout {
                                            spacing: 3px;
                                            Rectangle { width: 3px; height: 10px; border-radius: 1px; background: Theme.active.primary_accent; }
                                            Rectangle { width: 3px; height: 10px; border-radius: 1px; background: Theme.active.primary_accent; }
                                        }
                                    }

                                    Text {
                                        text: "A2DP SINK";
                                        font-size: 10px;
                                        font-weight: 800;
                                        color: Theme.active.secondary_accent;
                                        horizontal-alignment: center;
                                    }

                                    Text {
                                        text: "BLUETOOTH";
                                        font-size: 8px;
                                        font-weight: 700;
                                        color: Theme.active.text_muted;
                                        horizontal-alignment: center;
                                    }
                                }

                                // Spindle Hole
                                Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: 14px;
                                    height: 14px;
                                    border-radius: 7px;
                                    background: #090d12;
                                    border-width: 1px;
                                    border-color: Theme.active.card_border;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Right Column: Track Info, Scrubber, Transport & Mini VU
        VerticalLayout {
            alignment: space-between;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 8px;

            // Track metadata
            VerticalLayout {
                spacing: 4px;

                Text {
                    text: root.track_title;
                    font-size: 22px;
                    font-weight: 800;
                    color: Theme.active.text_primary;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: 6px;

                    Text {
                        text: root.track_artist;
                        font-size: 15px;
                        font-weight: 600;
                        color: Theme.active.secondary_accent;
                        overflow: elide;
                    }

                    Text {
                        text: "-";
                        color: Theme.active.text_muted;
                        font-size: 14px;
                    }

                    Text {
                        text: root.track_album;
                        font-size: 14px;
                        color: Theme.active.text_muted;
                        overflow: elide;
                    }
                }
            }

            // Audio stream inspector pill
            HorizontalLayout {
                alignment: start;

                Rectangle {
                    height: 26px;
                    background: Theme.active.card_surface;
                    border-radius: 13px;
                    border-width: 1px;
                    border-color: Theme.active.card_border;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        alignment: center;

                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.active.primary_accent;
                            y: 10px;
                        }

                        Text {
                            text: root.stream_details;
                            font-size: 11px;
                            font-weight: 600;
                            color: Theme.active.primary_accent;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.stream_pill_clicked();
                        }
                    }
                }
            }

            // Playback progress scrubber
            HorizontalLayout {
                spacing: 10px;
                alignment: center;

                Text {
                    text: root.position_text;
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.active.text_muted;
                    vertical-alignment: center;
                    width: 42px;
                    horizontal-alignment: right;
                }

                Rectangle {
                    height: 16px;
                    background: transparent;

                    Rectangle {
                        x: 0px;
                        y: 5px;
                        width: parent.width;
                        height: 6px;
                        background: #1c2430;
                        border-radius: 3px;

                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.width * Math.max(0.0, Math.min(1.0, root.progress_ratio));
                            height: parent.height;
                            background: Theme.active.primary_accent;
                            border-radius: 3px;
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.seek(Math.max(0.0, Math.min(1.0, self.mouse-x / self.width)));
                        }
                        moved => {
                            root.seek(Math.max(0.0, Math.min(1.0, self.mouse-x / self.width)));
                        }
                    }
                }

                Text {
                    text: root.duration_text;
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.active.text_muted;
                    vertical-alignment: center;
                    width: 42px;
                }
            }

            // Transport controls row (No repeat/shuffle, clean touch targets)
            HorizontalLayout {
                alignment: center;
                spacing: 20px;

                // Previous
                Rectangle {
                    width: 50px;
                    height: 50px;
                    border-radius: 25px;
                    background: Theme.active.card_surface;
                    border-width: 1px;
                    border-color: Theme.active.card_border;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 2px;
                        y: 18px;
                        Rectangle { width: 3px; height: 14px; border-radius: 1px; background: Theme.active.text_primary; }
                        Path {
                            width: 8px; height: 14px;
                            MoveTo { x: 8; y: 0; }
                            LineTo { x: 0; y: 7; }
                            LineTo { x: 8; y: 14; }
                            Close {}
                            fill: Theme.active.text_primary;
                        }
                        Path {
                            width: 8px; height: 14px;
                            MoveTo { x: 8; y: 0; }
                            LineTo { x: 0; y: 7; }
                            LineTo { x: 8; y: 14; }
                            Close {}
                            fill: Theme.active.text_primary;
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.previous_track();
                        }
                    }
                }

                // Play / Pause
                Rectangle {
                    width: 58px;
                    height: 58px;
                    border-radius: 29px;
                    background: Theme.active.primary_accent;

                    if root.is_playing : HorizontalLayout {
                        alignment: center;
                        spacing: 5px;
                        y: 19px;
                        Rectangle { width: 5px; height: 20px; border-radius: 2px; background: Theme.active.dock_active_text; }
                        Rectangle { width: 5px; height: 20px; border-radius: 2px; background: Theme.active.dock_active_text; }
                    }

                    if !root.is_playing : Path {
                        width: 18px;
                        height: 20px;
                        x: 23px;
                        y: 19px;
                        MoveTo { x: 0; y: 0; }
                        LineTo { x: 18; y: 10; }
                        LineTo { x: 0; y: 20; }
                        Close {}
                        fill: Theme.active.dock_active_text;
                    }

                    TouchArea {
                        clicked => {
                            root.toggle_play_pause();
                        }
                    }
                }

                // Next
                Rectangle {
                    width: 50px;
                    height: 50px;
                    border-radius: 25px;
                    background: Theme.active.card_surface;
                    border-width: 1px;
                    border-color: Theme.active.card_border;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 2px;
                        y: 18px;
                        Path {
                            width: 8px; height: 14px;
                            MoveTo { x: 0; y: 0; }
                            LineTo { x: 8; y: 7; }
                            LineTo { x: 0; y: 14; }
                            Close {}
                            fill: Theme.active.text_primary;
                        }
                        Path {
                            width: 8px; height: 14px;
                            MoveTo { x: 0; y: 0; }
                            LineTo { x: 8; y: 7; }
                            LineTo { x: 0; y: 14; }
                            Close {}
                            fill: Theme.active.text_primary;
                        }
                        Rectangle { width: 3px; height: 14px; border-radius: 1px; background: Theme.active.text_primary; }
                    }

                    TouchArea {
                        clicked => {
                            root.next_track();
                        }
                    }
                }

                // Soft-Mute
                Rectangle {
                    width: 50px;
                    height: 50px;
                    border-radius: 25px;
                    background: Theme.active.card_surface;
                    border-width: 1px;
                    border-color: root.is_muted ? Theme.active.needle_peak : Theme.active.card_border;

                    Text {
                        text: root.is_muted ? "MUTED" : "VOL";
                        font-size: 11px;
                        font-weight: 700;
                        color: root.is_muted ? Theme.active.needle_peak : Theme.active.secondary_accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => {
                            root.toggle_mute();
                        }
                    }
                }
            }

            // Mini Peak VU visualizer & Volume control
            HorizontalLayout {
                alignment: space-between;
                spacing: 16px;

                // Mini Peak VU meters
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "L";
                        font-size: 11px;
                        font-weight: 700;
                        color: Theme.active.text_muted;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 90px;
                        height: 6px;
                        background: #1c2430;
                        border-radius: 3px;
                        y: 7px;

                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.width * Math.max(0.0, Math.min(1.0, root.left_peak_ratio));
                            height: parent.height;
                            background: Theme.active.primary_accent;
                            border-radius: 3px;
                        }
                    }

                    Text {
                        text: "R";
                        font-size: 11px;
                        font-weight: 700;
                        color: Theme.active.text_muted;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 90px;
                        height: 6px;
                        background: #1c2430;
                        border-radius: 3px;
                        y: 7px;

                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.width * Math.max(0.0, Math.min(1.0, root.right_peak_ratio));
                            height: parent.height;
                            background: Theme.active.primary_accent;
                            border-radius: 3px;
                        }
                    }
                }

                // Volume slider
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Text {
                        text: "VOL";
                        color: Theme.active.text_muted;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 110px;
                        height: 16px;
                        background: transparent;

                        Rectangle {
                            x: 0px;
                            y: 5px;
                            width: parent.width;
                            height: 6px;
                            background: #1c2430;
                            border-radius: 3px;

                            Rectangle {
                                x: 0px;
                                y: 0px;
                                width: parent.width * (root.volume_value >= 0.0 ? (root.volume_value <= 100.0 ? root.volume_value / 100.0 : 1.0) : 0.0);
                                height: parent.height;
                                background: Theme.active.secondary_accent;
                                border-radius: 3px;
                            }
                        }

                        TouchArea {
                            moved => {
                                root.volume_value = Math.max(0.0, Math.min(100.0, self.mouse-x / self.width * 100.0));
                                root.volume_changed(root.volume_value);
                            }
                            clicked => {
                                root.volume_value = Math.max(0.0, Math.min(100.0, self.mouse-x / self.width * 100.0));
                                root.volume_changed(root.volume_value);
                            }
                        }
                    }

                    Text {
                        text: "\{Math.round(root.volume_value >= 0.0 ? (root.volume_value <= 100.0 ? root.volume_value : 100.0) : 0.0)}%";
                        color: Theme.active.secondary_accent;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                        width: 38px;
                    }
                }
            }
        }
    }
}
