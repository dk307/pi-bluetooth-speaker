import { SplashScreen } from "splash.slint";
import { Theme, ThemePalette } from "theme.slint";
import { TopStatusBar } from "status_bar.slint";
import { MainViewport } from "viewport.slint";
import { NavDock } from "nav_dock.slint";

export { SplashScreen, Theme, ThemePalette }

export component MainWindow inherits Window {
    title: "DietPi Audiophile Console";
    width: 800px;
    height: 480px;
    background: Theme.active.chassis;
    default-font-family: "sans-serif";

    in-out property <int> active_tab: 0;
    in-out property <string> active_source: "Bluetooth";
    in-out property <string> track_or_device: "Waiting for Connection...";
    in-out property <string> stream_codec: "aptX-HD 48kHz";
    in-out property <string> track_title: "Waiting for Bluetooth Connection...";
    in-out property <string> track_artist: "DietPi Speaker";
    in-out property <string> track_album: "Audiophile DSP Sink";
    in-out property <float> volume_value: 75.0;
    in-out property <bool> is_playing: false;

    callback toggle_play_pause();
    callback volume_changed(float);
    callback source_clicked();
    callback night_mode_clicked();
    callback tab_selected(int);
    callback select_theme(int);
    callback cycle_theme();

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Top Status Bar: 800 x 40
        status_bar := TopStatusBar {
            active_source: root.active_source;
            track_or_device: root.track_or_device;
            stream_codec: root.stream_codec;
            source_clicked => { root.source_clicked(); }
            night_mode_clicked => { root.night_mode_clicked(); }
        }

        // Middle Viewport: 800 x 380
        viewport := MainViewport {
            active_tab: root.active_tab;
            track_title: root.track_title;
            track_artist: root.track_artist;
            track_album: root.track_album;
            volume_value: root.volume_value;
            is_playing: root.is_playing;
            toggle_play_pause => { root.toggle_play_pause(); }
            volume_changed(val) => {
                root.volume_value = val;
                root.volume_changed(val);
            }
            select_theme(idx) => { root.select_theme(idx); }
            cycle_theme => { root.cycle_theme(); }
        }

        // Bottom Navigation Dock: 800 x 60
        dock := NavDock {
            active_tab: root.active_tab;
            tab_selected(idx) => {
                root.active_tab = idx;
                root.tab_selected(idx);
            }
        }
    }
}
