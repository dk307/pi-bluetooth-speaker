import { Theme } from "theme.slint";

export struct BootCheckLine {
    text: string,
    running: bool,
    ok: bool,
}

// One boot check row: status glyph plus live status text (theme main font).
// The row is content-sized so the parent layout can center it horizontally.
component CheckRow inherits HorizontalLayout {
    in property <BootCheckLine> check;

    spacing: 14px;

    Text {
        text: check.running ? "●" : (check.ok ? "✓" : "✗");
        color: check.running ? Theme.active.text_muted
            : (check.ok ? Theme.active.primary_accent : Theme.active.needle_peak);
        vertical-alignment: center;
        font-size: 28px;
    }
    Text {
        text: check.text;
        color: Theme.active.text_primary;
        font-size: 28px;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Animated equalizer logo band (svg-accurate: four rounded bars, per-bar
// period/phase/opacity). Bars are absolutely positioned so they stay
// bottom-aligned while the animation-tick() height binding re-evaluates.
component EqBars inherits Rectangle {
    background: transparent;

    property <length> bar-width: 40px;
    property <length> bar-gap: 30px;
    property <length> bar-min-height: 24px;

    width: 4 * bar-width + 3 * bar-gap;

    Rectangle {
        x: 0 * (bar-width + bar-gap);
        width: bar-width;
        y: (parent.height - self.height) / 2;
        height: bar-min-height + Math.max(Math.sin(360deg * animation-tick() / 1.2s), 0.0) * (parent.height - bar-min-height);
        border-radius: self.width / 2;
        background: Theme.active.primary_accent;
        opacity: 1.0;
    }
    Rectangle {
        x: 1 * (bar-width + bar-gap);
        width: bar-width;
        y: (parent.height - self.height) / 2;
        height: bar-min-height + Math.max(Math.sin(360deg * (animation-tick() + 0.3s) / 0.9s), 0.0) * (parent.height - bar-min-height);
        border-radius: self.width / 2;
        background: Theme.active.primary_accent;
        opacity: 0.85;
    }
    Rectangle {
        x: 2 * (bar-width + bar-gap);
        width: bar-width;
        y: (parent.height - self.height) / 2;
        height: bar-min-height + Math.max(Math.sin(360deg * (animation-tick() + 0.6s) / 1.4s), 0.0) * (parent.height - bar-min-height);
        border-radius: self.width / 2;
        background: Theme.active.primary_accent;
        opacity: 1.0;
    }
    Rectangle {
        x: 3 * (bar-width + bar-gap);
        width: bar-width;
        y: (parent.height - self.height) / 2;
        height: bar-min-height + Math.max(Math.sin(360deg * (animation-tick() + 0.9s) / 1.1s), 0.0) * (parent.height - bar-min-height);
        border-radius: self.width / 2;
        background: Theme.active.primary_accent;
        opacity: 0.7;
    }
}

export component SplashScreen inherits Window {
    width: 800px;
    height: 480px;
    background: Theme.active.chassis;
    default-font-family: Theme.active.font_family;

    // Single bottom check line, replaced as each boot check progresses.
    in property <BootCheckLine> current_check: {
        text: "Starting system checks …",
        running: true,
        ok: false,
    };

    VerticalLayout {
        padding: 40px;
        spacing: 20px;

        // Logo band fills all leftover space; equalizer stays vertically centered.
        Rectangle {
            background: transparent;
            vertical-stretch: 1;

            EqBars {
                y: (parent.height - self.height) / 2;
                height: 120px;
            }
        }

        // Bottom: the current boot check line only, horizontally centered.
        HorizontalLayout {
            alignment: center;

            CheckRow {
                check: root.current_check;
            }
        }
    }
}
