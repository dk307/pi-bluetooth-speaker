import { Theme } from "theme.slint";

component NavDockButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> is_active: false;
    callback clicked();

    height: 48px;
    background: root.is_active ? Theme.active.primary_accent : transparent;
    border-radius: 12px;

    HorizontalLayout {
        alignment: center;
        spacing: 6px;

        Text {
            text: root.icon;
            font-size: 15px;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            font-size: 13px;
            font-weight: root.is_active ? 800 : 500;
            color: root.is_active ? Theme.active.dock_active_text : Theme.active.text_muted;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component NavDock inherits Rectangle {
    height: 60px;
    background: Theme.active.chassis;

    in-out property <int> active_tab: 0;
    callback tab_selected(int);

    // Top subtle divider line
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 1px;
        background: Theme.active.card_border;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;
        alignment: space-between;

        NavDockButton {
            icon: "🎵";
            label: "Player";
            is_active: root.active_tab == 0;
            clicked => {
                root.active_tab = 0;
                root.tab_selected(0);
            }
        }

        NavDockButton {
            icon: "🎚️";
            label: "VU Meter";
            is_active: root.active_tab == 1;
            clicked => {
                root.active_tab = 1;
                root.tab_selected(1);
            }
        }

        NavDockButton {
            icon: "📶";
            label: "Bluetooth";
            is_active: root.active_tab == 2;
            clicked => {
                root.active_tab = 2;
                root.tab_selected(2);
            }
        }

        NavDockButton {
            icon: "💿";
            label: "CD Player";
            is_active: root.active_tab == 3;
            clicked => {
                root.active_tab = 3;
                root.tab_selected(3);
            }
        }

        NavDockButton {
            icon: "🎛️";
            label: "DSP & Tone";
            is_active: root.active_tab == 4;
            clicked => {
                root.active_tab = 4;
                root.tab_selected(4);
            }
        }

        NavDockButton {
            icon: "⚙️";
            label: "Settings";
            is_active: root.active_tab == 5;
            clicked => {
                root.active_tab = 5;
                root.tab_selected(5);
            }
        }
    }
}
