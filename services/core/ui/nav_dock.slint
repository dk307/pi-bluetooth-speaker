import { Theme } from "theme.slint";

component NavDockButton inherits Rectangle {
    in property <image> icon;
    in property <bool> is_active: false;
    callback clicked();

    height: 48px;
    width: 90px;
    background: root.is_active ? Theme.active.primary_accent : transparent;
    border-radius: 14px;

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        width: 32px;
        height: 32px;
        colorize: root.is_active ? Theme.active.dock_active_text : Theme.active.text_muted;
        image-fit: contain;
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component NavDock inherits Rectangle {
    height: 60px;
    background: Theme.active.chassis;

    in-out property <int> active_tab: 0;
    in property <bool> cd_enabled: false;
    callback tab_selected(int);

    // Top subtle divider line
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 1px;
        background: Theme.active.card_border;
    }

    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        alignment: space-around;

        VerticalLayout {
            alignment: center;
            NavDockButton {
                icon: @image-url("../../../assets/icons/player.svg");
                is_active: root.active_tab == 0;
                clicked => {
                    root.active_tab = 0;
                    root.tab_selected(0);
                }
            }
        }

        VerticalLayout {
            alignment: center;
            NavDockButton {
                icon: @image-url("../../../assets/icons/peppymeter.svg");
                is_active: root.active_tab == 1;
                clicked => {
                    root.active_tab = 1;
                    root.tab_selected(1);
                }
            }
        }

        VerticalLayout {
            alignment: center;
            NavDockButton {
                icon: @image-url("../../../assets/icons/bluetooth.svg");
                is_active: root.active_tab == 2;
                clicked => {
                    root.active_tab = 2;
                    root.tab_selected(2);
                }
            }
        }

        if root.cd_enabled : VerticalLayout {
            alignment: center;
            NavDockButton {
                icon: @image-url("../../../assets/icons/disk.svg");
                is_active: root.active_tab == 3;
                clicked => {
                    root.active_tab = 3;
                    root.tab_selected(3);
                }
            }
        }

        VerticalLayout {
            alignment: center;
            NavDockButton {
                icon: @image-url("../../../assets/icons/equalizer.svg");
                is_active: root.active_tab == 4;
                clicked => {
                    root.active_tab = 4;
                    root.tab_selected(4);
                }
            }
        }

        VerticalLayout {
            alignment: center;
            NavDockButton {
                icon: @image-url("../../../assets/icons/config.svg");
                is_active: root.active_tab == 5;
                clicked => {
                    root.active_tab = 5;
                    root.tab_selected(5);
                }
            }
        }
    }
}
