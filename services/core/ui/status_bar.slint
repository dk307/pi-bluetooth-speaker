import { Theme } from "theme.slint";

export component TopStatusBar inherits Rectangle {
    height: 40px;
    background: Theme.active.chassis;

    in property <string> active_source: "Bluetooth";
    in property <string> track_or_device: "Waiting for Connection...";
    in property <string> stream_codec: "aptX-HD 48kHz";

    callback source_clicked();
    callback night_mode_clicked();

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: space-between;

        // Left: Source Pill
        HorizontalLayout {
            alignment: start;
            Rectangle {
                height: 28px;
                background: Theme.active.card_surface;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.active.card_border;
                y: 6px;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 6px;
                    alignment: center;

                    // Vector signal bars
                    HorizontalLayout {
                        alignment: center;
                        spacing: 2px;
                        y: 9px;
                        Rectangle { width: 3px; height: 4px; border-radius: 1px; background: Theme.active.primary_accent; y: 6px; }
                        Rectangle { width: 3px; height: 7px; border-radius: 1px; background: Theme.active.primary_accent; y: 3px; }
                        Rectangle { width: 3px; height: 10px; border-radius: 1px; background: Theme.active.primary_accent; y: 0px; }
                    }

                    Text {
                        text: root.active_source;
                        color: Theme.active.primary_accent;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    // Vector dropdown chevron
                    Path {
                        width: 6px;
                        height: 4px;
                        MoveTo { x: 0; y: 0; }
                        LineTo { x: 6; y: 0; }
                        LineTo { x: 3; y: 4; }
                        Close {}
                        fill: Theme.active.text_muted;
                        y: 12px;
                    }
                }

                TouchArea {
                    clicked => {
                        root.source_clicked();
                    }
                }
            }
        }

        // Center: Track / Client Quick Info
        HorizontalLayout {
            alignment: center;
            Text {
                text: root.track_or_device;
                color: Theme.active.text_primary;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                max-width: 380px;
            }
        }

        // Right: Audio Codec Badge + Night Mode Toggle
        HorizontalLayout {
            alignment: end;
            spacing: 10px;

            Rectangle {
                height: 28px;
                background: Theme.active.card_surface;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.active.card_border;
                y: 6px;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: center;

                    Text {
                        text: root.stream_codec;
                        color: Theme.active.secondary_accent;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                width: 36px;
                height: 28px;
                background: Theme.active.card_surface;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.active.card_border;
                y: 6px;

                Text {
                    text: "DIM";
                    font-size: 10px;
                    font-weight: 800;
                    color: Theme.active.text_muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        root.night_mode_clicked();
                    }
                }
            }
        }
    }
}
