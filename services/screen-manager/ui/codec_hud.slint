import {
    HorizontalDivider,
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
    OutlinedCard,
    TouchScale,
} from "@material/material.slint";
import { OverlayAppBar } from "screen_app_bar.slint";

// One Material 3 key/value row in the codec information card.
component CodecRow inherits Rectangle {
    in property <string> label;
    in property <string> value;

    min-height: max(36px * TouchScale.widget_scale, row_layout.min-height);

    row_layout := HorizontalLayout {
        padding-left: MaterialStyleMetrics.padding_16;
        padding-right: MaterialStyleMetrics.padding_16;
        padding-top: MaterialStyleMetrics.padding_6;
        padding-bottom: MaterialStyleMetrics.padding_6;
        spacing: MaterialStyleMetrics.spacing_12;

        MaterialText {
            text: root.label;
            style: MaterialTypography.label_large;
            color: MaterialPalette.on_surface_variant;
            vertical-alignment: center;
            overflow: elide;
            wrap: no-wrap;
            width: 140px * TouchScale.widget_scale;
        }

        MaterialText {
            text: root.value;
            style: MaterialTypography.title_medium;
            color: MaterialPalette.on_surface;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
            wrap: no-wrap;
            horizontal-stretch: 1;
        }
    }
}

// Codec information overlay, opened by tapping the codec badge in the top bar.
//
// Mirrors the Volume HUD: a full-viewport panel below the top bar with its own
// overlay app bar ("Codec" + close) and a backdrop touch catcher that dismisses
// the panel when the user taps outside the information.
export component CodecHudOverlay inherits Rectangle {
    width: 100%;
    height: 100%;
    background: @linear-gradient(150deg, MaterialPalette.surface 0%, MaterialPalette.background 100%);
    border-width: 1px;
    border-color: MaterialPalette.outline_variant;
    clip: true;

    // Negotiated stream properties of the connected device.
    in property <string> codec: "";
    in property <string> sample_rate: "";
    in property <string> bit_depth: "";
    in property <string> stream_format: "";
    in property <string> delay_text: "";
    // False while no Bluetooth device is connected (no stream to report).
    in property <bool> connected: false;

    callback dismiss_requested();

    // Value shown for a property that is not available (no active stream).
    property <string> unknown: "—";

    // Full-viewport backdrop touch catcher: prevents touches from leaking through to
    // the underlying tab and allows tapping empty space to dismiss the panel early.
    backdrop_touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.dismiss_requested();
        }
    }

    VerticalLayout {
        // Header — title "Codec", close icon on the right.
        Rectangle {
            height: MaterialStyleMetrics.size_64;
            OverlayAppBar {
                width: 100%;
                height: 100%;
                title: "Codec";
                trailing_icon: @image-url("../../../assets/icons/close.svg");
                trailing_tooltip: "Close";
                trailing_clicked => { root.dismiss_requested(); }
            }
        }

        // Body — centers the Material 3 OutlinedCard inside the remaining space.
        VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            padding-left: MaterialStyleMetrics.padding_24;
            padding-right: MaterialStyleMetrics.padding_24;
            padding-top: MaterialStyleMetrics.padding_16;
            padding-bottom: MaterialStyleMetrics.padding_16;

            HorizontalLayout {
                alignment: center;

                OutlinedCard {
                    width: min(root.width - 2 * MaterialStyleMetrics.padding_24, 560px * TouchScale.widget_scale);

                    VerticalLayout {
                        padding-top: MaterialStyleMetrics.padding_8;
                        padding-bottom: MaterialStyleMetrics.padding_8;

                        CodecRow {
                            label: "Codec";
                            value: root.connected ? root.codec : root.unknown;
                        }
                        HorizontalDivider {}
                        CodecRow {
                            label: "Sample Rate";
                            value: root.connected ? root.sample_rate : root.unknown;
                        }
                        HorizontalDivider {}
                        CodecRow {
                            label: "Bit Depth";
                            value: root.connected ? root.bit_depth : root.unknown;
                        }
                        HorizontalDivider {}
                        CodecRow {
                            label: "Format";
                            value: root.connected ? root.stream_format : root.unknown;
                        }
                        HorizontalDivider {}
                        CodecRow {
                            label: "Latency";
                            value: root.connected ? root.delay_text : root.unknown;
                        }
                    }
                }
            }
        }
    }
}
