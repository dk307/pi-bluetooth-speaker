import { MaterialPalette } from "@material/material.slint";
import { OverlayAppBar } from "screen_app_bar.slint";

// One label / value line in the codec information panel.
component CodecRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <length> row_y;
    height: 40px;

    Text {
        x: 0;
        y: root.row_y;
        width: 140px;
        height: 40px;
        text: root.label;
        color: MaterialPalette.secondary;
        font-size: 15px;
        font-weight: 800;
        vertical-alignment: center;
    }

    Text {
        x: 152px;  // 140px label + 12px spacing
        y: root.row_y;
        width: 408px;  // 560 - 140 - 12
        height: 40px;
        text: root.value;
        color: MaterialPalette.on_surface;
        font-size: 22px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Codec information overlay, opened by tapping the codec badge in the top bar.
//
// Mirrors the Volume HUD: a full-viewport panel below the top bar with its own
// overlay app bar ("Codec" + close) and a backdrop touch catcher that dismisses
// the panel when the user taps outside the information.
export component CodecHudOverlay inherits Rectangle {
    width: 100%;
    height: 100%;
    background: @linear-gradient(150deg, MaterialPalette.surface 0%, MaterialPalette.background 100%);
    border-width: 1px;
    border-color: MaterialPalette.outline_variant;
    clip: true;

    // Negotiated stream properties of the connected device.
    in property <string> codec: "";
    in property <string> sample_rate: "";
    in property <string> bit_depth: "";
    in property <string> stream_format: "";
    in property <string> delay_text: "";
    // False while no Bluetooth device is connected (no stream to report).
    in property <bool> connected: false;

    callback dismiss_requested();

    // Value shown for a property that is not available (no active stream).
    property <string> unknown: "—";

    // Full-viewport backdrop touch catcher: prevents touches from leaking through to
    // the underlying tab and allows tapping empty space to dismiss the panel early.
    backdrop_touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.dismiss_requested();
        }
    }

    // Root layout: VerticalLayout with appbar first, then body (Volume HUD pattern)
    VerticalLayout {
        // App bar header (60px) — title "Codec", close icon on the right
        Rectangle {
            height: 60px;
            width: 100%;
            OverlayAppBar {
                width: 100%;
                height: 100%;
                title: "Codec";
                trailing_icon: @image-url("../../../assets/icons/close.svg");
                trailing_tooltip: "Close";
                trailing_clicked => { root.dismiss_requested(); }
            }
        }

        // Body content (fills remaining space) — Volume HUD pattern
        VerticalLayout {
            padding-top: 18px;
            padding-bottom: 18px;
            padding-left: 24px;
            padding-right: 24px;

            // Full-width transparent container (Volume HUD slider pattern)
            Rectangle {
                width: 100%;
                height: 100%;
                background: transparent;
                // Don't stretch vertically - let content sit at top

                // Inner centered container (560px) — centered via x formula
                Rectangle {
                    width: 560px;
                    height: 100%;
                    background: transparent;
                    x: (parent.width - self.width) / 2;
                    vertical-stretch: 1;

                    CodecRow { label: "CODEC"; row_y: 0px; value: root.connected ? root.codec : root.unknown; }
                    CodecRow { label: "SAMPLE RATE"; row_y: 46px; value: root.connected ? root.sample_rate : root.unknown; }
                    CodecRow { label: "BIT DEPTH"; row_y: 92px; value: root.connected ? root.bit_depth : root.unknown; }
                    CodecRow { label: "FORMAT"; row_y: 138px; value: root.connected ? root.stream_format : root.unknown; }
                    CodecRow { label: "LATENCY"; row_y: 184px; value: root.connected ? root.delay_text : root.unknown; }
                }
            }
        }
    }
}