import { TouchScale } from "./material_style_metrics.slint";

export struct TextStyle {
    font_size: length,
    font_weight: int
}

// Patched for 800x480 appliance panel:
// Every typography token scales reactively with `TouchScale.clamped_font_scale`.
export global MaterialTypography {
    in-out property <int> regular: 400;
    in-out property <int> medium: 600;
    in-out property <int> semibold: 700;

    out property <TextStyle> display_large: {
        font_size: 32px * TouchScale.clamped_font_scale,
        font_weight: root.regular
    };

    out property <TextStyle> display_medium: {
        font_size: 28px * TouchScale.clamped_font_scale,
        font_weight: root.regular
    };

    out property <TextStyle> display_small: {
        font_size: 24px * TouchScale.clamped_font_scale,
        font_weight: root.regular
    };

    out property <TextStyle> headline_large: {
        font_size: 22px * TouchScale.clamped_font_scale,
        font_weight: root.regular
    };

    out property <TextStyle> headline_medium: {
        font_size: 20px * TouchScale.clamped_font_scale,
        font_weight: root.regular
    };

    out property <TextStyle> headline_small: {
        font_size: 18px * TouchScale.clamped_font_scale,
        font_weight: root.regular
    };

    out property <TextStyle> title_large: {
        font_size: 18px * TouchScale.clamped_font_scale,
        font_weight: root.regular
    };

    out property <TextStyle> title_medium: {
        font_size: 16px * TouchScale.clamped_font_scale,
        font_weight: root.medium
    };

    out property <TextStyle> title_small: {
        font_size: 14px * TouchScale.clamped_font_scale,
        font_weight: root.medium
    };

    out property <TextStyle> label_large: {
        font_size: 14px * TouchScale.clamped_font_scale,
        font_weight: root.medium
    };

    out property <TextStyle> label_medium: {
        font_size: 12px * TouchScale.clamped_font_scale,
        font_weight: root.medium
    };

    out property <TextStyle> label_medium_prominent: {
        font_size: 12px * TouchScale.clamped_font_scale,
        font_weight: root.semibold
    };

    out property <TextStyle> label_small: {
        font_size: 11px * TouchScale.clamped_font_scale,
        font_weight: root.medium
    };

    out property <TextStyle> body_large: {
        font_size: 16px * TouchScale.clamped_font_scale,
        font_weight: root.regular
    };

    out property <TextStyle> body_medium: {
        font_size: 14px * TouchScale.clamped_font_scale,
        font_weight: root.regular
    };

    out property <TextStyle> body_small: {
        font_size: 12px * TouchScale.clamped_font_scale,
        font_weight: root.regular
    };
}
