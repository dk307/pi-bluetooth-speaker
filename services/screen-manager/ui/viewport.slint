import {
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
    TouchScale,
} from "@material/material.slint";
import { AppTheme } from "app_theme.slint";
import { NowPlayingView } from "now_playing.slint";
import { SettingsView, SettingRowItem } from "settings_view.slint";

export component MainViewport inherits Rectangle {
    // `MainWindow` already clears the 800x480 backbuffer to `MaterialPalette.background`
    // and Tab 0 draws its full 800x420 cached gradient layer, so leave the root
    // container transparent to avoid 336,000 pixels of full-viewport overdraw per frame.
    background: transparent;

    in-out property <int> active_tab: 0;
    in property <bool> cd_enabled: false;
    in-out property <bool> show_themes: false;
    in-out property <bool> show_visualizer: false;
    in-out property <bool> show_advanced: false;
    in-out property <bool> show_widget_preview: false;
    in property <[SettingRowItem]> basic_settings;
    in property <[SettingRowItem]> visualizer_settings;
    in property <[SettingRowItem]> advanced_settings;
    in-out property <string> speaker_alias: "DietPi Speaker";
    in-out property <string> track_title: "Waiting for Bluetooth Connection...";
    in-out property <string> track_title_line1: "";
    in-out property <string> track_title_line2: "";
    in-out property <bool> title_split_mode: false;
    in-out property <string> track_artist: "";
    in-out property <string> track_album: "";
    in-out property <string> stream_details: "aptX-HD 576k | 48kHz/16-bit -> DSP 32-bit";
    in-out property <string> position_text: "0:00";
    in-out property <string> duration_text: "0:00";
    in-out property <int> duration_ms: 0;
    // `false` when BlueZ reports the timeline as unknown (`u32::MAX` / absent).
    in-out property <bool> duration_known: true;
    in-out property <bool> position_known: true;
    in-out property <float> progress_ratio: 0.0;
    in-out property <float> volume_value: 75.0;
    in-out property <bool> is_playing: false;
    in property <bool> animations_paused: false;
    in-out property <bool> is_muted: false;
    in property <float> volume_hud_opacity: 0.0;
    in-out property <bool> has_cover_art: false;
    in-out property <image> cover_image;
    in property <string> artist_marquee_text;
    in-out property <string> track_or_device: "Waiting for Connection...";
    in property <string> stream_codec: "aptX-HD";

    callback settings_clicked();
    callback visualizer_clicked();
    callback select_tab(int);
    callback open_bluetooth_devices();
    callback toggle_play_pause();
    callback next_track();
    callback previous_track();
    callback toggle_mute();
    callback volume_changed(float);
    callback stream_pill_clicked();
    callback select_theme(int);
    callback cycle_theme();
    callback font_scale_changed(float);
    callback setting_step(string, int);
    callback setting_toggle(string, bool);

    // Tab 0: Now Playing
    if root.active_tab == 0 : VerticalLayout {
        padding: 0px;

        Rectangle {
            clip: true;

            // Static 800x420 background layer with `cache-rendering-hint: true`
            // so Skia's dithered 150deg linear gradient shader (`set_dither(true)`)
            // and 1px outline border are rasterized once per theme into a GPU FBO
            // texture instead of re-shading 336,000 pixels on every 60 Hz frame.
            Rectangle {
                width: 100%;
                height: 100%;
                background: @linear-gradient(150deg, MaterialPalette.surface 0%, MaterialPalette.background 100%);
                border-radius: 0px;
                border-width: 1px;
                border-color: MaterialPalette.outline_variant;
                cache-rendering-hint: true;
            }

            now_playing := NowPlayingView {
                width: 100%;
                height: 100%;
                track_title: root.track_title;
                track_title_line1: root.track_title_line1;
                track_title_line2: root.track_title_line2;
                title_split_mode: root.title_split_mode;
                track_artist: root.track_artist;
                track_album: root.track_album;
                position_text: root.position_text;
                duration_text: root.duration_text;
                duration_ms: root.duration_ms;
                duration_known: root.duration_known;
                position_known: root.position_known;
                progress_ratio: root.progress_ratio;
                is_playing: root.is_playing;
                animations_paused: root.animations_paused;
                has_cover_art: root.has_cover_art;
                cover_image: root.cover_image;
                artist_marquee_text: root.artist_marquee_text;

                toggle_play_pause => { root.toggle_play_pause(); }
                next_track => { root.next_track(); }
                previous_track => { root.previous_track(); }
                settings_clicked => { root.settings_clicked(); }
                visualizer_clicked => { root.visualizer_clicked(); }
            }
        }
    }

    // Tab 1 is reserved for full-screen VisualizerOverlay in MainWindow.

    // Tab 3: CD Player
    if root.active_tab == 3 : VerticalLayout {
        padding: MaterialStyleMetrics.padding_14;
        spacing: MaterialStyleMetrics.spacing_12;

        Rectangle {
            background: MaterialPalette.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: MaterialPalette.outline_variant;
            vertical-stretch: 1;

            VerticalLayout {
                alignment: center;
                spacing: 10px;

                MaterialText {
                    text: "USB Optical Drive Subsystem (cdda://)";
                    color: MaterialPalette.secondary;
                    style: MaterialTypography.title_medium;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // Tab 4: DSP & Tone Control
    if root.active_tab == 4 : VerticalLayout {
        padding: MaterialStyleMetrics.padding_14;
        spacing: MaterialStyleMetrics.spacing_12;

        Rectangle {
            background: MaterialPalette.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: MaterialPalette.outline_variant;
            vertical-stretch: 1;

            VerticalLayout {
                alignment: center;
                spacing: 10px;

                MaterialText {
                    text: "48kHz / 32-bit LE Processing Pipeline";
                    color: MaterialPalette.secondary;
                    style: MaterialTypography.title_medium;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // Tab 5: Settings & Theme Switcher
    if root.active_tab == 5 : VerticalLayout {
        padding: 0px;

        SettingsView {
            cd_enabled: root.cd_enabled;
            show_themes <=> root.show_themes;
            show_visualizer <=> root.show_visualizer;
            show_advanced <=> root.show_advanced;
            show_widget_preview <=> root.show_widget_preview;
            speaker_alias <=> root.speaker_alias;
            basic_settings: root.basic_settings;
            visualizer_settings: root.visualizer_settings;
            advanced_settings: root.advanced_settings;
            bluetooth_clicked => { root.open_bluetooth_devices(); }
            vu_meter_clicked => { root.visualizer_clicked(); }
            dsp_clicked => { root.select_tab(4); }
            cd_clicked => { root.select_tab(3); }
            select_theme(idx) => { root.select_theme(idx); }
            cycle_theme => { root.cycle_theme(); }
            font_scale_changed(val) => { root.font_scale_changed(val); }
            setting_step(id, dir) => { root.setting_step(id, dir); }
            setting_toggle(id, right) => { root.setting_toggle(id, right); }
        }
    }
}
