import { MaterialPalette } from "@material/material.slint";
import { AppTheme } from "app_theme.slint";
import { NowPlayingView } from "now_playing.slint";
import { SettingsView } from "settings_view.slint";

// One label / value line in the Bluetooth details cards.
component DetailRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 24px;

    HorizontalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: MaterialPalette.secondary;
            font-size: 12px;
            font-weight: 800;
            vertical-alignment: center;
            width: 76px;
        }

        Text {
            text: root.value;
            color: MaterialPalette.on_surface;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

export component MainViewport inherits Rectangle {
    background: MaterialPalette.background;

    in-out property <int> active_tab: 0;
    in property <bool> cd_enabled: false;
    in-out property <bool> show_themes: false;
    in-out property <string> track_title: "Waiting for Bluetooth Connection...";
    in-out property <string> track_artist: "";
    in-out property <string> track_album: "";
    in-out property <string> stream_details: "aptX-HD 576k | 48kHz/16-bit -> DSP 32-bit";
    in-out property <string> position_text: "00:00";
    in-out property <string> duration_text: "00:00";
    in-out property <int> duration_ms: 0;
    in-out property <float> progress_ratio: 0.0;
    in-out property <float> volume_value: 75.0;
    in-out property <bool> is_playing: false;
    in-out property <bool> is_muted: false;
    in property <float> volume_hud_opacity: 0.0;
    in-out property <bool> has_cover_art: false;
    in-out property <image> cover_image;
    in-out property <image> title_marquee_strip;
    in property <string> artist_marquee_text;
    in-out property <float> left_peak_ratio: 0.0;
    in-out property <float> right_peak_ratio: 0.0;
    in-out property <string> track_or_device: "Waiting for Connection...";
    in property <string> stream_codec: "aptX-HD";
    in property <bool> bt_connected: false;
    in property <string> bt_device_address: "—";
    in property <string> bt_link_text: "Waiting for connection";
    in property <string> bt_rssi_text: "";
    in property <string> bt_battery_text: "";
    in property <string> bt_stream_format: "—";
    in property <string> bt_delay_text: "—";
    in property <string> bt_adapter_name: "—";
    in property <string> bt_adapter_address: "—";

    callback settings_clicked();
    callback select_tab(int);
    callback toggle_play_pause();
    callback next_track();
    callback previous_track();
    callback toggle_mute();
    callback volume_changed(float);
    callback stream_pill_clicked();
    callback cycle_theme();
    callback select_theme(int);

    // Tab 0: Now Playing
    if root.active_tab == 0 : VerticalLayout {
        padding: 0px;

        Rectangle {
            background: @linear-gradient(150deg, MaterialPalette.surface 0%, MaterialPalette.background 100%);
            border-radius: 0px;
            border-width: 1px;
            border-color: MaterialPalette.outline_variant;
            clip: true;

            now_playing := NowPlayingView {
                track_title: root.track_title;
                track_artist: root.track_artist;
                track_album: root.track_album;
                position_text: root.position_text;
                duration_text: root.duration_text;
                duration_ms: root.duration_ms;
                progress_ratio: root.progress_ratio;
                is_playing: root.is_playing;
                has_cover_art: root.has_cover_art;
                cover_image: root.cover_image;
                title_marquee_strip: root.title_marquee_strip;
                artist_marquee_text: root.artist_marquee_text;

                toggle_play_pause => { root.toggle_play_pause(); }
                next_track => { root.next_track(); }
                previous_track => { root.previous_track(); }
                settings_clicked => { root.settings_clicked(); }
            }
        }
    }

    // Tab 1: VU Meter (Authentic PeppyMeter Skin Picture)
    if root.active_tab == 1 : VerticalLayout {
        padding: 8px;

        Rectangle {
            background: MaterialPalette.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: MaterialPalette.outline_variant;
            clip: true;

            // Full-screen background image
            Image {
                width: 100%;
                height: 100%;
                source: AppTheme.active_preset == 0 ? @image-url("../../../assets/skins/800x480/blue-bgr.png") :
                        AppTheme.active_preset == 1 ? @image-url("../../../assets/skins/800x480/gold-bgr.png") :
                        AppTheme.active_preset == 2 ? @image-url("../../../assets/skins/800x480/rainbow-bgr.png") :
                        AppTheme.active_preset == 3 ? @image-url("../../../assets/skins/800x480/black-white-bgr.png") :
                        @image-url("../../../assets/skins/800x480/vintage-bgr.png");
                image-fit: contain;
            }
        }
    }

    // Tab 2: Bluetooth connection details (opened from the status bar or the dock)
    if root.active_tab == 2 : VerticalLayout {
        padding: 14px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 14px;

            // Left card: connected source (org.bluez.Device1)
            Rectangle {
                horizontal-stretch: 1;
                background: MaterialPalette.surface;
                border-radius: 14px;
                border-width: 1px;
                border-color: MaterialPalette.outline_variant;

                VerticalLayout {
                    padding: 16px;
                    spacing: 6px;

                    Text {
                        text: "CONNECTED SOURCE";
                        color: MaterialPalette.primary;
                        font-size: 13px;
                        font-weight: 800;
                    }
                    DetailRow { label: "DEVICE"; value: root.track_or_device; }
                    DetailRow { label: "ADDRESS"; value: root.bt_device_address; }
                    DetailRow { label: "LINK"; value: root.bt_link_text; }
                    DetailRow { label: "PROFILE"; value: "A2DP Sink • AVRCP"; }
                    if root.bt_rssi_text != "" : DetailRow { label: "SIGNAL"; value: root.bt_rssi_text; }
                    if root.bt_battery_text != "" : DetailRow { label: "BATTERY"; value: root.bt_battery_text; }
                }
            }

            // Right card: audio stream (BlueALSA PCM) and local controller (org.bluez.Adapter1)
            Rectangle {
                horizontal-stretch: 1;
                background: MaterialPalette.surface;
                border-radius: 14px;
                border-width: 1px;
                border-color: MaterialPalette.outline_variant;

                VerticalLayout {
                    padding: 16px;
                    spacing: 6px;

                    Text {
                        text: "AUDIO STREAM";
                        color: MaterialPalette.primary;
                        font-size: 13px;
                        font-weight: 800;
                    }
                    DetailRow {
                        label: "STATE";
                        value: root.is_playing ? "STREAMING" : (root.bt_connected ? "CONNECTED" : "WAITING");
                    }
                    DetailRow { label: "CODEC"; value: root.stream_codec; }
                    DetailRow { label: "FORMAT"; value: root.bt_stream_format; }
                    DetailRow { label: "LATENCY"; value: root.bt_delay_text; }
                    DetailRow { label: "VOLUME"; value: root.is_muted ? "Muted" : (Math.round(root.volume_value) + "%"); }
                    DetailRow { label: "SPEAKER"; value: root.bt_adapter_name; }
                    DetailRow { label: "ADAPTER"; value: root.bt_adapter_address; }
                }
            }
        }
    }

    // Tab 3: CD Player
    if root.active_tab == 3 : VerticalLayout {
        padding: 14px;
        spacing: 12px;

        Rectangle {
            background: MaterialPalette.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: MaterialPalette.outline_variant;
            vertical-stretch: 1;

            VerticalLayout {
                alignment: center;
                spacing: 10px;

                Text {
                    text: "USB Optical Drive Subsystem (cdda://)";
                    color: MaterialPalette.secondary;
                    font-size: 16px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // Tab 4: DSP & Tone Control
    if root.active_tab == 4 : VerticalLayout {
        padding: 14px;
        spacing: 12px;

        Rectangle {
            background: MaterialPalette.surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: MaterialPalette.outline_variant;
            vertical-stretch: 1;

            VerticalLayout {
                alignment: center;
                spacing: 10px;

                Text {
                    text: "48kHz / 32-bit LE Processing Pipeline";
                    color: MaterialPalette.secondary;
                    font-size: 16px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // Tab 5: Settings & Theme Switcher
    if root.active_tab == 5 : VerticalLayout {
        padding: 0px;

        SettingsView {
            cd_enabled: root.cd_enabled;
            show_themes <=> root.show_themes;
            bluetooth_clicked => { root.select_tab(2); }
            vu_meter_clicked => { root.select_tab(1); }
            dsp_clicked => { root.select_tab(4); }
            cd_clicked => { root.select_tab(3); }
            select_theme(idx) => { root.select_theme(idx); }
            cycle_theme => { root.cycle_theme(); }
        }
    }
}
