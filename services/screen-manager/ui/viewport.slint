import { Theme } from "theme.slint";
import { NowPlayingView } from "now_playing.slint";
import { VolumeHudOverlay } from "volume_hud.slint";

// One label / value line in the Bluetooth details cards.
component DetailRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 24px;

    HorizontalLayout {
        spacing: 8px;

        Text {
            text: root.label;
            color: Theme.active.secondary_accent;
            font-size: 12px;
            font-weight: 800;
            vertical-alignment: center;
            width: 76px;
        }

        Text {
            text: root.value;
            color: Theme.active.text_primary;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

export component MainViewport inherits Rectangle {
    background: Theme.active.chassis;

    in-out property <int> active_tab: 0;
    in-out property <string> track_title: "Waiting for Bluetooth Connection...";
    in-out property <string> track_artist: "";
    in-out property <string> track_album: "";
    in-out property <string> stream_details: "aptX-HD 576k | 48kHz/16-bit -> DSP 32-bit";
    in-out property <string> position_text: "00:00";
    in-out property <string> duration_text: "00:00";
    in-out property <int> duration_ms: 0;
    in-out property <float> progress_ratio: 0.0;
    in-out property <float> volume_value: 75.0;
    in-out property <bool> is_playing: false;
    in-out property <bool> is_muted: false;
    in property <float> volume_hud_opacity: 0.0;
    in-out property <bool> has_cover_art: false;
    in-out property <image> cover_image;
    in-out property <image> title_marquee_strip;
    in property <string> artist_marquee_text;
    in-out property <float> left_peak_ratio: 0.0;
    in-out property <float> right_peak_ratio: 0.0;
    in-out property <string> track_or_device: "Waiting for Connection...";
    in property <string> stream_codec: "aptX-HD";
    in property <string> bt_device_address: "—";
    in property <string> bt_link_text: "Waiting for connection";
    in property <string> bt_rssi_text: "";
    in property <string> bt_battery_text: "";
    in property <string> bt_stream_format: "—";
    in property <string> bt_delay_text: "—";
    in property <string> bt_adapter_name: "—";
    in property <string> bt_adapter_address: "—";

    callback bluetooth_back_clicked();
    callback toggle_play_pause();
    callback next_track();
    callback previous_track();
    callback toggle_mute();
    callback volume_changed(float);
    callback dismiss_volume_hud();
    callback volume_hud_activity();
    callback stream_pill_clicked();
    callback cycle_theme();
    callback select_theme(int);

    // Tab 0: Now Playing
    if root.active_tab == 0 : VerticalLayout {
        padding: 0px;

        Rectangle {
            background: @linear-gradient(150deg, Theme.active.card_surface 0%, Theme.active.chassis 100%);
            border-radius: 0px;
            border-width: 1px;
            border-color: Theme.active.card_border;
            clip: true;

            now_playing := NowPlayingView {
                track_title: root.track_title;
                track_artist: root.track_artist;
                track_album: root.track_album;
                position_text: root.position_text;
                duration_text: root.duration_text;
                duration_ms: root.duration_ms;
                progress_ratio: root.progress_ratio;
                is_playing: root.is_playing;
                has_cover_art: root.has_cover_art;
                cover_image: root.cover_image;
                title_marquee_strip: root.title_marquee_strip;
                artist_marquee_text: root.artist_marquee_text;

                toggle_play_pause => { root.toggle_play_pause(); }
                next_track => { root.next_track(); }
                previous_track => { root.previous_track(); }
            }
        }
    }

    // Tab 1: VU Meter (Authentic PeppyMeter Skin Picture)
    if root.active_tab == 1 : VerticalLayout {
        padding: 8px;

        Rectangle {
            background: Theme.active.card_surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.active.card_border;
            clip: true;

            Image {
                width: 100%;
                height: 100%;
                source: Theme.active_preset == 0 ? @image-url("../../../assets/skins/800x480/blue-bgr.png") :
                        Theme.active_preset == 1 ? @image-url("../../../assets/skins/800x480/gold-bgr.png") :
                        Theme.active_preset == 2 ? @image-url("../../../assets/skins/800x480/rainbow-bgr.png") :
                        Theme.active_preset == 3 ? @image-url("../../../assets/skins/800x480/black-white-bgr.png") :
                        @image-url("../../../assets/skins/800x480/vintage-bgr.png");
                image-fit: contain;
            }
        }
    }

    // Tab 2: Bluetooth connection details (opened from the status bar or the dock)
    if root.active_tab == 2 : VerticalLayout {
        padding: 14px;
        spacing: 12px;

        // Header: title, live link state pill, back button
        HorizontalLayout {
            height: 40px;
            spacing: 12px;

            Text {
                text: "BLUETOOTH CONNECTION";
                color: Theme.active.primary_accent;
                font-size: 18px;
                font-weight: 800;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Rectangle {
                width: 150px;
                background: Theme.active.card_surface;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.active.card_border;

                Text {
                    text: root.is_playing ? "STREAMING" : (root.bt_device_address == "—" ? "WAITING" : "CONNECTED");
                    color: root.is_playing ? Theme.active.primary_accent : Theme.active.secondary_accent;
                    font-size: 14px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                width: 110px;
                background: Theme.active.primary_accent;
                border-radius: 10px;

                Text {
                    text: "Back";
                    color: Theme.active.dock_active_text;
                    font-size: 15px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => { root.bluetooth_back_clicked(); }
                }
            }
        }

        HorizontalLayout {
            spacing: 14px;

            // Left card: connected source (org.bluez.Device1)
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.active.card_surface;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.active.card_border;

                VerticalLayout {
                    padding: 16px;
                    spacing: 6px;

                    Text {
                        text: "CONNECTED SOURCE";
                        color: Theme.active.primary_accent;
                        font-size: 13px;
                        font-weight: 800;
                    }
                    DetailRow { label: "DEVICE"; value: root.track_or_device; }
                    DetailRow { label: "ADDRESS"; value: root.bt_device_address; }
                    DetailRow { label: "LINK"; value: root.bt_link_text; }
                    DetailRow { label: "PROFILE"; value: "A2DP Sink • AVRCP"; }
                    if root.bt_rssi_text != "" : DetailRow { label: "SIGNAL"; value: root.bt_rssi_text; }
                    if root.bt_battery_text != "" : DetailRow { label: "BATTERY"; value: root.bt_battery_text; }
                }
            }

            // Right card: audio stream (BlueALSA PCM) and local controller (org.bluez.Adapter1)
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.active.card_surface;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.active.card_border;

                VerticalLayout {
                    padding: 16px;
                    spacing: 6px;

                    Text {
                        text: "AUDIO STREAM";
                        color: Theme.active.primary_accent;
                        font-size: 13px;
                        font-weight: 800;
                    }
                    DetailRow { label: "CODEC"; value: root.stream_codec; }
                    DetailRow { label: "FORMAT"; value: root.bt_stream_format; }
                    DetailRow { label: "LATENCY"; value: root.bt_delay_text; }
                    DetailRow { label: "VOLUME"; value: root.is_muted ? "Muted" : (Math.round(root.volume_value) + "%"); }
                    DetailRow { label: "SPEAKER"; value: root.bt_adapter_name; }
                    DetailRow { label: "ADAPTER"; value: root.bt_adapter_address; }
                }
            }
        }
    }

    // Tab 3: CD Player
    if root.active_tab == 3 : VerticalLayout {
        padding: 20px;

        Rectangle {
            background: Theme.active.card_surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.active.card_border;

            VerticalLayout {
                alignment: center;
                spacing: 10px;

                Text {
                    text: "OPTICAL CD PLAYER";
                    color: Theme.active.primary_accent;
                    font-size: 20px;
                    font-weight: 800;
                    horizontal-alignment: center;
                }

                Text {
                    text: "USB Optical Drive Subsystem (cdda://)";
                    color: Theme.active.secondary_accent;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // Tab 4: DSP & Tone Control
    if root.active_tab == 4 : VerticalLayout {
        padding: 20px;

        Rectangle {
            background: Theme.active.card_surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.active.card_border;

            VerticalLayout {
                alignment: center;
                spacing: 10px;

                Text {
                    text: "CAMILLADSP ACTIVE CROSSOVER";
                    color: Theme.active.primary_accent;
                    font-size: 20px;
                    font-weight: 800;
                    horizontal-alignment: center;
                }

                Text {
                    text: "48kHz / 32-bit LE Processing Pipeline";
                    color: Theme.active.secondary_accent;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // Tab 5: Settings & Theme Switcher
    if root.active_tab == 5 : VerticalLayout {
        padding: 16px;

        Rectangle {
            background: Theme.active.card_surface;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.active.card_border;

            VerticalLayout {
                alignment: center;
                spacing: 14px;
                padding: 16px;

                Text {
                    text: "APPLIANCE THEME & PREFERENCES";
                    color: Theme.active.primary_accent;
                    font-size: 18px;
                    font-weight: 800;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Unified Global Theme Palette (Section 3.1):";
                    color: Theme.active.text_muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                }

                // 5 Theme preset buttons
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    // 1. McIntosh Blue
                    Rectangle {
                        width: 136px;
                        height: 52px;
                        background: #090D12;
                        border-radius: 10px;
                        border-width: Theme.active_preset == 0 ? 2px : 1px;
                        border-color: #00C8FF;

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "1. McIntosh";
                                color: #00C8FF;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Electric Cyan";
                                color: #70E1FF;
                                font-size: 10px;
                                horizontal-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => {
                                root.select_theme(0);
                            }
                        }
                    }

                    // 2. Marantz Amber
                    Rectangle {
                        width: 136px;
                        height: 52px;
                        background: #12100D;
                        border-radius: 10px;
                        border-width: Theme.active_preset == 1 ? 2px : 1px;
                        border-color: #E5A93C;

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "2. Marantz";
                                color: #E5A93C;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Warm Amber";
                                color: #FFD166;
                                font-size: 10px;
                                horizontal-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => {
                                root.select_theme(1);
                            }
                        }
                    }

                    // 3. Cyberpunk Neon
                    Rectangle {
                        width: 136px;
                        height: 52px;
                        background: #0D0B18;
                        border-radius: 10px;
                        border-width: Theme.active_preset == 2 ? 2px : 1px;
                        border-color: #00F0FF;

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "3. Cyberpunk";
                                color: #00F0FF;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Synthwave Pink";
                                color: #FF007F;
                                font-size: 10px;
                                horizontal-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => {
                                root.select_theme(2);
                            }
                        }
                    }

                    // 4. Studio Dark
                    Rectangle {
                        width: 136px;
                        height: 52px;
                        background: #121212;
                        border-radius: 10px;
                        border-width: Theme.active_preset == 3 ? 2px : 1px;
                        border-color: #F0F0F0;

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "4. Studio Dark";
                                color: #F0F0F0;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Precision Mono";
                                color: #A0A0A0;
                                font-size: 10px;
                                horizontal-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => {
                                root.select_theme(3);
                            }
                        }
                    }

                    // 5. PeppyMeter Gold
                    Rectangle {
                        width: 136px;
                        height: 52px;
                        background: #14110D;
                        border-radius: 10px;
                        border-width: Theme.active_preset == 4 ? 2px : 1px;
                        border-color: #F5B83D;

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "5. PeppyMeter";
                                color: #F5B83D;
                                font-size: 12px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Vintage Gold";
                                color: #FFDF85;
                                font-size: 10px;
                                horizontal-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => {
                                root.select_theme(4);
                            }
                        }
                    }
                }

                // Cycle Theme Button
                Rectangle {
                    width: 220px;
                    height: 40px;
                    background: Theme.active.primary_accent;
                    border-radius: 10px;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;

                        Text {
                            text: "Cycle Next Theme";
                            color: Theme.active.dock_active_text;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.cycle_theme();
                        }
                    }
                }
            }
        }
    }

    // Universal Full-Viewport Volume HUD Overlay (§3.2).
    // Permanently mounted in the item tree with `visible` gated on opacity so fade-out
    // transitions never destroy/recreate the item tree (`M-NO-PER-FRAME-ITEM-TREE-CHURN`).
    volume_hud := VolumeHudOverlay {
        visible: root.volume_hud_opacity > 0.01;
        opacity: root.volume_hud_opacity;
        volume_value <=> root.volume_value;
        is_muted <=> root.is_muted;
        volume_changed(val) => { root.volume_changed(val); }
        toggle_mute => { root.toggle_mute(); }
        dismiss_requested => { root.dismiss_volume_hud(); }
        interaction_activity => { root.volume_hud_activity(); }
    }
}
