import { MaterialPalette } from "@material/material.slint";

/// Per-band normalized level & peak-hold cap for the 24-band ERB spectrum.
export struct SpectrumBandItem {
    value: float,
    peak: float,
}

/// Full-screen `800×480` music visualizer overlay.
///
/// Supports:
/// - Mode 0: PeppyMeter VU (all 25 circular & linear skins)
/// - Mode 1: 24-Band Glasberg–Moore ERB Spectrum with 3 px peak-hold caps
/// - Tap anywhere to return to Now Playing; swipe left/right to switch modes.
export component VisualizerOverlay inherits Rectangle {
    width: 800px;
    height: 480px;
    clip: true;
    background: #090B10;

    // 0 = VU Meter, 1 = 24-Band ERB Spectrum
    in property <int> visualizer_mode: 0;

    // VU skin textures & geometry
    in property <bool> is_circular: true;
    in property <bool> is_stereo: true;
    in property <bool> has_fgr: false;
    in property <image> vu_bgr;
    in property <image> vu_fgr;
    in property <image> vu_indicator;
    in property <image> vu_indicator_flipped;

    // Circular needle placement & angles (precomputed in Rust)
    in property <length> left_needle_x: 0px;
    in property <length> left_needle_y: 0px;
    in property <length> left_pivot_x: 0px;
    in property <length> left_pivot_y: 0px;
    in property <float> left_angle_deg: -45.0;

    in property <length> right_needle_x: 0px;
    in property <length> right_needle_y: 0px;
    in property <length> right_pivot_x: 0px;
    in property <length> right_pivot_y: 0px;
    in property <float> right_angle_deg: -45.0;

    // Linear bar/cursor geometry (precomputed per-frame in Rust for all 8 linear skins)
    in property <length> linear_ind_w: 0px;
    in property <length> linear_ind_h: 0px;
    in property <length> linear_left_x: 0px;
    in property <length> linear_left_y: 0px;
    in property <length> linear_left_w: 0px;
    in property <length> linear_left_h: 0px;
    in property <length> linear_left_img_x: 0px;
    in property <length> linear_left_img_y: 0px;
    in property <bool> linear_left_flipped: false;

    in property <length> linear_right_x: 0px;
    in property <length> linear_right_y: 0px;
    in property <length> linear_right_w: 0px;
    in property <length> linear_right_h: 0px;
    in property <length> linear_right_img_x: 0px;
    in property <length> linear_right_img_y: 0px;
    in property <bool> linear_right_flipped: false;

    // 24-band ERB spectrum state
    in property <[SpectrumBandItem]> spectrum_bands;
    in property <bool> spectrum_led_mask: true;

    callback close_requested();
    callback next_visualizer();
    callback prev_visualizer();

    // Mode 0: PeppyMeter VU (Circular or Linear)
    if root.visualizer_mode == 0 : Rectangle {
        width: 100%;
        height: 100%;
        clip: true;

        Image {
            width: 800px;
            height: 480px;
            source: root.vu_bgr;
            image-fit: fill;
            cache-rendering-hint: true;
        }

        // Circular rotating needles
        if root.is_circular : Image {
            source: root.vu_indicator;
            x: root.left_needle_x;
            y: root.left_needle_y;
            transform-rotation: root.left_angle_deg * 1deg;
            transform-origin: { x: root.left_pivot_x, y: root.left_pivot_y };
        }

        if root.is_circular && root.is_stereo : Image {
            source: root.vu_indicator;
            x: root.right_needle_x;
            y: root.right_needle_y;
            transform-rotation: root.right_angle_deg * 1deg;
            transform-origin: { x: root.right_pivot_x, y: root.right_pivot_y };
        }

        // Linear clipped bars & sliding cursor (all 8 linear skins)
        if !root.is_circular : Rectangle {
            width: 100%;
            height: 100%;
            background: transparent;

            Rectangle {
                x: root.linear_left_x;
                y: root.linear_left_y;
                width: root.linear_left_w;
                height: root.linear_left_h;
                clip: true;

                Image {
                    x: root.linear_left_img_x;
                    y: root.linear_left_img_y;
                    width: root.linear_ind_w;
                    height: root.linear_ind_h;
                    source: root.linear_left_flipped ? root.vu_indicator_flipped : root.vu_indicator;
                    image-fit: fill;
                }
            }

            if root.is_stereo : Rectangle {
                x: root.linear_right_x;
                y: root.linear_right_y;
                width: root.linear_right_w;
                height: root.linear_right_h;
                clip: true;

                Image {
                    x: root.linear_right_img_x;
                    y: root.linear_right_img_y;
                    width: root.linear_ind_w;
                    height: root.linear_ind_h;
                    source: root.linear_right_flipped ? root.vu_indicator_flipped : root.vu_indicator;
                    image-fit: fill;
                }
            }
        }

        // Optional foreground glass/bezel overlay
        if root.has_fgr : Image {
            width: 800px;
            height: 480px;
            source: root.vu_fgr;
            image-fit: fill;
            cache-rendering-hint: true;
        }
    }

    // Mode 1: 24-Band ERB Frequency Spectrum
    if root.visualizer_mode == 1 : Rectangle {
        width: 100%;
        height: 100%;
        background: #090B10;
        clip: true;

        // Subtle horizontal reference grid lines (static, cached)
        Rectangle {
            width: 100%;
            height: 100%;
            background: transparent;
            cache-rendering-hint: true;

            for frac in [0.25, 0.5, 0.75] : Rectangle {
                x: 24px;
                y: 28px + (parent.height - 56px) * frac;
                width: parent.width - 48px;
                height: 1px;
                background: #1C2333;
            }
        }

        // 24 sharp ERB bars + 3 px peak-hold caps (no border-radius, no shadows)
        Rectangle {
            x: 24px;
            y: 28px;
            width: 752px;
            height: 424px;
            background: transparent;

            for band[idx] in root.spectrum_bands : Rectangle {
                property <length> slot_w: parent.width / 24;
                property <length> bar_w: self.slot_w - 6px;
                property <length> bar_h: Math.max(2px, parent.height * Math.clamp(band.value, 0.0, 1.0));
                property <length> peak_y: parent.height - Math.max(3px, parent.height * Math.clamp(band.peak, 0.0, 1.0));

                x: idx * self.slot_w + 3px;
                y: 0px;
                width: self.bar_w;
                height: parent.height;
                background: transparent;

                // Spectrum bar with vertical gradient
                Rectangle {
                    x: 0px;
                    y: parent.height - bar_h;
                    width: parent.width;
                    height: bar_h;
                    border-radius: 0px;
                    background: @linear-gradient(
                        180deg,
                        #FF5252 0%,
                        #FFB300 28%,
                        #26E6A4 68%,
                        #00B8D4 100%
                    );
                }

                // 3 px peak-hold cap
                Rectangle {
                    x: 0px;
                    y: Math.clamp(peak_y, 0px, parent.height - 3px);
                    width: parent.width;
                    height: 3px;
                    border-radius: 0px;
                    background: MaterialPalette.primary;
                }
            }
        }

        // Static horizontal-slit LED mask PNG overlay
        if root.spectrum_led_mask : Image {
            x: 0px;
            y: 0px;
            width: 800px;
            height: 480px;
            source: @image-url("../../../assets/skins/spectrum-led-mask.png");
            image-fit: fill;
            cache-rendering-hint: true;
        }
    }

    // Gesture layer: swipe left/right cycles visualizers; tap returns to Now Playing.
    swipe := SwipeGestureHandler {
        width: 100%;
        height: 100%;
        handle-swipe-left: true;
        handle-swipe-right: true;

        swiped => {
            if (self.current-position.x - self.pressed-position.x < -40px) {
                root.next_visualizer();
            } else if (self.current-position.x - self.pressed-position.x > 40px) {
                root.prev_visualizer();
            }
        }

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.close_requested();
            }
        }
    }
}
