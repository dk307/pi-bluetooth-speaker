// Shared state bridge between the Slint marquee animation and Rust.
//
// `now_playing` is instantiated inside a conditional element, so its internal
// properties are not addressable from the window root; a global is the sanctioned
// way to publish per-tick animation state (clock, frame rate) to Rust.
export global MarqueeCompose {
    // Marquee scroll rate in ticks per second (30 or 60); set from the CLI.
    in-out property <int> marquee_fps: 60;
    // Shared marquee clock advanced by the single 16.65 ms timer in NowPlayingView.
    in-out property <int> clock: 0;
    // Pre-rendered premultiplied RGBA strip for overflowing track titles.
    in-out property <image> title_strip;
}

// Pre-rendered 64x24 frames for AmbientWaveIndicator (6 playing + 1 idle),
// plus a combined 448x24 horizontal sprite sheet (`7 * 64x24`) so the active
// frame can be selected via `source-clip-x` on a single cached GPU texture.
export global AmbientWaveSprites {
    in-out property <[image]> frames;
    in-out property <image> sprite_sheet;
}
