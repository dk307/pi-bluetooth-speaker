import { FilledCard, FilledButton, MaterialText, Horizontal, Vertical, MaterialStyleMetrics } from "@material/material.slint";
import { MaterialPalette } from "@material/material.slint";
import { MaterialTypography } from "@material/material.slint";

export component DSPView inherits VerticalLayout {
    callback dsp_back_clicked();

    padding: 14px;
    spacing: 12px;

    HorizontalLayout {
        height: 40px;
        spacing: 12px;

        MaterialText {
            text: "CAMILLADSP ACTIVE CROSSOVER";
            style: MaterialTypography.title_medium;  // 16px, medium
            color: MaterialPalette.primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        FilledButton {
            text: "Back";
            width: 120px;
            height: 42px;
            clicked => { root.dsp_back_clicked(); }
        }
    }

    FilledCard {
        // FilledCard has background = MaterialPalette.surface_container_highest
        vertical-stretch: 1;

        VerticalLayout {
            alignment: center;
            spacing: MaterialStyleMetrics.spacing_16;

            MaterialText {
                text: "48kHz / 32-bit LE Processing Pipeline";
                style: MaterialTypography.body_large;  // 16px, regular
                color: MaterialPalette.on_surface_variant;
                horizontal-alignment: center;
            }
        }
    }
}