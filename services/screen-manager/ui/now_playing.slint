import {
    FilledIconButton,
    MaterialPalette,
    MaterialStyleMetrics,
    OutlineIconButton,
    TonalIconButton,
    TouchScale,
} from "@material/material.slint";
import { AmbientWaveSprites, MarqueeCompose } from "marquee_state.slint";
import "./fonts/InterTabular-Bold.ttf";

// Scrolling marquee over pre-rendered strip or live text.
//
// The KMS migration removed the offscreen secondary-component strip rasterizer:
// under `backend-linuxkms` any secondary Slint component creates a real DRM/GL
// window whose teardown crashed Mesa (SEGV in `driUnbindContext`). Instead,
// `ui/marquee.rs` rasterizes overflowing titles in-process via `swash` into a
// premultiplied `SharedPixelBuffer` uploaded once to Skia's GPU texture cache.
component MarqueeText inherits Rectangle {
    in property <string> text;
    in property <image> strip_image;
    // Shared marquee clock (ticks of the parent's single 16.65 ms timer) and the
    // configured marquee frame rate in ticks per second (60 = 1 px per tick, 30 =
    // 2 px every other tick). One shared timer guarantees title and artist scroll
    // in lockstep; independent per-instance timers drift apart and double the
    // number of dirty events fed to the render loop.
    in property <int> clock_frame: 0;
    in property <int> marquee_fps: 60;
    // Minimum height floor to keep geometry deterministic while `text` is empty.
    in property <length> height_floor: 32px * TouchScale.clamped_font_scale;
    // Marquee typography: matches the former strip rasterizer (32 px / extra
    // bold) scaled by `TouchScale.clamped_font_scale`; font family inherited (Inter).
    property <length> font_size: 32px * TouchScale.clamped_font_scale;
    property <int> font_weight: 800;
    property <color> font_color: MaterialPalette.on_background;
    clip: true;
    border-radius: 0px;
    height: Math.max(main_text.preferred-height, root.height_floor);
    horizontal-stretch: 1;
    preferred-width: 0px;

    property <bool> use_strip: root.is_overflow && root.strip_image.width > 0;

    // Wrap the live fallback `Text` items in a `cache-rendering-hint: true`
    // container so when `use_strip == true` (both texts have `visible: false`),
    // Slint's `render_layer` computes a `0x0` bounding box, allocates zero FBO
    // memory (`layer_cache` stores `None`), and prunes both hidden `ComplexText`
    // subtrees in one lookup per 60 Hz frame.
    Rectangle {
        width: 100%;
        height: 100%;
        cache-rendering-hint: true;

        main_text := Text {
            x: root.use_strip ? 0px : root.scroll_offset;
            text: root.text;
            color: root.font_color;
            font-size: root.font_size;
            font-weight: root.font_weight;
            wrap: no-wrap;
            vertical-alignment: center;
            visible: !root.use_strip;
        }

        // Fallback wrap-around Text when no SharedPixelBuffer strip is published.
        Text {
            x: Math.round((root.scroll_offset + root.cycle_distance) / 1px) * 1px;
            text: root.text;
            color: root.font_color;
            font-size: root.font_size;
            font-weight: root.font_weight;
            wrap: no-wrap;
            vertical-alignment: center;
            visible: !root.use_strip && root.wrap_visible;
        }
    }

    property <length> text_width: main_text.width;
    out property <bool> is_overflow: text_width > root.width;
    property <length> active_width: root.use_strip ? (root.strip_image.width * 1px) : root.text_width;
    property <length> gap: 80px;
    property <length> cycle_distance: root.active_width + root.gap;

    // Continuous seamless marquee: constant-speed leftward scroll with no stationary
    // pause. The offset derives from the shared integer frame clock: each clock tick
    // advances the scroll by `step_frames` physical px, so 60 fps = 1 px per 16.65 ms and
    // 30 fps = 2 px per 33.3 ms at identical on-screen speed. Reading `animation-tick()`
    // was deliberately avoided: it permanently marks Slint's animation driver active,
    // pinning the render loop at 60 fps (and ~60% CPU) even while the marquee is paused
    // or the text does not overflow.
    property <int> step_frames: Math.max(1, Math.round(60 / root.marquee_fps));
    property <length> step: root.step_frames * 1px;
    property <int> cycle_frames: Math.max(1, Math.round(cycle_distance / root.step));
    property <int> scroll_frame: Math.mod(root.clock_frame, root.cycle_frames);
    property <float> progress: scroll_frame * 1.0 / cycle_frames;
    // Snap scroll coordinates to integer physical pixels (X.0px) so draw_glyph_run
    // avoids half-pixel nearest-neighbor tearing and atlas shifts (femtovg#426).
    property <length> scroll_offset: is_overflow ? (Math.round((-cycle_distance * progress) / 1px) * 1px) : 0px;

    // Whether the wrap-around copy must be composited. Expressed in INTEGER frame
    // arithmetic on purpose: the previous float comparison
    // `scroll_offset + cycle_distance < width` flapped when f32 rounding made
    // `scroll_offset` non-monotonic at the crossing, destroying and recreating the
    // conditional item tree every frame — and each item-tree destruction forces a
    // full-window redraw (~30 ms) in Slint's partial renderer
    // (`free_graphics_resources` -> `force_screen_refresh`), causing a ~70% CPU storm.
    property <bool> wrap_visible: root.is_overflow
        && root.scroll_frame > root.cycle_frames - Math.round(root.width / root.step);

    // Pre-rendered SharedPixelBuffer strip copies (primary + wrap-around) so
    // 60 Hz scrolling translates GPU quads without per-frame text shaping.
    // Snap `y` to whole physical pixels and use `image-rendering: pixelated`
    // (`FilterMode::Nearest`) so VideoCore IV's TMU performs a 1-tap texel
    // fetch instead of 4-tap bilinear filtering on the 1:1 rasterized strip.
    property <length> strip_y: Math.round(((root.height - root.strip_image.height * 1px) / 2) / 1px) * 1px;

    Image {
        x: root.scroll_offset;
        y: root.strip_y;
        width: root.strip_image.width * 1px;
        height: root.strip_image.height * 1px;
        source: root.strip_image;
        image-fit: fill;
        image-rendering: pixelated;
        visible: root.use_strip;
    }

    Image {
        x: Math.round((root.scroll_offset + root.cycle_distance) / 1px) * 1px;
        y: root.strip_y;
        width: root.strip_image.width * 1px;
        height: root.strip_image.height * 1px;
        source: root.strip_image;
        image-fit: fill;
        image-rendering: pixelated;
        visible: root.use_strip && root.wrap_visible;
    }
}

component AmbientWaveIndicator inherits Rectangle {
    in property <bool> is_playing: true;
    width: 64px;
    height: 24px;
    background: transparent;

    property <int> tick: 0;
    property <int> active_frame: root.is_playing ? root.tick : 6;

    Timer {
        interval: 180ms;
        running: root.is_playing;
        triggered() => {
            root.tick = Math.mod(root.tick + 1, 6);
        }
    }

    // Render from a single 448x24 (`7 * 64x24`) horizontal sprite-sheet texture
    // using `source-clip-x`. In `SkiaItemRenderer::draw_image_impl`, `source`
    // stays constant across 180 ms ticks (zero `image_cache` invalidations or
    // `glTexImage2D` uploads) while avoiding 6 hidden `_visibility` Clip items.
    Image {
        width: 100%;
        height: 100%;
        source: AmbientWaveSprites.sprite_sheet;
        source-clip-x: root.active_frame * 64;
        source-clip-y: 0;
        source-clip-width: 64;
        source-clip-height: 24;
        image-fit: fill;
        image-rendering: pixelated;
    }
}

// Material 3 player transport button. The hero (play/pause) delegates to the
// shared M3 `FilledIconButton`, prev/next to `TonalIconButton`, so press feedback
// (state layer + ripple) is identical to every other M3 button in the appliance.
component TransportButton inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> is_hero: false;
    in property <bool> is_playing: false;

    property <length> button_size: (root.is_hero ? 86px : 72px) * TouchScale.widget_scale;
    property <length> glyph_size: (root.is_hero ? 26px : 32px) * TouchScale.widget_scale;
    width: root.button_size;
    height: root.button_size;

    if root.is_hero : FilledIconButton {
        width: 100%;
        height: 100%;
        icon: root.is_playing
            ? @image-url("../../../assets/icons/pause.svg")
            : (root.icon.width > 0 ? root.icon : @image-url("../../../assets/icons/play.svg"));
        tooltip: root.is_playing ? "Pause" : "Play";
        enabled: root.enabled;
        button_size: root.button_size;
        icon_size: root.glyph_size;
        clicked => { root.clicked(); }
    }

    if !root.is_hero : TonalIconButton {
        width: 100%;
        height: 100%;
        icon: root.icon;
        enabled: root.enabled;
        button_size: root.button_size;
        icon_size: root.glyph_size;
        clicked => { root.clicked(); }
    }

    callback clicked();
}

export component NowPlayingView inherits Rectangle {
    in property <string> track_title: "Waiting for Bluetooth Connection...";
    in property <string> track_title_line1: "";
    in property <string> track_title_line2: "";
    in property <bool> title_split_mode: false;
    in property <string> track_artist: "";
    in property <string> track_album: "";
    in property <string> artist_marquee_text;
    in property <string> position_text: "0:00";
    in property <string> duration_text: "0:00";
    in property <int> duration_ms: 0;
    // Timeline availability reported by BlueZ. `u32::MAX` means "the peer did
    // not describe the timeline", which must not be formatted as a timestamp.
    in property <bool> duration_known: true;
    in property <bool> position_known: true;
    // Determinate only when both sides of the timeline are known: a fill needs a
    // position and a geometry needs a total.
    property <bool> seek_determinate: root.duration_known && root.position_known;
    // Neither known: there is nothing meaningful to draw.
    property <bool> seek_hidden: !root.duration_known && !root.position_known;
    // Exactly one side known (e.g. a total length with no playhead yet): the bar
    // has no meaningful fill, so it degrades to a thin, thumb-less track with a
    // slow shimmer sweep instead of a permanently empty determinate bar.
    property <bool> seek_indeterminate: !root.seek_determinate && !root.seek_hidden;
    in property <float> progress_ratio: 0.0;
    in property <bool> is_playing: false;
    in property <bool> has_cover_art: false;
    in property <image> cover_image;
    in property <bool> transport_available: root.duration_ms > 0 || root.is_playing || (root.track_title != "" && root.track_title != "Waiting for Bluetooth Connection...");
    // Marquee scroll rate in ticks per second (30 or 60; default 60). One shared
    // 16.65 ms timer advances `marquee_clock` by one scroll step every
    // `step_frames` triggers, so both marquees scroll in lockstep and the render
    // loop receives exactly one dirty event per effective animation frame.
    in property <int> marquee_fps: MarqueeCompose.marquee_fps;
    in-out property <int> marquee_clock <=> MarqueeCompose.clock;
    property <int> step_frames: Math.max(1, Math.round(60 / root.marquee_fps));
    out property <bool> is_animating: (!root.title_split_mode && title_marquee.is_overflow) || root.is_playing;

    // Indeterminate-seek shimmer clock. One full sweep takes
    // `shimmer_sweep_ms` (2.5 s) sampled every `shimmer_step_ms` (50 ms), i.e.
    // `shimmer_steps` discrete positions. Ticks only advance while playing, so
    // pausing freezes the sweep in place instead of leaving it oscillating, and
    // the phase resets whenever the row stops being indeterminate so each
    // episode restarts from the documented "half-on at the left edge" frame.
    property <int> shimmer_sweep_ms: 2500;
    property <int> shimmer_step_ms: 50;
    property <int> shimmer_steps: root.shimmer_sweep_ms / root.shimmer_step_ms;
    property <int> shimmer_tick: 0;
    property <float> shimmer_progress: root.shimmer_tick * 1.0 / root.shimmer_steps;

    changed seek_indeterminate => {
        root.shimmer_tick = 0;
    }

    Timer {
        interval: root.shimmer_step_ms * 1ms;
        running: root.seek_indeterminate && root.is_playing;
        triggered() => {
            root.shimmer_tick = Math.mod(root.shimmer_tick + 1, root.shimmer_steps);
        }
    }

    Timer {
        interval: root.step_frames * 16.65ms;
        running: !root.title_split_mode && title_marquee.is_overflow;
        triggered() => {
            root.marquee_clock += 1;
        }
    }

    // Restart the scroll when the title text changes so a new track begins at
    // the leading edge instead of resuming the previous track's offset.
    changed track_title => {
        root.marquee_clock = 0;
    }

    callback toggle_play_pause();
    callback next_track();
    callback previous_track();
    callback settings_clicked();
    callback visualizer_clicked();

    // Pre-warm the glyph atlas on the first frame for tabular playback timer
    // digits so 1 Hz mm:ss updates never trigger cold glyph rasterization.
    // Uses `cache-rendering-hint: true` + near-zero brush alpha (`#00000001`)
    // instead of `opacity: 0.001`: in Skia, a non-unit `Opacity` item with
    // children executes an uncached `canvas.save_layer()` offscreen FBO pass
    // every frame (`SkiaItemRenderer::visit_opacity`).
    Rectangle {
        x: 0px;
        y: 0px;
        width: 1px;
        height: 1px;
        clip: true;
        border-radius: 0px;
        cache-rendering-hint: true;

        Text {
            text: "0123456789:";
            color: #00000001;
            font-family: "Inter Tabular";
            font-size: 18px * TouchScale.clamped_font_scale;
            font-weight: 700;
            wrap: no-wrap;
        }
    }

    HorizontalLayout {
        padding-top: 0px;
        padding-bottom: 0px;
        padding-left: MaterialStyleMetrics.padding_24;  // 24px from theme metrics
        padding-right: MaterialStyleMetrics.padding_24;
        spacing: MaterialStyleMetrics.spacing_16;

        // Left Column: square cover art / vinyl disc box vertically centered
        // in the available space below the status bar (30px margins top/bottom).
        Rectangle {
            width: 360px;

            Rectangle {
                x: 0px;
                y: (parent.height - self.height) / 2;
                width: 360px;
                height: 360px;
                border-radius: 16px;
                clip: true;
                background: @linear-gradient(145deg, MaterialPalette.surface 0%, MaterialPalette.background 100%);
                border-width: 1px;
                border-color: MaterialPalette.outline_variant;
                // Cache the 360x360 rounded cover-art card into a GPU FBO texture
                // (`SkiaItemRenderer` `LayerRenderer`) so 60 Hz marquee ticks blit
                // one axis-aligned texture instead of re-clipping `rrect` and
                // re-shading the 145deg gradient every frame.
                cache-rendering-hint: true;

                // Ambient glowing aura behind the turntable when music is playing
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: parent.width - 40px;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: MaterialPalette.primary;
                    opacity: root.is_playing ? 0.12 : 0.02;
                    animate opacity { duration: 600ms; easing: ease-in-out; }
                }

                // 1. Cover Art Image (if available from AVRCP)
                if root.has_cover_art : Image {
                    width: 100%;
                    height: 100%;
                    source: root.cover_image;
                    image-fit: contain;
                    image-rendering: pixelated;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                // 2. Cover Art Placeholder (when no Bluetooth cover art)
                if !root.has_cover_art : Image {
                    width: 78%;
                    height: 78%;
                    source: @image-url("../../../assets/icons/disk.svg");
                    colorize: MaterialPalette.primary;
                    image-fit: contain;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Right Column: Track Info, Scrubber & Transport
        // Absolute positioning guarantees equal CENTER distances:
        // singer -> seek bar -> transport row -> settings button (each step = D)
        right_col := Rectangle {
            horizontal-stretch: 1;
            background: transparent;

            // Artist center tracks the actual title container height (dynamic), with a
            // floor for the empty-strip startup state. Strip preferred-height varies
            // when the strip is empty, so a floor keeps distances deterministic at boot.
            property <length> split_height_floor: 28px * TouchScale.clamped_font_scale;
            property <length> title_height: root.title_split_mode
                ? Math.max(split_title.preferred-height, self.split_height_floor)
                : Math.max(title_marquee.height, title_marquee.height_floor);
            property <length> artist_center_y: 30px + self.title_height + 16px + 14px * TouchScale.clamped_font_scale;
            property <length> settings_center_y: parent.height - (MaterialStyleMetrics.padding_24 + 28px * TouchScale.widget_scale);
            property <length> center_step: (self.settings_center_y - self.artist_center_y) / 3.0;
            property <length> seek_center_y: self.artist_center_y + self.center_step;
            property <length> transport_center_y: self.artist_center_y + self.center_step * 2.0;

            // Track metadata & live playback wave (top-aligned with cover art)
            metadata := VerticalLayout {
                y: 30px;
                width: 100%;
                spacing: 16px;  // More distance between title and singer

                title_slot := Rectangle {
                    width: 100%;
                    height: right_col.title_height;

                    property <string> split_line1_text: root.track_title_line1 != "" ? root.track_title_line1 : root.track_title;

                    // Wrap the 4 off-layout single-line probes and the two-line
                    // `split_title` container inside a `cache-rendering-hint: true`
                    // layer. While `title_split_mode == false` (single-line /
                    // marquee scrolling mode), all 5 children have `visible: false`,
                    // so `i_slint_core::item_rendering::render_layer` computes a
                    // `0x0` bounding rect, allocates zero GPU FBO memory
                    // (`layer_cache` stores `None`), and prunes all 13 child items
                    // in a single HashMap lookup per 60 Hz frame.
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        cache-rendering-hint: true;

                        // Off-layout single-line probes (placed in the Rectangle, outside
                        // VerticalLayout, so they never affect preferred-height) to pick the
                        // largest font size (32px -> 30px -> 28px) that fits without ellipsis.
                        probe_32_l1 := Text {
                            x: 0;
                            y: 0;
                            visible: false;
                            text: title_slot.split_line1_text;
                            font-size: 32px * TouchScale.clamped_font_scale;
                            font-weight: 800;
                            wrap: no-wrap;
                        }
                        probe_32_l2 := Text {
                            x: 0;
                            y: 0;
                            visible: false;
                            text: root.track_title_line2;
                            font-size: 32px * TouchScale.clamped_font_scale;
                            font-weight: 800;
                            wrap: no-wrap;
                        }
                        probe_30_l1 := Text {
                            x: 0;
                            y: 0;
                            visible: false;
                            text: title_slot.split_line1_text;
                            font-size: 30px * TouchScale.clamped_font_scale;
                            font-weight: 800;
                            wrap: no-wrap;
                        }
                        probe_30_l2 := Text {
                            x: 0;
                            y: 0;
                            visible: false;
                            text: root.track_title_line2;
                            font-size: 30px * TouchScale.clamped_font_scale;
                            font-weight: 800;
                            wrap: no-wrap;
                        }

                        split_title := VerticalLayout {
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            visible: root.title_split_mode;
                            spacing: 2px;

                            Text {
                                text: title_slot.split_line1_text;
                                color: MaterialPalette.on_background;
                                font-size: title_slot.split_font_size;
                                font-weight: 800;
                                overflow: elide;
                                wrap: no-wrap;
                                vertical-alignment: center;
                            }

                            if root.track_title_line2 != "" : Text {
                                text: root.track_title_line2;
                                color: MaterialPalette.on_background;
                                font-size: title_slot.split_font_size;
                                font-weight: 800;
                                overflow: elide;
                                wrap: no-wrap;
                                vertical-alignment: center;
                            }
                        }
                    }

                    property <bool> fits_32: probe_32_l1.preferred-width <= title_slot.width
                        && (root.track_title_line2 == "" || probe_32_l2.preferred-width <= title_slot.width);
                    property <bool> fits_30: probe_30_l1.preferred-width <= title_slot.width
                        && (root.track_title_line2 == "" || probe_30_l2.preferred-width <= title_slot.width);
                    property <length> split_font_size: (self.fits_32 ? 32px : (self.fits_30 ? 30px : 28px)) * TouchScale.clamped_font_scale;

                    title_marquee := MarqueeText {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        visible: !root.title_split_mode;
                        text: root.track_title;
                        strip_image: MarqueeCompose.title_strip;
                        clock_frame: root.marquee_clock;
                        marquee_fps: root.marquee_fps;
                    }
                }

                HorizontalLayout {
                    spacing: 12px;

                    // The artist/album line is intentionally static (no marquee): long
                    // text is truncated with an ellipsis instead of scrolling. Cache the
                    // shaped glyph run into a GPU texture layer so 60 Hz title-marquee
                    // frames blit one texture instead of re-running Parley + `draw_glyphs_at`.
                    Rectangle {
                        horizontal-stretch: 1;
                        height: artist_text.preferred-height;
                        cache-rendering-hint: true;

                        artist_text := Text {
                            width: 100%;
                            height: 100%;
                            text: root.artist_marquee_text;
                            color: MaterialPalette.secondary;
                            font-size: 22px * TouchScale.clamped_font_scale;
                            font-weight: 700;
                            overflow: elide;
                            wrap: no-wrap;
                            vertical-alignment: center;
                        }
                    }

                    AmbientWaveIndicator {
                        is_playing: root.is_playing;
                        visible: root.is_playing;
                    }
                }
            }

                // Playback progress bar - seek center = artist center + D (equal center distances)
                //
                // Three presentation states driven by what the peer actually
                // reported (BlueZ uses `u32::MAX` for "unknown"):
                //   * position + duration -> determinate seek bar with fill
                //   * position only       -> thin thumb-less track with a slow
                //                            shimmer sweep (reads as active, not stuck)
                //   * neither             -> row hidden (nothing to show)
                //
                // Cache the outer seek-bar row (`cache-rendering-hint: true`) so
                // for 59 out of 60 frames/sec `SkiaItemRenderer::visit_layer`
                // returns `ContinueRenderingWithoutChildren` and prunes all 15
                // child items at the root, while keeping `dur_readout` cached
                // inside its own compact layer across 1 Hz progress ticks.
                Rectangle {
                    y: right_col.seek_center_y - self.height / 2;
                    width: 100%;
                    height: 24px * TouchScale.widget_scale;
                    visible: !root.seek_hidden;
                    cache-rendering-hint: true;

                    HorizontalLayout {
                        width: 100%;
                        height: 100%;
                        spacing: 16px;

                        // The readouts size to their content: a fixed 64 px slot
                        // clipped longer timestamps (`1:23:45`) with no way to grow.
                        // `min-width` keeps a stable slot for short values while the
                        // elastic track below yields the extra pixels. The columns
                        // are conditional (not `visible: false`) so an unreported
                        // side leaves no empty gap in the row.
                        if root.position_known : Rectangle {
                            min-width: Math.max(pos_readout.preferred-width, 64px * TouchScale.widget_scale);
                            height: parent.height;

                            pos_readout := Text {
                                width: 100%;
                                height: 100%;
                                text: root.position_text;
                                font-family: "Inter Tabular";
                                font-size: 18px * TouchScale.clamped_font_scale;
                                font-weight: 700;
                                color: MaterialPalette.on_surface;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            height: parent.height;
                            background: transparent;

                            // Background track (Vertically centered)
                            track := Rectangle {
                                x: 0px;
                                y: (parent.height - self.height) / 2;
                                width: parent.width;
                                // A thin track (plus the absent thumb) signals that
                                // dragging is disabled: there is no seek target.
                                height: root.seek_indeterminate ? 2px : 10px;
                                background: MaterialPalette.surface_container_highest;
                                border-radius: self.height / 2;
                                // Only enable rounded-rect clipping for the indeterminate
                                // shimmer sweep (which overhangs the ends); the determinate
                                // fill bar is already clamped to `[0, parent.width]` with
                                // matching `border-radius`, avoiding Skia's analytic `clip_rrect`.
                                clip: root.seek_indeterminate;

                                // Filled played position bar (determinate timeline only)
                                if root.seek_determinate : Rectangle {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width * Math.max(0.0, Math.min(1.0, root.progress_ratio));
                                    height: parent.height;
                                    background: MaterialPalette.primary;
                                    border-radius: parent.height / 2;
                                }

                                // Soft gradient sweep for the indeterminate track: a
                                // slow 2.5 s "still active" cue instead of a bar stuck
                                // at 0%. The band's centre travels from the left edge
                                // to the right edge (`parent.width`, not
                                // `parent.width + sweep_width`), so at every tick at
                                // least half the band is still on the track and the
                                // bar is never completely static. Ticks stop while
                                // paused, freezing the sweep.
                                if root.seek_indeterminate : Rectangle {
                                    property <length> sweep_width: parent.width * 0.35;
                                    width: self.sweep_width;
                                    height: parent.height;
                                    x: root.shimmer_progress * parent.width - self.sweep_width / 2;
                                    background: @linear-gradient(90deg, transparent 0%, MaterialPalette.primary 50%, transparent 100%);
                                    opacity: 0.55;
                                }
                            }
                        }

                        if root.duration_known : Rectangle {
                            min-width: Math.max(dur_readout.preferred-width, 64px * TouchScale.widget_scale);
                            height: parent.height;
                            cache-rendering-hint: true;

                            dur_readout := Text {
                                width: 100%;
                                height: 100%;
                                text: root.duration_text;
                                font-family: "Inter Tabular";
                                font-size: 18px * TouchScale.clamped_font_scale;
                                font-weight: 700;
                                color: MaterialPalette.on_surface_variant;
                                vertical-alignment: center;
                                horizontal-alignment: left;
                            }
                        }
                    }
                }

                // Transport controls row - transport center = artist center + 2D.
                // Cache the entire 3-button row into a single GPU FBO layer so
                // 60 Hz marquee ticks prune all 3 buttons at their parent root
                // (1 item visited + 1 texture blit instead of 3 separate blits).
                Rectangle {
                    y: right_col.transport_center_y - self.height / 2;
                    width: 100%;
                    height: 86px * TouchScale.widget_scale;
                    cache-rendering-hint: true;

                    HorizontalLayout {
                        width: 100%;
                        height: 100%;
                        alignment: center;
                        spacing: 36px;

                        // Previous Button - tonal filled circle (M3 button group)
                        VerticalLayout {
                            alignment: center;
                            TransportButton {
                                icon: @image-url("../../../assets/icons/previous.svg");
                                enabled: root.transport_available;
                                is_hero: false;
                                clicked => { root.previous_track(); }
                            }
                        }

                        // Play / Pause (Hero Button) - large filled primary circle (M3 filled button)
                        VerticalLayout {
                            alignment: center;
                            TransportButton {
                                icon: @image-url("../../../assets/icons/play.svg");
                                is_playing: root.is_playing;
                                enabled: root.transport_available;
                                is_hero: true;
                                clicked => { root.toggle_play_pause(); }
                            }
                        }

                        // Next Button - tonal filled circle (M3 button group)
                        VerticalLayout {
                            alignment: center;
                            TransportButton {
                                icon: @image-url("../../../assets/icons/next.svg");
                                enabled: root.transport_available;
                                is_hero: false;
                                clicked => { root.next_track(); }
                            }
                        }
                    }
                }
        }
    }

    // Dedicated Visualizer launch button anchored just left of Settings.
    visualizer_btn := OutlineIconButton {
        x: settings_btn.x - self.width - 12px;
        y: settings_btn.y;
        icon: @image-url("../../../assets/icons/equalizer.svg");
        tooltip: "Visualizer";
        button_size: 56px * TouchScale.widget_scale;
        icon_size: 28px * TouchScale.widget_scale;
        icon_color: MaterialPalette.primary;
        background_color: MaterialPalette.surface;
        border_color: MaterialPalette.outline_variant;
        cache-rendering-hint: true;
        clicked => { root.visualizer_clicked(); }
    }

    // Dedicated Settings button anchored to the right-bottom corner. Uses the
    // shared Material 3 outlined icon button so its press feedback (state layer
    // + ripple) is identical to every other M3 button on the appliance.
    settings_btn := OutlineIconButton {
        x: parent.width - self.width - MaterialStyleMetrics.padding_24;
        y: parent.height - self.height - MaterialStyleMetrics.padding_24;
        icon: @image-url("../../../assets/icons/config.svg");
        tooltip: "Settings";
        button_size: 56px * TouchScale.widget_scale;
        icon_size: 28px * TouchScale.widget_scale;
        icon_color: MaterialPalette.primary;
        background_color: MaterialPalette.surface;
        border_color: MaterialPalette.outline_variant;
        cache-rendering-hint: true;
        clicked => { root.settings_clicked(); }
    }
}