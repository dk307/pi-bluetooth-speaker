import { MaterialSchemes, MaterialScheme } from "@material/material.slint";

/**
 * Five custom dark MaterialSchemes matching the appliance's 5 theme presets.
 * All schemes are dark-mode only (appliance never uses light theme).
 * Index mapping: 0=McIntosh, 1=Marantz, 2=Cyberpunk, 3=Studio Dark, 4=PeppyMeter
 */
export global CustomMaterialSchemes {
    in-out property <MaterialSchemes> schemes: {
        light: {
            // Unused placeholder for API compatibility
            primary: #00C8FF, surfaceTint: #00C8FF, onPrimary: #090D12,
            primaryContainer: #003A5E, onPrimaryContainer: #70E1FF,
            secondary: #70E1FF, onSecondary: #090D12,
            secondaryContainer: #004A6E, onSecondaryContainer: #70E1FF,
            tertiary: #FF3344, onTertiary: #090D12,
            tertiaryContainer: #5E0011, onTertiaryContainer: #FF3344,
            error: #FF4444, onError: #090D12,
            errorContainer: #5E0000, onErrorContainer: #FFB4B4,
            background: #090D12, onBackground: #F0F6FC,
            surface: #111923, onSurface: #F0F6FC,
            surfaceVariant: #30363D, onSurfaceVariant: #8B949E,
            outline: #30363D, outlineVariant: #30363D,
            shadow: #000000, scrim: #000000,
            inverseSurface: #F0F6FC, inverseOnSurface: #090D12,
            inversePrimary: #006E99,
            primaryFixed: #70E1FF, onPrimaryFixed: #090D12,
            primaryFixedDim: #00C8FF, onPrimaryFixedVariant: #006E99,
            secondaryFixed: #70E1FF, onSecondaryFixed: #090D12,
            secondaryFixedDim: #00C8FF, onSecondaryFixedVariant: #006E99,
            tertiaryFixed: #FF3344, onTertiaryFixed: #090D12,
            tertiaryFixedDim: #FF3344, onTertiaryFixedVariant: #5E0011,
            surfaceDim: #090D12, surfaceBright: #111923,
            surfaceContainerLowest: #090D12, surfaceContainerLow: #111923,
            surfaceContainer: #111923, surfaceContainerHigh: #1A2230,
            surfaceContainerHighest: #30363D,
        },
        dark: {
            // ========== PRESET 0: McIntosh Blue (DEFAULT) ==========
            primary: #00C8FF,
            surfaceTint: #00C8FF,
            onPrimary: #090D12,
            primaryContainer: #003A5E,
            onPrimaryContainer: #70E1FF,
            secondary: #70E1FF,
            onSecondary: #090D12,
            secondaryContainer: #004A6E,
            onSecondaryContainer: #70E1FF,
            tertiary: #FF3344,
            onTertiary: #090D12,
            tertiaryContainer: #5E0011,
            onTertiaryContainer: #FF3344,
            error: #FF4444,
            onError: #090D12,
            errorContainer: #5E0000,
            onErrorContainer: #FFB4B4,
            background: #090D12,        // chassis
            onBackground: #F0F6FC,      // text_primary
            surface: #111923,           // card_surface
            onSurface: #F0F6FC,         // text_primary
            surfaceVariant: #30363D,    // card_border
            onSurfaceVariant: #8B949E,  // text_muted
            outline: #30363D,
            outlineVariant: #30363D,
            shadow: #000000,
            scrim: #000000,
            inverseSurface: #F0F6FC,
            inverseOnSurface: #090D12,
            inversePrimary: #006E99,
            primaryFixed: #70E1FF,
            onPrimaryFixed: #090D12,
            primaryFixedDim: #00C8FF,
            onPrimaryFixedVariant: #006E99,
            secondaryFixed: #70E1FF,
            onSecondaryFixed: #090D12,
            secondaryFixedDim: #00C8FF,
            onSecondaryFixedVariant: #006E99,
            tertiaryFixed: #FF3344,
            onTertiaryFixed: #090D12,
            tertiaryFixedDim: #FF3344,
            onTertiaryFixedVariant: #5E0011,
            surfaceDim: #090D12,
            surfaceBright: #111923,
            surfaceContainerLowest: #090D12,
            surfaceContainerLow: #111923,
            surfaceContainer: #111923,
            surfaceContainerHigh: #1A2230,
            surfaceContainerHighest: #30363D,

            // Presets 1-4 are generated at runtime from Rust (`ThemePreset::material_schemes`);
            // see THEME_MIGRATION_PLAN.md. This file is deleted in P5.
        }
    };
}