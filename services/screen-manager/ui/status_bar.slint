import {
    MaterialPalette,
    MaterialStyleMetrics,
    StateLayerArea,
    TouchScale,
} from "@material/material.slint";

// Single source of truth for codec specification display: codecs with fixed
// bitrate/specifications per Bluetooth SIG & Qualcomm specs — Qualcomm aptX HD
// (fixed 24-bit 48kHz 576kbps), aptX (fixed 16-bit 44.1kHz 352kbps), aptX LL.
// For variable/scalable codecs (LDAC, aptX Adaptive, LHDC, SSC, SBC, AAC, LC3),
// specs vary and are shown.
export global CodecSpecs {
    public pure function is-fixed-spec(codec: string) -> bool {
        return codec == "aptX-HD" ||
               codec == "aptX HD" ||
               codec == "aptXHD" ||
               codec == "aptx-hd" ||
               codec == "aptX" ||
               codec == "aptx" ||
               codec == "aptX-LL" ||
               codec == "aptX LL" ||
               codec == "aptx-ll";
    }
}

export component TopStatusBar inherits Rectangle {
    height: 60px;
    background: MaterialPalette.background;

    in property <string> active_source: "Bluetooth";
    in property <string> track_or_device: "Waiting for Connection...";
    in property <string> stream_codec: "aptX-HD";
    in property <string> stream_sample_rate: "48 kHz";
    in property <string> stream_bit_depth: "16-bit";
    in property <float> volume_value: 75.0;
    in property <bool> is_muted: false;
    // Bluetooth link state. The codec badge describes the negotiated A2DP stream, so it
    // is only rendered while a device is actually connected.
    in property <bool> bt_connected: false;

    // Display stream specs (sample rate & bit depth) only for codecs where specifications can vary
    in property <bool> show_stream_specs: !CodecSpecs.is-fixed-spec(root.stream_codec);

    // Dynamic volume icon level (volume-0 … volume-4; 0 lowest, 4 highest)
    property <int> vol_level: volume_value <= 0.0 ? 0 :
        (volume_value <= 25.0 ? 1 :
        (volume_value <= 50.0 ? 2 :
        (volume_value <= 75.0 ? 3 : 4)));

    // DIM toggle state (driven externally; reflects current night mode setting)
    in property <bool> dim_active: false;

    callback source_clicked();
    callback night_mode_clicked();
    callback volume_clicked();
    callback device_clicked();
    callback protocol_clicked();

    // --- Layout of the centered device name -------------------------------------
    // The name lives in the free space between the Bluetooth logo and the
    // right-hand controls, so a long device name is elided instead of being drawn
    // over the codec badge. Both edges are taken from the live layout geometry,
    // which keeps the gap correct when the codec badge appears or disappears.
    out property <length> logo_right: logo_image.absolute-position.x - root.absolute-position.x + logo_image.width;
    out property <length> controls_left: controls.absolute-position.x - root.absolute-position.x;
    property <length> name_gap: 12px;
    property <length> name_max_width: Math.max(0px, root.controls_left - root.logo_right - 2 * root.name_gap);
    property <length> name_width: Math.min(Math.min(device_text.preferred-width, 320px), root.name_max_width);
    property <length> name_x: root.logo_right + root.name_gap + (root.name_max_width - root.name_width) / 2;

    HorizontalLayout {
        padding-left: MaterialStyleMetrics.padding_24;
        padding-right: MaterialStyleMetrics.padding_24;
        alignment: space-between;

        // Left: Bluetooth Source (icon + label, no pill badge; vertically centered)
        VerticalLayout {
            alignment: center;
            StateLayerArea {
                color: MaterialPalette.primary;
                border_radius: MaterialStyleMetrics.border_radius_16;
                clicked => {
                    root.source_clicked();
                }

                HorizontalLayout {
                    spacing: 8px;

                    // Bluetooth Source Logo (icon + wordmark; full bar height,
                    // width pinned to the SVG's 370:100 aspect at bar scale)
                    logo_image := Image {
                        source: @image-url("../../../assets/icons/bluetooth-logo-word.svg");
                        colorize: MaterialPalette.primary;
                        height: root.height;
                        width: root.height * 3.45;
                        image-fit: fill;
                        cache-rendering-hint: true;
                    }
                }
            }
        }

        // Right: Codec Badge + Volume + DIM Toggle (Vertically centered)
        controls := VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 10px;

                // 1. Codec Badge (aptX-HD / AAC / SBC / LDAC) - original style with Material colors.
                // Rendered only while a Bluetooth device is connected: without a link there is
                // no negotiated codec to report. The conditional removes the badge from the
                // layout entirely, so the volume and DIM controls move inwards.
                if root.bt_connected : VerticalLayout {
                    alignment: center;
                    Rectangle {
                        // Fixed size so codec name changes never shift neighbors.
                        width: 120px;
                        height: 40px;
                        background: MaterialPalette.surface;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: MaterialPalette.outline_variant;

                        Text {
                            width: parent.width - 12px;
                            height: parent.height;
                            x: (parent.width - self.width) / 2;
                            text: root.stream_codec;
                            color: MaterialPalette.primary;
                            font-size: 16px * TouchScale.clamped_font_scale;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        StateLayerArea {
                            color: MaterialPalette.primary;
                            border_radius: 10px;
                            clicked => {
                                root.protocol_clicked();
                            }
                        }
                    }
                }

                // 2. Volume / Mute Control (kept custom - specialized SVG icons)
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        // Fixed width (icon + spacing + 3-digit value) so the
                        // volume readout never shifts neighbors as it changes.
                        width: 100px;
                        height: 52px;
                        background: transparent;
                        cache-rendering-hint: true;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            if !root.is_muted && root.vol_level == 0 : Image {
                                source: @image-url("../../../assets/icons/volume-0.svg");
                                colorize: MaterialPalette.secondary;
                                width: 44px;
                                image-fit: contain;
                            }
                            if !root.is_muted && root.vol_level == 1 : Image {
                                source: @image-url("../../../assets/icons/volume-1.svg");
                                colorize: MaterialPalette.secondary;
                                width: 44px;
                                image-fit: contain;
                            }
                            if !root.is_muted && root.vol_level == 2 : Image {
                                source: @image-url("../../../assets/icons/volume-2.svg");
                                colorize: MaterialPalette.secondary;
                                width: 44px;
                                image-fit: contain;
                            }
                            if !root.is_muted && root.vol_level == 3 : Image {
                                source: @image-url("../../../assets/icons/volume-3.svg");
                                colorize: MaterialPalette.secondary;
                                width: 44px;
                                image-fit: contain;
                            }
                            if !root.is_muted && root.vol_level == 4 : Image {
                                source: @image-url("../../../assets/icons/volume-4.svg");
                                colorize: MaterialPalette.secondary;
                                width: 44px;
                                image-fit: contain;
                            }

                            // The mute icon takes the same slot as the level icons so
                            // the readout keeps its "icon then value" order while muted.
                            if root.is_muted : Image {
                                source: @image-url("../../../assets/icons/volume-mute.svg");
                                colorize: MaterialPalette.error;
                                width: 44px;
                                image-fit: contain;
                            }

                            // The level readout stays visible while muted: it shows
                            // the stored amp level, tinted like the mute icon.
                            Text {
                                width: 48px * TouchScale.widget_scale;
                                text: Math.round(root.volume_value);
                                color: root.is_muted ? MaterialPalette.error : MaterialPalette.secondary;
                                font-size: 20px * TouchScale.clamped_font_scale;
                                font-weight: 800;
                                vertical-alignment: center;
                            }
                        }

                        StateLayerArea {
                            color: MaterialPalette.secondary;
                            border_radius: MaterialStyleMetrics.border_radius_16;
                            clicked => {
                                root.volume_clicked();
                            }
                        }
                    }
                }

                // 3. DIM Toggle Button - original style with Material colors
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 52px;
                        height: 40px;
                        background: MaterialPalette.surface;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: MaterialPalette.outline_variant;
                        cache-rendering-hint: true;

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: @image-url("../../../assets/icons/brightness.svg");
                            colorize: root.dim_active ? MaterialPalette.primary : MaterialPalette.secondary;
                            width: 24px;
                            height: 24px;
                            image-fit: contain;
                        }

                        StateLayerArea {
                            color: MaterialPalette.primary;
                            border_radius: 10px;
                            clicked => {
                                root.night_mode_clicked();
                            }
                        }
                    }
                }
            }
        }
    }

    // Center: Track / Client Quick Info — laid out inside the gap between the logo
    // and the right-hand controls (see `name_max_width`), so it can never overlap
    // the codec badge. Only the bounded name hit-box is touchable; clicks
    // elsewhere pass through to the logo and the volume / DIM controls.
    name_box := Rectangle {
        x: root.name_x;
        y: (root.height - self.height) / 2;
        width: root.name_width;
        height: 48px;

        device_text := Text {
            width: parent.width;
            height: parent.height;
            text: root.track_or_device;
            color: MaterialPalette.on_surface;
            font-size: 26px * TouchScale.clamped_font_scale;
            font-weight: 800;
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
        }

        StateLayerArea {
            color: MaterialPalette.primary;
            border_radius: MaterialStyleMetrics.border_radius_16;
            clicked => {
                root.device_clicked();
            }
        }
    }

    // Divider line under the top bar (mirrors the line above the bottom dock)
    Rectangle {
        y: parent.height - self.height;
        width: parent.width;
        height: 1px;
        background: MaterialPalette.outline_variant;
    }
}
