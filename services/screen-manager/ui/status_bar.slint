import { MaterialPalette } from "@material/material.slint";
import { MaterialStyleMetrics } from "@material/material.slint";

// Single source of truth for codec specification display: codecs with fixed
// bitrate/specifications per Bluetooth SIG & Qualcomm specs — Qualcomm aptX HD
// (fixed 24-bit 48kHz 576kbps), aptX (fixed 16-bit 44.1kHz 352kbps), aptX LL.
// For variable/scalable codecs (LDAC, aptX Adaptive, LHDC, SSC, SBC, AAC, LC3),
// specs vary and are shown.
export global CodecSpecs {
    public pure function is-fixed-spec(codec: string) -> bool {
        return codec == "aptX-HD" ||
               codec == "aptX HD" ||
               codec == "aptXHD" ||
               codec == "aptx-hd" ||
               codec == "aptX" ||
               codec == "aptx" ||
               codec == "aptX-LL" ||
               codec == "aptX LL" ||
               codec == "aptx-ll";
    }
}

export component TopStatusBar inherits Rectangle {
    height: 60px;
    background: MaterialPalette.background;

    in property <string> active_source: "Bluetooth";
    in property <string> track_or_device: "Waiting for Connection...";
    in property <string> stream_codec: "aptX-HD";
    in property <string> stream_sample_rate: "48 kHz";
    in property <string> stream_bit_depth: "16-bit";
    in property <float> volume_value: 75.0;
    in property <bool> is_muted: false;

    // Display stream specs (sample rate & bit depth) only for codecs where specifications can vary
    in property <bool> show_stream_specs: !CodecSpecs.is-fixed-spec(root.stream_codec);

    // Dynamic volume icon level (volume-0 … volume-4; 0 lowest, 4 highest)
    property <int> vol_level: volume_value <= 0.0 ? 0 :
        (volume_value <= 25.0 ? 1 :
        (volume_value <= 50.0 ? 2 :
        (volume_value <= 75.0 ? 3 : 4)));

    // DIM toggle state (driven externally; reflects current night mode setting)
    in property <bool> dim_active: false;

    callback source_clicked();
    callback night_mode_clicked();
    callback volume_clicked();
    callback device_clicked();
    callback protocol_clicked();

    HorizontalLayout {
        padding-left: MaterialStyleMetrics.padding_24;
        padding-right: MaterialStyleMetrics.padding_24;
        alignment: space-between;

        // Left: Bluetooth Source (icon + label, no pill badge; vertically centered)
        VerticalLayout {
            alignment: center;
            TouchArea {
                clicked => {
                    root.source_clicked();
                }

                HorizontalLayout {
                    spacing: 8px;

                    // Bluetooth Source Logo (icon + wordmark; full bar height,
                    // width pinned to the SVG's 370:100 aspect at bar scale)
                    Image {
                        source: @image-url("../../../assets/icons/bluetooth-logo-word.svg");
                        colorize: MaterialPalette.primary;
                        height: root.height;
                        width: root.height * 3.45;
                        image-fit: fill;
                    }
                }
            }
        }

        // Right: Codec Badge + Volume + DIM Toggle (Vertically centered)
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 10px;

                // 1. Codec Badge (aptX-HD / AAC / SBC / LDAC) - original style with Material colors
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        // Fixed size so codec name changes never shift neighbors.
                        width: 120px;
                        height: 40px;
                        background: MaterialPalette.surface;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: MaterialPalette.outline_variant;

                        Text {
                            width: parent.width - 12px;
                            height: parent.height;
                            x: (parent.width - self.width) / 2;
                            text: root.stream_codec;
                            color: MaterialPalette.primary;
                            font-size: 16px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        TouchArea {
                            clicked => {
                                root.protocol_clicked();
                            }
                        }
                    }
                }

                // 2. Volume / Mute Control (kept custom - specialized SVG icons)
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        // Fixed width (icon + spacing + 3-digit value) so the
                        // volume readout never shifts neighbors as it changes.
                        width: 100px;
                        height: 52px;
                        background: transparent;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            if !root.is_muted && root.vol_level == 0 : Image {
                                source: @image-url("../../../assets/icons/volume-0.svg");
                                colorize: MaterialPalette.secondary;
                                width: 44px;
                                image-fit: contain;
                            }
                            if !root.is_muted && root.vol_level == 1 : Image {
                                source: @image-url("../../../assets/icons/volume-1.svg");
                                colorize: MaterialPalette.secondary;
                                width: 44px;
                                image-fit: contain;
                            }
                            if !root.is_muted && root.vol_level == 2 : Image {
                                source: @image-url("../../../assets/icons/volume-2.svg");
                                colorize: MaterialPalette.secondary;
                                width: 44px;
                                image-fit: contain;
                            }
                            if !root.is_muted && root.vol_level == 3 : Image {
                                source: @image-url("../../../assets/icons/volume-3.svg");
                                colorize: MaterialPalette.secondary;
                                width: 44px;
                                image-fit: contain;
                            }
                            if !root.is_muted && root.vol_level == 4 : Image {
                                source: @image-url("../../../assets/icons/volume-4.svg");
                                colorize: MaterialPalette.secondary;
                                width: 44px;
                                image-fit: contain;
                            }

                            if !root.is_muted : Text {
                                width: 48px;
                                text: Math.round(root.volume_value);
                                color: MaterialPalette.secondary;
                                font-size: 20px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }

                            if root.is_muted : Image {
                                source: @image-url("../../../assets/icons/volume-mute.svg");
                                colorize: MaterialPalette.error;
                                width: 44px;
                                image-fit: contain;
                            }
                        }

                        TouchArea {
                            clicked => {
                                root.volume_clicked();
                            }
                        }
                    }
                }

                // 3. DIM Toggle Button - original style with Material colors
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 52px;
                        height: 40px;
                        background: MaterialPalette.surface;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: MaterialPalette.outline_variant;

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: @image-url("../../../assets/icons/brightness.svg");
                            colorize: root.dim_active ? MaterialPalette.primary : MaterialPalette.secondary;
                            width: 24px;
                            height: 24px;
                            image-fit: contain;
                        }

                        TouchArea {
                            clicked => {
                                root.night_mode_clicked();
                            }
                        }
                    }
                }
            }
        }
    }

    // Center: Track / Client Quick Info — a full-width overlay stretched across
    // the bar (out of the flow layout so space-between of side elements can't
    // shift it). HorizontalLayout { alignment: center } centers the text element
    // horizontally on the bar; VerticalLayout centers it vertically. Only the
    // bounded name hit-box has a TouchArea; clicks elsewhere pass through.
    VerticalLayout {
        height: parent.height;
        alignment: center;

        HorizontalLayout {
            alignment: center;

            // Touch target hugs the (elided) name so it never covers the volume / DIM controls.
            Rectangle {
                width: min(device_name.preferred-width, 320px);
                height: 48px;

                device_name := Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.track_or_device;
                    color: MaterialPalette.on_surface;
                    font-size: 26px;
                    font-weight: 800;
                    vertical-alignment: center;
                    overflow: elide;
                }

                TouchArea {
                    clicked => {
                        root.device_clicked();
                    }
                }
            }
        }
    }

    // Divider line under the top bar (mirrors the line above the bottom dock)
    Rectangle {
        y: parent.height - self.height;
        width: parent.width;
        height: 1px;
        background: MaterialPalette.outline_variant;
    }
}