import { Theme } from "theme.slint";

export component TopStatusBar inherits Rectangle {
    height: 60px;
    background: Theme.active.chassis;

    in property <string> active_source: "Bluetooth";
    in property <string> track_or_device: "Waiting for Connection...";
    in property <string> stream_codec: "aptX-HD";
    in property <string> stream_sample_rate: "48 kHz";
    in property <string> stream_bit_depth: "16-bit";
    in property <float> volume_value: 75.0;
    in property <bool> is_muted: false;

    // Codecs with fixed bitrate/specifications per Bluetooth SIG & Qualcomm specs:
    // Qualcomm aptX HD (fixed 24-bit 48kHz 576kbps), aptX (fixed 16-bit 44.1kHz 352kbps), aptX LL.
    // For variable/scalable codecs (LDAC, aptX Adaptive, LHDC, SSC, SBC, AAC, LC3), specs vary and are shown.
    property <bool> is_fixed_spec_codec: (
        root.stream_codec == "aptX-HD" ||
        root.stream_codec == "aptX HD" ||
        root.stream_codec == "aptXHD" ||
        root.stream_codec == "aptx-hd" ||
        root.stream_codec == "aptX" ||
        root.stream_codec == "aptx" ||
        root.stream_codec == "aptX-LL" ||
        root.stream_codec == "aptX LL" ||
        root.stream_codec == "aptx-ll"
    );

    // Display stream specs (sample rate & bit depth) only for codecs where specifications can vary
    in property <bool> show_stream_specs: !root.is_fixed_spec_codec;

    // Dynamic volume icon level (volume-0 … volume-4; 0 lowest, 4 highest)
    property <int> vol_level: volume_value <= 0.0 ? 0 :
        (volume_value <= 25.0 ? 1 :
        (volume_value <= 50.0 ? 2 :
        (volume_value <= 75.0 ? 3 : 4)));

    callback source_clicked();
    callback night_mode_clicked();
    callback volume_clicked();

    HorizontalLayout {
        padding-left: 0px;
        padding-right: 18px;
        alignment: space-between;

        // Left: Bluetooth Source (icon + label, no pill badge; vertically centered)
        VerticalLayout {
            alignment: center;
            TouchArea {
                clicked => {
                    root.source_clicked();
                }

                HorizontalLayout {
                    spacing: 8px;

                    // Bluetooth Source Logo (icon + wordmark; full bar height,
                    // width pinned to the SVG's 370:100 aspect at bar scale)
                    Image {
                        source: @image-url("../../../assets/icons/bluetooth-logo-word.svg");
                        colorize: Theme.active.primary_accent;
                        height: root.height;
                        width: root.height * 3.45;
                        image-fit: fill;
                    }
                }
            }
        }

        // Right: Audio Codec, Sample Rate, Bit Depth Badges + Volume + DIM Toggle (Vertically centered)
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 10px;

                // 1. Codec Badge (aptX-HD / AAC / SBC / LDAC)
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        // Fixed size so codec name changes never shift neighbors.
                        width: 120px;
                        height: 40px;
                        background: Theme.active.card_surface;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.active.card_border;

                        Text {
                            width: parent.width - 12px;
                            height: parent.height;
                            x: (parent.width - self.width) / 2;
                            text: root.stream_codec;
                            color: Theme.active.primary_accent;
                            font-size: 16px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // 4. Volume / Mute Control (Takes whole vertical space of top row)
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        // Fixed width (icon + spacing + 3-digit value) so the
                        // volume readout never shifts neighbors as it changes.
                        width: 100px;
                        height: 52px;
                        background: transparent;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            if !root.is_muted && root.vol_level == 0 : Image {
                                source: @image-url("../../../assets/icons/volume-0.svg");
                                colorize: Theme.active.secondary_accent;
                                width: 44px;
                                image-fit: contain;
                            }
                            if !root.is_muted && root.vol_level == 1 : Image {
                                source: @image-url("../../../assets/icons/volume-1.svg");
                                colorize: Theme.active.secondary_accent;
                                width: 44px;
                                image-fit: contain;
                            }
                            if !root.is_muted && root.vol_level == 2 : Image {
                                source: @image-url("../../../assets/icons/volume-2.svg");
                                colorize: Theme.active.secondary_accent;
                                width: 44px;
                                image-fit: contain;
                            }
                            if !root.is_muted && root.vol_level == 3 : Image {
                                source: @image-url("../../../assets/icons/volume-3.svg");
                                colorize: Theme.active.secondary_accent;
                                width: 44px;
                                image-fit: contain;
                            }
                            if !root.is_muted && root.vol_level == 4 : Image {
                                source: @image-url("../../../assets/icons/volume-4.svg");
                                colorize: Theme.active.secondary_accent;
                                width: 44px;
                                image-fit: contain;
                            }

                            if !root.is_muted : Text {
                                width: 48px;
                                text: Math.round(root.volume_value);
                                color: Theme.active.secondary_accent;
                                font-size: 20px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }

                            if root.is_muted : Image {
                                source: @image-url("../../../assets/icons/volume-mute.svg");
                                colorize: #EF4444;
                                width: 44px;
                                image-fit: contain;
                            }
                        }

                        TouchArea {
                            clicked => {
                                root.volume_clicked();
                            }
                        }
                    }
                }

                // 5. DIM Toggle Button
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 52px;
                        height: 40px;
                        background: Theme.active.card_surface;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.active.card_border;

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: @image-url("../../../assets/icons/brightness.svg");
                            colorize: Theme.active.text_muted;
                            width: 24px;
                            height: 24px;
                            image-fit: contain;
                        }

                        TouchArea {
                            clicked => {
                                root.night_mode_clicked();
                            }
                        }
                    }
                }
            }
        }
    }

    // Center: Track / Client Quick Info — a full-width overlay stretched across
    // the bar (out of the flow layout so space-between of side elements can't
    // shift it). HorizontalLayout { alignment: center } centers the text element
    // horizontally on the bar; VerticalLayout centers it vertically. No
    // TouchArea here, so clicks pass through to the side elements underneath.
    VerticalLayout {
        height: parent.height;
        alignment: center;

        HorizontalLayout {
            alignment: center;

            Text {
                text: root.track_or_device;
                color: Theme.active.text_primary;
                font-size: 26px;
                font-weight: 800;
                vertical-alignment: center;
                overflow: elide;
                max-width: 320px;
            }
        }
    }

    // Divider line under the top bar (mirrors the line above the bottom dock)
    Rectangle {
        y: parent.height - self.height;
        width: parent.width;
        height: 1px;
        background: Theme.active.card_border;
    }
}
