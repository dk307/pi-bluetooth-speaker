// Reusable horizontal level slider with a large circular thumb.
//
// Extracted verbatim from the volume HUD's inline slider so the volume and
// brightness overlays share one copy of the touch math (anti-bloat). This
// component is Rectangle-rooted because it is only composed inside other Slint
// components — no Rust struct is generated for it (screen-manager AGENTS.md
// item 11). Components that need a Rust accessor must inherit Window instead.

import {
    MaterialPalette,
    TouchScale,
} from "@material/material.slint";

export component LevelSlider inherits Rectangle {
    // Current level in the 0..100 percent range.
    in-out property <float> value: 0.0;
    // Total width of the slider box.
    in property <length> slider-width: 620px;
    // Height of the touch target.
    in property <length> touch-height: 64px;
    // Height of the pill track.
    in property <length> track-height: 16px;
    // Diameter of the circular thumb.
    in property <length> thumb-diameter: 44px;
    // False renders the track and thumb with the muted/inactive palette.
    in property <bool> active: true;
    // Fill color used for the active track portion and the thumb.
    in property <color> fill-color: MaterialPalette.primary;
    // True while a pointer is dragging the thumb.
    out property <bool> dragging: false;

    // Fired with the new integer percent whenever the user moves the thumb.
    callback changed(float);
    // Fired on every touch so the owner can keep its HUD alive.
    callback interaction_activity();

    // NaN-safe normalized level ratio (0.0 .. 1.0).
    property <float> clamped-ratio: root.value >= 0.0 ? Math.min(1.0, root.value / 100.0) : 0.0;

    height: root.touch-height;

    slider_box := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.slider-width;
        height: root.touch-height;
        background: transparent;

        function update_from_touch(mx: length) {
            let eff_x = Math.max(0px, Math.min(track_bar.width, mx - track_bar.x));
            let pct = Math.round((eff_x / track_bar.width) * 100.0);
            root.value = pct;
            root.interaction_activity();
            root.changed(pct);
        }

        // Horizontal pill track inset by half the thumb diameter so the big circle
        // never clips at 0% or 100%.
        track_bar := Rectangle {
            x: root.thumb-diameter / 2;
            y: (parent.height - self.height) / 2;
            width: parent.width - root.thumb-diameter;
            height: root.track-height;
            border-radius: self.height / 2;
            background: MaterialPalette.surface_container_highest;
            border-width: 1px;
            border-color: MaterialPalette.outline_variant;
            clip: true;

            // Active fill bar.
            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width * root.clamped-ratio;
                height: parent.height;
                border-radius: self.height / 2;
                background: root.active ? root.fill-color : MaterialPalette.on_surface_variant;
            }
        }

        // Big circular thumb handle.
        thumb_circle := Rectangle {
            width: root.thumb-diameter;
            height: root.thumb-diameter;
            border-radius: self.height / 2;
            x: track_bar.x + (track_bar.width * root.clamped-ratio) - (self.width / 2);
            y: (parent.height - self.height) / 2;
            background: root.active ? root.fill-color : MaterialPalette.surface;
            border-width: 4px;
            border-color: MaterialPalette.on_surface;

            // High-contrast center dot inside the big circle.
            Rectangle {
                width: 14px * TouchScale.widget_scale;
                height: 14px * TouchScale.widget_scale;
                border-radius: self.height / 2;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: MaterialPalette.on_surface;
            }
        }

        slider_touch := TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.dragging = true;
                    slider_box.update_from_touch(self.mouse-x);
                } else if (event.kind == PointerEventKind.up) {
                    root.dragging = false;
                }
            }
            moved => {
                if (self.pressed) {
                    slider_box.update_from_touch(self.mouse-x);
                }
            }
        }
    }
}
