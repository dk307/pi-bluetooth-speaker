import { BootCheckLine, SplashScreen } from "splash.slint";
import { AppTheme } from "app_theme.slint";
import { MaterialPalette } from "@material/material.slint";
import { TopStatusBar } from "status_bar.slint";
import { MainViewport } from "viewport.slint";
import { MarqueeRasterizer } from "marquee_rasterizer.slint";
import { MarqueeCompose } from "marquee_state.slint";
import { ScreenAppBar } from "screen_app_bar.slint";
import { VolumeHudOverlay } from "volume_hud.slint";

// Re-exported so slint-build generates the Rust global accessor for the composer bridge.
export { MarqueeCompose }

import "../../../assets/fonts/Inter-Regular.ttf";
import "../../../assets/fonts/Inter-Medium.ttf";
import "../../../assets/fonts/Inter-SemiBold.ttf";
import "../../../assets/fonts/Inter-Bold.ttf";
import "../../../assets/fonts/Inter-ExtraBold.ttf";

export { BootCheckLine, SplashScreen, MarqueeRasterizer, MaterialPalette, AppTheme }

export component MainWindow inherits Window {
    title: "DietPi Audiophile Console";
    width: 800px;
    height: 480px;
    background: MaterialPalette.background;
    default-font-family: "Inter";

    in-out property <int> active_tab: 0;
    in-out property <string> active_source: "Bluetooth";
    in-out property <string> track_or_device: "Waiting for Connection...";
    in-out property <string> stream_codec: "aptX-HD";
    in-out property <string> stream_sample_rate: "48 kHz";
    in-out property <string> stream_bit_depth: "16-bit";
    in-out property <bool> show_stream_specs <=> status_bar.show_stream_specs;
    in-out property <string> track_title: "Waiting for Bluetooth Connection...";
    in-out property <string> track_artist: "";
    in-out property <string> track_album: "";
    in-out property <string> stream_details: "aptX-HD 576k | 48kHz/16-bit -> DSP 32-bit";
    in-out property <string> position_text: "00:00";
    in-out property <string> duration_text: "00:00";
    in-out property <int> duration_ms: 0;
    in-out property <float> progress_ratio: 0.0;
    in-out property <float> volume_value: 75.0;
    in-out property <bool> is_playing: false;
    in-out property <bool> is_muted: false;
    in-out property <bool> volume_hud_visible: false;
    in-out property <int> volume_hud_timeout_ms: 4000;
    in-out property <int> volume_hud_fade_ms: 200;
    in-out property <int> volume_hud_elapsed_ms: 0;
    out property <float> volume_hud_opacity: root.volume_hud_visible ? 1.0 : 0.0;
    animate volume_hud_opacity { duration: root.volume_hud_fade_ms * 1ms; easing: ease-out; }
    in-out property <bool> has_cover_art: false;
    in-out property <image> cover_image;
    in-out property <float> left_peak_ratio: 0.0;
    in-out property <float> right_peak_ratio: 0.0;
    in-out property <bool> cd_enabled: false;
    out property <bool> is_animating: root.active_tab == 0 || root.volume_hud_visible || root.volume_hud_opacity > 0.01;

    // NEW: show_themes lifted to MainWindow for title switching in ScreenAppBar
    in-out property <bool> show_themes: false;

    // NEW: single source of truth for status bar visibility (Now Playing tab only)
    out property <bool> show_status_bar: root.active_tab == 0;

    public function show_volume_hud() {
        root.volume_hud_elapsed_ms = 0;
        root.volume_hud_visible = true;
    }

    public function dismiss_volume_hud() {
        root.volume_hud_visible = false;
        root.volume_hud_elapsed_ms = 0;
    }

    Timer {
        interval: 50ms;
        running: root.volume_hud_visible;
        triggered() => {
            root.volume_hud_elapsed_ms += 50;
            if (root.volume_hud_elapsed_ms >= root.volume_hud_timeout_ms) {
                root.volume_hud_visible = false;
                root.volume_hud_elapsed_ms = 0;
            }
        }
    }

    // Bluetooth details (Tab 2) text, pushed from the bt-monitor worker snapshot.
    in-out property <bool> bt_connected: false;
    in-out property <string> bt_device_address: "—";
    in-out property <string> bt_link_text: "Waiting for connection";
    in-out property <string> bt_rssi_text: "";
    in-out property <string> bt_battery_text: "";
    in-out property <string> bt_stream_format: "—";
    in-out property <string> bt_delay_text: "—";
    in-out property <string> bt_adapter_name: "—";
    in-out property <string> bt_adapter_address: "—";
    // Tab to return to when the Bluetooth details screen is dismissed.
    in-out property <int> previous_tab: 0;

    // Marquee text strips pre-rendered offscreen by `MarqueeStripRasterizer`; the images
    // are re-rasterized from Rust only when their text, color, or typography changes.
    in-out property <image> title_marquee_strip;
    // Single source of truth for the artist/album composite shown in the second marquee,
    // shared by the declarative binding and the Rust-side strip rasterizer.
    out property <string> artist_marquee_text:
        root.track_album != "" && root.track_album != "High-Resolution DSP Sink" && root.track_album != "Audiophile DSP Sink" ?
        (root.track_artist + " • " + root.track_album) : root.track_artist;

    callback toggle_play_pause();
    callback next_track();
    callback previous_track();
    callback toggle_mute();
    callback volume_clicked();
    callback stream_pill_clicked();
    callback volume_changed(float);
    callback source_clicked();
    callback night_mode_clicked();
    callback tab_selected(int);
    callback select_theme(int);
    callback cycle_theme();

    // Opens the Bluetooth details tab from any screen; calling it again (or `Back`)
    // returns to the tab it was opened from.
    public function toggle_bluetooth_details() {
        if (root.active_tab == 2) {
            root.active_tab = root.previous_tab == 2 ? 0 : root.previous_tab;
        } else {
            root.previous_tab = root.active_tab;
            root.active_tab = 2;
        }
    }

    // NEW: Screen app bar back button handler
    public function app_bar_back() {
        if (root.active_tab == 2) {
            root.toggle_bluetooth_details();
        } else if (root.active_tab == 5 && root.show_themes) {
            root.show_themes = false;
        } else if (root.active_tab != 0) {
            // Tabs 1, 3, 4, and 5 (when not in themes): return to previous tab, falling back to Now Playing
            root.active_tab = root.previous_tab == root.active_tab ? 0 : root.previous_tab;
        }
    }

    // Root stacking container: bg_column (bottom), hud_scrim (middle), volume_hud (top)
    Rectangle {
        // Background column (home AND screens). Overlay dimming is applied by the
        // hud_scrim layer below (single dimming mechanism).
        bg_column := VerticalLayout {
            width: 100%;
            height: 100%;

            // Top Status Bar: 800 x 60 — ONLY on Now Playing tab (tab 0).
            // Uses `visible` (not opacity) so it takes ZERO layout space when hidden.
            Rectangle {
                visible: root.show_status_bar;
                height: 60px;
                width: 100%;

                status_bar := TopStatusBar {
                    width: 100%;
                    height: 100%;
                    active_source: root.active_source;
                    track_or_device: root.track_or_device;
                    stream_codec: root.stream_codec;
                    stream_sample_rate: root.stream_sample_rate;
                    stream_bit_depth: root.stream_bit_depth;
                    volume_value: root.volume_value;
                    is_muted: root.is_muted;
                    source_clicked => {
                        root.toggle_bluetooth_details();
                        root.source_clicked();
                    }
                    device_clicked => { root.toggle_bluetooth_details(); }
                    protocol_clicked => { root.toggle_bluetooth_details(); }
                    night_mode_clicked => { root.night_mode_clicked(); }
                    volume_clicked => {
                        root.show_volume_hud();
                        root.volume_clicked();
                    }
                }
            }

            // Screen App Bar: 800 x 60 — ONLY on overlay screens (tabs 1-5).
            // Uses `visible` so it takes ZERO layout space on Now Playing tab.
            screen_app_bar := ScreenAppBar {
                visible: root.active_tab != 0;
                height: 60px;
                title: root.active_tab == 1 ? "VU Meter" :
                       root.active_tab == 2 ? "Bluetooth" :
                       root.active_tab == 3 ? "CD Player" :
                       root.active_tab == 4 ? "DSP & Tone" :
                       root.active_tab == 5 ? (root.show_themes ? "Themes" : "Settings") : "";
                leading_icon: @image-url("../../../assets/icons/back.svg");
                leading_clicked => { root.app_bar_back(); }
            }

            // Main Viewport: fills remaining space — ALWAYS MOUNTED (all `<=>` bindings intact)
            viewport := MainViewport {
                active_tab <=> root.active_tab;
                cd_enabled: root.cd_enabled;
                track_title: root.track_title;
                track_artist: root.track_artist;
                track_album: root.track_album;
                stream_details: root.stream_details;
                position_text: root.position_text;
                duration_text: root.duration_text;
                duration_ms: root.duration_ms;
                progress_ratio: root.progress_ratio;
                volume_value <=> root.volume_value;
                is_playing: root.is_playing;
                is_muted <=> root.is_muted;
                volume_hud_opacity: root.volume_hud_opacity;
                has_cover_art: root.has_cover_art;
                cover_image: root.cover_image;
                left_peak_ratio: root.left_peak_ratio;
                right_peak_ratio: root.right_peak_ratio;
                track_or_device: root.track_or_device;
                stream_codec: root.stream_codec;
                bt_connected: root.bt_connected;
                bt_device_address: root.bt_device_address;
                bt_link_text: root.bt_link_text;
                bt_rssi_text: root.bt_rssi_text;
                bt_battery_text: root.bt_battery_text;
                bt_stream_format: root.bt_stream_format;
                bt_delay_text: root.bt_delay_text;
                bt_adapter_name: root.bt_adapter_name;
                bt_adapter_address: root.bt_adapter_address;
                title_marquee_strip: root.title_marquee_strip;
                artist_marquee_text: root.artist_marquee_text;
                show_themes <=> root.show_themes;

                toggle_play_pause => { root.toggle_play_pause(); }
                next_track => { root.next_track(); }
                previous_track => { root.previous_track(); }
                toggle_mute => { root.toggle_mute(); }
                stream_pill_clicked => { root.stream_pill_clicked(); }
                settings_clicked => {
                    root.previous_tab = root.active_tab;
                    root.active_tab = 5;
                }
                select_tab(idx) => {
                    root.previous_tab = root.active_tab;
                    root.active_tab = idx;
                }
                volume_changed(val) => { root.volume_changed(val); }
                select_theme(idx) => { root.select_theme(idx); }
                cycle_theme => { root.cycle_theme(); }
            }
        }

        // HUD scrim (middle layer)
        hud_scrim := Rectangle {
            width: 100%;
            height: 100%;
            background: #000000;
            opacity: root.volume_hud_opacity * 0.55;
            visible: root.volume_hud_opacity > 0.01;
        }

        // Volume HUD overlay (top layer)
        volume_hud := VolumeHudOverlay {
            width: 100%;
            height: 100%;
            visible: root.volume_hud_opacity > 0.01;
            opacity: root.volume_hud_opacity;
            volume_value <=> root.volume_value;
            is_muted <=> root.is_muted;
            volume_changed(val) => { root.volume_changed(val); }
            toggle_mute => { root.toggle_mute(); }
            dismiss_requested => { root.dismiss_volume_hud(); }
            interaction_activity => { root.show_volume_hud(); }
        }
    }
}
