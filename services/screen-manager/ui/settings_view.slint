import { Theme } from "theme.slint";

component AppIcon inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    callback clicked();

    width: 120px;
    height: 120px;
    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        // Squircle Icon Card (Android style)
        Rectangle {
            x: (parent.width - self.width) / 2;
            width: 76px;
            height: 76px;
            border-radius: 22px;
            background: Theme.active.card_surface;
            border-width: 1px;
            border-color: Theme.active.card_border;

            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: root.icon;
                colorize: Theme.active.primary_accent;
                width: 38px;
                height: 38px;
                image-fit: contain;
            }
        }

        // App Label (1 size bigger)
        Text {
            text: root.label;
            color: Theme.active.text_primary;
            font-size: 18px;
            font-weight: 700;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    opacity: touch.pressed ? 0.7 : 1.0;
    animate opacity { duration: 80ms; easing: ease-out; }
}

export component SettingsView inherits VerticalLayout {
    in property <bool> cd_enabled: false;
    in-out property <bool> show_themes: false;

    callback back_clicked();
    callback bluetooth_clicked();
    callback vu_meter_clicked();
    callback dsp_clicked();
    callback cd_clicked();
    callback select_theme(int);
    callback cycle_theme();

    padding: 14px;
    spacing: 16px;

    // Header: Title & Back Button
    HorizontalLayout {
        height: 40px;
        spacing: 12px;

        Text {
            text: root.show_themes ? "THEME PREFERENCES" : "SETTINGS";
            color: Theme.active.primary_accent;
            font-size: 18px;
            font-weight: 800;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Rectangle {
            width: 120px;
            height: 42px;
            background: Theme.active.primary_accent;
            border-radius: 12px;

            Text {
                text: "Back";
                color: Theme.active.dock_active_text;
                font-size: 18px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => {
                    if (root.show_themes) {
                        root.show_themes = false;
                    } else {
                        root.back_clicked();
                    }
                }
            }
        }
    }

    // View 1: Android-style Apps Grid of Icons
    if !root.show_themes : VerticalLayout {
        vertical-stretch: 1;
        alignment: center;

        HorizontalLayout {
            alignment: center;
            spacing: 24px;

            AppIcon {
                icon: @image-url("../../../assets/icons/bluetooth.svg");
                label: "Bluetooth";
                clicked => { root.bluetooth_clicked(); }
            }

            AppIcon {
                icon: @image-url("../../../assets/icons/peppymeter.svg");
                label: "VU Meter";
                clicked => { root.vu_meter_clicked(); }
            }

            AppIcon {
                icon: @image-url("../../../assets/icons/equalizer.svg");
                label: "DSP & EQ";
                clicked => { root.dsp_clicked(); }
            }

            AppIcon {
                icon: @image-url("../../../assets/icons/config.svg");
                label: "Themes";
                clicked => { root.show_themes = true; }
            }

            if root.cd_enabled : AppIcon {
                icon: @image-url("../../../assets/icons/disk.svg");
                label: "CD Player";
                clicked => { root.cd_clicked(); }
            }
        }
    }

    // View 2: Theme Preferences Screen (opened via Themes app icon)
    if root.show_themes : Rectangle {
        background: Theme.active.card_surface;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.active.card_border;
        vertical-stretch: 1;

        VerticalLayout {
            alignment: space-around;
            padding: 16px;
            spacing: 12px;

            Text {
                text: "Select Global Appliance Palette:";
                color: Theme.active.secondary_accent;
                font-size: 14px;
                font-weight: 800;
                horizontal-alignment: center;
            }

            // 5 Theme preset buttons
            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                // 1. McIntosh Blue
                Rectangle {
                    width: 136px;
                    height: 54px;
                    background: #090D12;
                    border-radius: 10px;
                    border-width: Theme.active_preset == 0 ? 2px : 1px;
                    border-color: #00C8FF;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "1. McIntosh";
                            color: #00C8FF;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Electric Cyan";
                            color: #70E1FF;
                            font-size: 10px;
                            horizontal-alignment: center;
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.select_theme(0);
                        }
                    }
                }

                // 2. Marantz Amber
                Rectangle {
                    width: 136px;
                    height: 54px;
                    background: #12100D;
                    border-radius: 10px;
                    border-width: Theme.active_preset == 1 ? 2px : 1px;
                    border-color: #E5A93C;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "2. Marantz";
                            color: #E5A93C;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Warm Amber";
                            color: #FFD166;
                            font-size: 10px;
                            horizontal-alignment: center;
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.select_theme(1);
                        }
                    }
                }

                // 3. Cyberpunk Neon
                Rectangle {
                    width: 136px;
                    height: 54px;
                    background: #0D0B18;
                    border-radius: 10px;
                    border-width: Theme.active_preset == 2 ? 2px : 1px;
                    border-color: #00F0FF;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "3. Cyberpunk";
                            color: #00F0FF;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Synthwave Pink";
                            color: #FF007F;
                            font-size: 10px;
                            horizontal-alignment: center;
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.select_theme(2);
                        }
                    }
                }

                // 4. Studio Dark
                Rectangle {
                    width: 136px;
                    height: 54px;
                    background: #121212;
                    border-radius: 10px;
                    border-width: Theme.active_preset == 3 ? 2px : 1px;
                    border-color: #F0F0F0;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "4. Studio Dark";
                            color: #F0F0F0;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Precision Mono";
                            color: #A0A0A0;
                            font-size: 10px;
                            horizontal-alignment: center;
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.select_theme(3);
                        }
                    }
                }

                // 5. PeppyMeter Gold
                Rectangle {
                    width: 136px;
                    height: 54px;
                    background: #14110D;
                    border-radius: 10px;
                    border-width: Theme.active_preset == 4 ? 2px : 1px;
                    border-color: #F5B83D;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "5. PeppyMeter";
                            color: #F5B83D;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Vintage Gold";
                            color: #FFDF85;
                            font-size: 10px;
                            horizontal-alignment: center;
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.select_theme(4);
                        }
                    }
                }
            }

            // Cycle Theme Button
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 220px;
                    height: 40px;
                    background: Theme.active.primary_accent;
                    border-radius: 10px;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;

                        Text {
                            text: "Cycle Next Theme";
                            color: Theme.active.dock_active_text;
                            font-size: 13px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.cycle_theme();
                        }
                    }
                }
            }
        }
    }
}
