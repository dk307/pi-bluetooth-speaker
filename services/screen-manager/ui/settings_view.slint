import {
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
    ScrollView,
    TouchScale,
} from "@material/material.slint";
import { AppTheme } from "app_theme.slint";
import { FontSizeControl, TouchScaleShowcase } from "touch_scale_widgets.slint";

export enum SettingControlKind {
    stepper,
    two_option,
    selector,
}

export struct SettingRowItem {
    id: string,
    label: string,
    is_advanced: bool,
    kind: SettingControlKind,
    value_text: string,
    can_decrease: bool,
    can_increase: bool,
    left_label: string,
    right_label: string,
    right_selected: bool,
}

// Compact +/− button used by the Advanced settings rows (Material 3 tonal
// icon-button look; scales with `MaterialStyleMetrics.size_40`).
// Uses real Material SVG icons so −/+ glyphs align.
component StepButton inherits Rectangle {
    in property <bool> plus;
    in property <bool> enabled: true;
    callback clicked;

    width: MaterialStyleMetrics.size_40;
    height: MaterialStyleMetrics.size_40;
    border-radius: self.width / 2;
    background: root.enabled ? MaterialPalette.secondary_container : MaterialPalette.surface_container_highest;
    opacity: root.enabled && touch.pressed ? 0.8 : root.enabled ? 1.0 : 0.6;
    animate opacity { duration: 80ms; easing: ease-out; }

    // "−" (remove) icon: always shown; canonical 24dp M3 icon.
    Image {
        source: @image-url("../../../assets/icons/remove.svg");
        colorize: root.enabled ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
        width: MaterialStyleMetrics.icon_size_18;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
    }

    // "+" icon: only shown when plus is true; canonical 24dp M3 icon.
    if root.plus : Image {
        source: @image-url("../../../assets/icons/add.svg");
        colorize: root.enabled ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
        width: MaterialStyleMetrics.icon_size_18;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// One Material 3 list row for a numeric Advanced setting: label text on the
// left, a −/+ stepper control on the right.
// The value column has a fixed scaled width (`96px * TouchScale.widget_scale`)
// so all −/+ buttons stay vertically aligned regardless of label width.
component SettingsStepperRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> can_decrease: true;
    in property <bool> can_increase: true;
    callback decrease();
    callback increase();

    min-height: max(MaterialStyleMetrics.size_40, row_layout.min-height);

    row_layout := HorizontalLayout {
        spacing: MaterialStyleMetrics.spacing_8;

        MaterialText {
            text: root.label;
            style: MaterialTypography.body_large;
            color: MaterialPalette.on_surface;
            vertical-alignment: center;
            horizontal-alignment: left;
            overflow: elide;
            wrap: no-wrap;
            horizontal-stretch: 1;
        }

        StepButton {
            plus: false;
            enabled: root.can_decrease;
            clicked => { root.decrease(); }
        }

        MaterialText {
            text: root.value;
            style: MaterialTypography.title_medium;
            color: MaterialPalette.primary;
            vertical-alignment: center;
            horizontal-alignment: center;
            width: 96px * TouchScale.widget_scale;
            overflow: elide;
            wrap: no-wrap;
        }

        StepButton {
            plus: true;
            enabled: root.can_increase;
            clicked => { root.increase(); }
        }
    }
}

// Cyclic `<` / `>` selector row for multi-option settings.
component SettingsSelectorRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback prev();
    callback next();

    min-height: max(MaterialStyleMetrics.size_40, row_layout.min-height);

    row_layout := HorizontalLayout {
        spacing: MaterialStyleMetrics.spacing_8;

        MaterialText {
            text: root.label;
            style: MaterialTypography.body_large;
            color: MaterialPalette.on_surface;
            vertical-alignment: center;
            horizontal-alignment: left;
            overflow: elide;
            wrap: no-wrap;
            horizontal-stretch: 1;
        }

        Rectangle {
            width: MaterialStyleMetrics.size_40;
            height: MaterialStyleMetrics.size_40;
            border-radius: self.width / 2;
            background: MaterialPalette.secondary_container;
            opacity: prev_touch.pressed ? 0.8 : 1.0;
            animate opacity { duration: 80ms; easing: ease-out; }

            Image {
                source: @image-url("material/ui/icons/chevron_backward.svg");
                colorize: MaterialPalette.on_secondary_container;
                width: MaterialStyleMetrics.icon_size_18;
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
            }

            prev_touch := TouchArea {
                clicked => { root.prev(); }
            }
        }

        MaterialText {
            text: root.value;
            style: MaterialTypography.title_medium;
            color: MaterialPalette.primary;
            vertical-alignment: center;
            horizontal-alignment: center;
            width: 140px * TouchScale.widget_scale;
            overflow: elide;
            wrap: no-wrap;
        }

        Rectangle {
            width: MaterialStyleMetrics.size_40;
            height: MaterialStyleMetrics.size_40;
            border-radius: self.width / 2;
            background: MaterialPalette.secondary_container;
            opacity: next_touch.pressed ? 0.8 : 1.0;
            animate opacity { duration: 80ms; easing: ease-out; }

            Image {
                source: @image-url("material/ui/icons/chevron_forward.svg");
                colorize: MaterialPalette.on_secondary_container;
                width: MaterialStyleMetrics.icon_size_18;
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
            }

            next_touch := TouchArea {
                clicked => { root.next(); }
            }
        }
    }
}

// Material 3 two-option segmented control: one outlined pill, selected segment
// filled with `secondary_container`. Used for binary catalog settings.
component TwoOptionSegmented inherits Rectangle {
    in property <string> left_label;
    in property <string> right_label;
    in property <bool> right_selected;
    callback select_right(bool);

    width: 168px * TouchScale.widget_scale;
    height: MaterialStyleMetrics.size_36;
    border-width: 1px;
    border-radius: self.height / 2;
    border-color: MaterialPalette.outline;

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            horizontal-stretch: 1;
            background: !root.right_selected ? MaterialPalette.secondary_container : transparent;

            MaterialText {
                text: root.left_label;
                style: MaterialTypography.label_large;
                color: !root.right_selected ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: no-wrap;
            }

            TouchArea {
                clicked => { root.select_right(false); }
            }
        }

        Rectangle {
            width: 1px;
            background: MaterialPalette.outline;
        }

        Rectangle {
            horizontal-stretch: 1;
            background: root.right_selected ? MaterialPalette.secondary_container : transparent;

            MaterialText {
                text: root.right_label;
                style: MaterialTypography.label_large;
                color: root.right_selected ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: no-wrap;
            }

            TouchArea {
                clicked => { root.select_right(true); }
            }
        }
    }
}

// Advanced list row pairing a setting label with a two-option segmented
// control on the right.
component TwoOptionSegmentedRow inherits Rectangle {
    in property <string> label;
    in property <string> left_label;
    in property <string> right_label;
    in property <bool> right_selected;
    callback select_right(bool);

    min-height: max(MaterialStyleMetrics.size_40, row_layout.min-height);

    row_layout := HorizontalLayout {
        spacing: MaterialStyleMetrics.spacing_8;

        MaterialText {
            text: root.label;
            style: MaterialTypography.body_large;
            color: MaterialPalette.on_surface;
            vertical-alignment: center;
            horizontal-alignment: left;
            overflow: elide;
            wrap: no-wrap;
            horizontal-stretch: 1;
        }

        TwoOptionSegmented {
            left_label: root.left_label;
            right_label: root.right_label;
            right_selected: root.right_selected;
            select_right(is_right) => { root.select_right(is_right); }
        }
    }
}

// Theme preset card: swatch-colored border marks the active preset.
component ThemePresetCard inherits Rectangle {
    in property <string> name;
    in property <string> accent_name;
    in property <color> primary_color;
    in property <color> secondary_color;
    in property <bool> selected;
    callback clicked();

    horizontal-stretch: 1;
    min-width: 118px;
    min-height: max(56px * TouchScale.widget_scale, card_layout.min-height);
    border-radius: MaterialStyleMetrics.border_radius_10;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? root.primary_color : MaterialPalette.outline_variant;
    background: root.selected ? transparent : MaterialPalette.surface;
    opacity: touch.pressed ? 0.8 : 1.0;
    animate opacity { duration: 80ms; easing: ease-out; }

    card_layout := VerticalLayout {
        alignment: center;
        padding-left: MaterialStyleMetrics.padding_6;
        padding-right: MaterialStyleMetrics.padding_6;
        padding-top: MaterialStyleMetrics.padding_6;
        padding-bottom: MaterialStyleMetrics.padding_6;
        spacing: MaterialStyleMetrics.spacing_2;

        MaterialText {
            text: root.name;
            style: MaterialTypography.label_large;
            color: root.primary_color;
            horizontal-alignment: center;
            overflow: elide;
            wrap: no-wrap;
        }
        MaterialText {
            text: root.accent_name;
            style: MaterialTypography.label_small;
            color: root.secondary_color;
            horizontal-alignment: center;
            overflow: elide;
            wrap: no-wrap;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Android-style icon button for settings grid, scaled by `TouchScale.widget_scale`.
component SettingsIconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;

    width: 120px * TouchScale.widget_scale;
    min-height: max(120px * TouchScale.widget_scale, btn_layout.min-height);
    border-radius: MaterialStyleMetrics.border_radius_16;
    background: root.enabled ? MaterialPalette.secondary_container : MaterialPalette.surface_container_highest;
    opacity: root.enabled ? (touch.pressed ? 0.8 : 1.0) : 0.6;
    animate opacity { duration: 80ms; easing: ease-out; }

    // Off-layout single-line probe so `is_multiline` depends only on `root.width`
    // and `root.label` without creating a layout binding loop.
    label_probe := Text {
        x: 0;
        y: 0;
        visible: false;
        text: root.label;
        font-size: MaterialTypography.title_medium.font_size;
        font-weight: MaterialTypography.title_medium.font_weight;
        wrap: no-wrap;
    }

    property <bool> is_multiline: label_probe.preferred-width > root.width - 2 * MaterialStyleMetrics.padding_8;

    btn_layout := VerticalLayout {
        alignment: center;
        padding: MaterialStyleMetrics.padding_8;
        spacing: root.is_multiline ? MaterialStyleMetrics.spacing_8 : MaterialStyleMetrics.spacing_12;

        HorizontalLayout {
            alignment: center;
            Image {
                source: root.icon;
                colorize: root.enabled ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                width: root.is_multiline ? 32px * TouchScale.widget_scale : MaterialStyleMetrics.icon_size_36;
                height: self.width;
                image-fit: contain;
            }
        }

        label_text := MaterialText {
            text: root.label;
            style: MaterialTypography.title_medium;
            color: root.enabled ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
            horizontal-alignment: center;
            overflow: elide;
            wrap: word-wrap;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    callback clicked();
}

// Generic setting row that renders either a stepper or a two-option segmented
// control from a `SettingRowItem` descriptor.
component GenericSettingRow inherits VerticalLayout {
    in property <SettingRowItem> item;
    callback setting_step(string, int);
    callback setting_toggle(string, bool);

    if root.item.kind == SettingControlKind.stepper : SettingsStepperRow {
        label: root.item.label;
        value: root.item.value_text;
        can_decrease: root.item.can_decrease;
        can_increase: root.item.can_increase;
        decrease => { root.setting_step(root.item.id, -1); }
        increase => { root.setting_step(root.item.id, 1); }
    }

    if root.item.kind == SettingControlKind.two_option : TwoOptionSegmentedRow {
        label: root.item.label;
        left_label: root.item.left_label;
        right_label: root.item.right_label;
        right_selected: root.item.right_selected;
        select_right(is_right) => { root.setting_toggle(root.item.id, is_right); }
    }

    if root.item.kind == SettingControlKind.selector : SettingsSelectorRow {
        label: root.item.label;
        value: root.item.value_text;
        prev => { root.setting_step(root.item.id, -1); }
        next => { root.setting_step(root.item.id, 1); }
    }
}

export component SettingsView inherits VerticalLayout {
    in property <bool> cd_enabled: false;
    in-out property <bool> show_themes: false;
    in-out property <bool> show_visualizer: false;
    in-out property <bool> show_advanced: false;
    in-out property <bool> show_widget_preview: false;
    in-out property <string> speaker_alias: "DietPi Speaker";
    in property <[SettingRowItem]> basic_settings;
    in property <[SettingRowItem]> visualizer_settings;
    in property <[SettingRowItem]> advanced_settings;

    callback bluetooth_clicked();
    callback vu_meter_clicked();
    callback dsp_clicked();
    callback cd_clicked();
    callback select_theme(int);
    callback cycle_theme();
    callback font_scale_changed(float);
    callback setting_step(string, int);
    callback setting_toggle(string, bool);

    padding: root.show_widget_preview ? 0px : MaterialStyleMetrics.padding_12;
    spacing: MaterialStyleMetrics.spacing_6;

    // View 1: Android-style icon button grid
    if !root.show_themes : VerticalLayout {
        vertical-stretch: 1;
        alignment: center;

        HorizontalLayout {
            alignment: center;
            spacing: MaterialStyleMetrics.spacing_16;

            SettingsIconButton {
                icon: @image-url("../../../assets/icons/bluetooth.svg");
                label: "Bluetooth";
                clicked => { root.bluetooth_clicked(); }
            }

            SettingsIconButton {
                icon: @image-url("../../../assets/icons/peppymeter.svg");
                label: "VU Meter";
                clicked => { root.vu_meter_clicked(); }
            }

            SettingsIconButton {
                icon: @image-url("../../../assets/icons/equalizer.svg");
                label: "DSP & EQ";
                clicked => { root.dsp_clicked(); }
            }

            SettingsIconButton {
                icon: @image-url("../../../assets/icons/config.svg");
                label: "Screen Settings";
                clicked => { root.show_themes = true; }
            }

            if root.cd_enabled : SettingsIconButton {
                icon: @image-url("../../../assets/icons/disk.svg");
                label: "CD Player";
                clicked => { root.cd_clicked(); }
            }
        }
    }

    // View 2: Screen Settings — Appearance (Theme presets + Text Size) + Basic
    // catalog rows + entry points for Visualizer and Advanced sub-screens.
    if root.show_themes && !root.show_advanced && !root.show_visualizer && !root.show_widget_preview : VerticalLayout {
        vertical-stretch: 1;
        spacing: MaterialStyleMetrics.spacing_8;

        // Section 1: Theme presets + Text Size (non-advanced appearance settings)
            HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_8;

                ThemePresetCard {
                    name: "McIntosh";
                    accent_name: "Electric Cyan";
                    primary_color: #00C8FF;
                    secondary_color: #70E1FF;
                    selected: AppTheme.active_preset == 0;
                    clicked => { root.select_theme(0); }
                }

                ThemePresetCard {
                    name: "Marantz";
                    accent_name: "Warm Amber";
                    primary_color: #E5A93C;
                    secondary_color: #FFD166;
                    selected: AppTheme.active_preset == 1;
                    clicked => { root.select_theme(1); }
                }

                ThemePresetCard {
                    name: "Cyberpunk";
                    accent_name: "Synthwave Pink";
                    primary_color: #00F0FF;
                    secondary_color: #FF007F;
                    selected: AppTheme.active_preset == 2;
                    clicked => { root.select_theme(2); }
                }

                ThemePresetCard {
                    name: "Studio Dark";
                    accent_name: "Precision Mono";
                    primary_color: #F0F0F0;
                    secondary_color: #A0A0A0;
                    selected: AppTheme.active_preset == 3;
                    clicked => { root.select_theme(3); }
                }

                ThemePresetCard {
                    name: "PeppyMeter";
                    accent_name: "Vintage Gold";
                    primary_color: #F5B83D;
                    secondary_color: #FFDF85;
                    selected: AppTheme.active_preset == 4;
                    clicked => { root.select_theme(4); }
                }
            }

            // Text Size ("A — Slider — A") setting, live-persisted to config.json.
            FontSizeControl {
                font_scale_changed(val) => { root.font_scale_changed(val); }
            }

            // Basic catalog-driven rows (tier == Basic).
            for item in root.basic_settings : GenericSettingRow {
                item: item;
                setting_step(id, dir) => { root.setting_step(id, dir); }
                setting_toggle(id, right) => { root.setting_toggle(id, right); }
            }

            // Section divider (M3: one divider between groups, none between rows).
            Rectangle {
                height: 1px;
                background: MaterialPalette.outline_variant;
            }

            // Explicit entry point to the Visualizer Settings sub-screen.
            Rectangle {
                min-height: max(MaterialStyleMetrics.size_48, viz_row_layout.min-height);
                border-radius: MaterialStyleMetrics.border_radius_10;
                background: MaterialPalette.surface_container_high;
                opacity: viz_touch.pressed ? 0.8 : 1.0;
                animate opacity { duration: 80ms; easing: ease-out; }

                viz_row_layout := HorizontalLayout {
                    padding-left: MaterialStyleMetrics.padding_12;
                    padding-right: MaterialStyleMetrics.padding_12;
                    padding-top: MaterialStyleMetrics.padding_8;
                    padding-bottom: MaterialStyleMetrics.padding_8;
                    spacing: MaterialStyleMetrics.spacing_8;

                    MaterialText {
                        text: "Visualizer";
                        style: MaterialTypography.title_medium;
                        color: MaterialPalette.on_surface;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Image {
                        source: @image-url("material/ui/icons/chevron_forward.svg");
                        colorize: MaterialPalette.on_surface_variant;
                        width: MaterialStyleMetrics.icon_size_24;
                        height: self.width;
                        image-fit: contain;
                        y: (parent.height - self.height) / 2;
                    }
                }

                viz_touch := TouchArea {
                    clicked => { root.show_visualizer = true; }
                }
            }

            // Explicit entry point to the Advanced Settings sub-screen.
            Rectangle {
                min-height: max(MaterialStyleMetrics.size_48, adv_row_layout.min-height);
                border-radius: MaterialStyleMetrics.border_radius_10;
                background: MaterialPalette.surface_container_high;
                opacity: adv_touch.pressed ? 0.8 : 1.0;
                animate opacity { duration: 80ms; easing: ease-out; }

                adv_row_layout := HorizontalLayout {
                    padding-left: MaterialStyleMetrics.padding_12;
                    padding-right: MaterialStyleMetrics.padding_12;
                    padding-top: MaterialStyleMetrics.padding_8;
                    padding-bottom: MaterialStyleMetrics.padding_8;
                    spacing: MaterialStyleMetrics.spacing_8;

                    MaterialText {
                        text: "Advanced";
                        style: MaterialTypography.title_medium;
                        color: MaterialPalette.on_surface;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Image {
                        source: @image-url("material/ui/icons/chevron_forward.svg");
                        colorize: MaterialPalette.on_surface_variant;
                        width: MaterialStyleMetrics.icon_size_24;
                        height: self.width;
                        image-fit: contain;
                        y: (parent.height - self.height) / 2;
                    }
                }

                adv_touch := TouchArea {
                    clicked => { root.show_advanced = true; }
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }
    }

    // View 2c: Dedicated Visualizer Settings sub-screen (catalog rows where tier == Visualizer).
    if root.show_themes && root.show_visualizer && !root.show_advanced && !root.show_widget_preview : VerticalLayout {
        vertical-stretch: 1;
        spacing: MaterialStyleMetrics.spacing_8;

        for item in root.visualizer_settings : GenericSettingRow {
            item: item;
            setting_step(id, dir) => { root.setting_step(id, dir); }
            setting_toggle(id, right) => { root.setting_toggle(id, right); }
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }

    // View 2b: Dedicated scrollable Advanced Settings sub-screen (catalog rows where tier == Advanced).
    if root.show_themes && root.show_advanced && !root.show_widget_preview : advanced_scroll := ScrollView {
        vertical-stretch: 1;
        horizontal_scrollbar_policy: ScrollBarPolicy.always_off;
        content_width: advanced_scroll.visible_width;
        content_height: advanced_list.min-height;

        advanced_list := VerticalLayout {
            width: advanced_scroll.visible_width;
            height: max(advanced_scroll.visible_height, self.min-height);
            padding-right: MaterialStyleMetrics.padding_4;
            spacing: MaterialStyleMetrics.spacing_8;

            for item in root.advanced_settings : GenericSettingRow {
                item: item;
                setting_step(id, dir) => { root.setting_step(id, dir); }
                setting_toggle(id, right) => { root.setting_toggle(id, right); }
            }

            Rectangle {
                vertical-stretch: 1;
            }
        }
    }

    // View 3: 800x480 Widget Scale Audit & Interactive Showcase
    if root.show_themes && root.show_widget_preview : TouchScaleShowcase {
        vertical-stretch: 1;
        speaker_alias <=> root.speaker_alias;
        font_scale_changed(val) => {
            root.font_scale_changed(val);
        }
    }
}
