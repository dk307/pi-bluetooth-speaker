import { ElevatedCard, OutlinedCard, FilledButton, Icon, MaterialText, Horizontal, Vertical } from "@material/material.slint";
import { MaterialPalette } from "@material/material.slint";
import { MaterialTypography } from "@material/material.slint";
import { MaterialStyleMetrics } from "@material/material.slint";
import { AppTheme } from "app_theme.slint";

// Theme preset card using Rectangle with Material styling (defined first for use in SettingsView)
component ThemePresetCard inherits Rectangle {
    in property <int> index;
    in property <string> name;
    in property <string> accent_name;
    in property <color> primary_color;
    in property <color> secondary_color;
    in property <bool> selected;
    callback clicked();

    width: 136px;
    height: 54px;
    border-radius: MaterialStyleMetrics.border_radius_10;
    border-width: root.selected ? 2px : 0px;
    border-color: root.primary_color;
    background: root.selected ? transparent : MaterialPalette.surface;

    VerticalLayout {
        alignment: center;
        spacing: MaterialStyleMetrics.spacing_2;

        MaterialText {
            text: root.name;
            style: MaterialTypography.label_medium;  // 12px
            color: root.primary_color;
            horizontal-alignment: center;
        }
        MaterialText {
            text: root.accent_name;
            style: MaterialTypography.label_small;  // 11px
            color: root.secondary_color;
            horizontal-alignment: center;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

// Android-style icon button for settings grid (custom component like TransportButton)
component SettingsIconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;

    width: 120px;
    height: 120px;
    border-radius: MaterialStyleMetrics.border_radius_16;  // 16px rounded
    background: root.enabled ? MaterialPalette.secondary_container : MaterialPalette.surface_container_highest;
    opacity: root.enabled ? (touch.pressed ? 0.8 : 1.0) : 0.6;
    animate opacity { duration: 80ms; easing: ease-out; }

    VerticalLayout {
        alignment: center;
        spacing: MaterialStyleMetrics.spacing_12;

        HorizontalLayout {
            alignment: center;
            Image {
                source: root.icon;
                colorize: root.enabled ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                width: MaterialStyleMetrics.icon_size_36;  // 48px
                height: MaterialStyleMetrics.icon_size_36;
                image-fit: contain;
            }
        }

        MaterialText {
            text: root.label;
            style: MaterialTypography.title_medium;  // 16px (+1 from title_small)
            color: root.enabled ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    callback clicked();
}

export component SettingsView inherits VerticalLayout {
    in property <bool> cd_enabled: false;
    in-out property <bool> show_themes: false;

    callback back_clicked();
    callback bluetooth_clicked();
    callback vu_meter_clicked();
    callback dsp_clicked();
    callback cd_clicked();
    callback select_theme(int);
    callback cycle_theme();

    padding: MaterialStyleMetrics.padding_16;  // 16px
    spacing: MaterialStyleMetrics.spacing_16;

    // View 1: Android-style icon button grid
    if !root.show_themes : VerticalLayout {
        vertical-stretch: 1;
        alignment: center;

        HorizontalLayout {
            alignment: center;
            spacing: MaterialStyleMetrics.spacing_16;

            SettingsIconButton {
                icon: @image-url("../../../assets/icons/bluetooth.svg");
                label: "Bluetooth";
                clicked => { root.bluetooth_clicked(); }
            }

            SettingsIconButton {
                icon: @image-url("../../../assets/icons/peppymeter.svg");
                label: "VU Meter";
                clicked => { root.vu_meter_clicked(); }
            }

            SettingsIconButton {
                icon: @image-url("../../../assets/icons/equalizer.svg");
                label: "DSP & EQ";
                clicked => { root.dsp_clicked(); }
            }

            SettingsIconButton {
                icon: @image-url("../../../assets/icons/config.svg");
                label: "Themes";
                clicked => { root.show_themes = true; }
            }

            if root.cd_enabled : SettingsIconButton {
                icon: @image-url("../../../assets/icons/disk.svg");
                label: "CD Player";
                clicked => { root.cd_clicked(); }
            }
        }
    }

    // View 2: Theme Preferences Screen
    if root.show_themes : OutlinedCard {
        VerticalLayout {
            alignment: space-around;
            padding: MaterialStyleMetrics.padding_16;
            spacing: MaterialStyleMetrics.spacing_12;

            MaterialText {
                text: "Select Global Appliance Palette:";
                style: MaterialTypography.label_large;  // 14px
                color: MaterialPalette.on_surface_variant;
                horizontal-alignment: center;
            }

            // 5 Theme preset buttons
            HorizontalLayout {
                alignment: center;
                spacing: MaterialStyleMetrics.spacing_8;

                // 1. McIntosh Blue
                ThemePresetCard {
                    index: 0;
                    name: "1. McIntosh";
                    accent_name: "Electric Cyan";
                    primary_color: #00C8FF;
                    secondary_color: #70E1FF;
                    selected: AppTheme.active_preset == 0;
                    clicked => { root.select_theme(0); }
                }

                // 2. Marantz Amber
                ThemePresetCard {
                    index: 1;
                    name: "2. Marantz";
                    accent_name: "Warm Amber";
                    primary_color: #E5A93C;
                    secondary_color: #FFD166;
                    selected: AppTheme.active_preset == 1;
                    clicked => { root.select_theme(1); }
                }

                // 3. Cyberpunk Neon
                ThemePresetCard {
                    index: 2;
                    name: "3. Cyberpunk";
                    accent_name: "Synthwave Pink";
                    primary_color: #00F0FF;
                    secondary_color: #FF007F;
                    selected: AppTheme.active_preset == 2;
                    clicked => { root.select_theme(2); }
                }

                // 4. Studio Dark
                ThemePresetCard {
                    index: 3;
                    name: "4. Studio Dark";
                    accent_name: "Precision Mono";
                    primary_color: #F0F0F0;
                    secondary_color: #A0A0A0;
                    selected: AppTheme.active_preset == 3;
                    clicked => { root.select_theme(3); }
                }

                // 5. PeppyMeter Gold
                ThemePresetCard {
                    index: 4;
                    name: "5. PeppyMeter";
                    accent_name: "Vintage Gold";
                    primary_color: #F5B83D;
                    secondary_color: #FFDF85;
                    selected: AppTheme.active_preset == 4;
                    clicked => { root.select_theme(4); }
                }
            }

            // Cycle Theme Button
            HorizontalLayout {
                alignment: center;
                FilledButton {
                    text: "Cycle Next Theme";
                    width: 220px;
                    height: 48px;
                    clicked => { root.cycle_theme(); }
                }
            }
        }
    }
}