import { ElevatedCard, OutlinedCard, FilledButton, Icon, MaterialText, Horizontal, Vertical } from "@material/material.slint";
import { MaterialPalette } from "@material/material.slint";
import { MaterialTypography } from "@material/material.slint";
import { MaterialStyleMetrics } from "@material/material.slint";
import { AppTheme } from "app_theme.slint";
import { MarqueeCompose } from "marquee_state.slint";

// Compact +/− button used by every numeric Screen Settings row.
component StepButton inherits Rectangle {
    in property <string> symbol;
    callback clicked();

    width: 40px;
    height: 40px;
    border-radius: MaterialStyleMetrics.border_radius_10;
    background: MaterialPalette.secondary_container;
    opacity: touch.pressed ? 0.8 : 1.0;
    animate opacity { duration: 80ms; easing: ease-out; }

    Text {
        text: root.symbol;
        font-size: 20px;
        font-weight: 700;
        color: MaterialPalette.on_secondary_container;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// One label / value / +/- line in the numeric settings card.
component SettingsStepper inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    callback decrease();
    callback increase();

    spacing: 8px;

    Rectangle {
        horizontal-stretch: 3;
        height: 40px;
        border-radius: MaterialStyleMetrics.border_radius_10;
        background: MaterialPalette.surface_container_lowest;

        Text {
            text: root.label;
            font-size: 13px;
            font-weight: 600;
            color: MaterialPalette.on_surface;
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    Rectangle {
        horizontal-stretch: 2;
        height: 40px;
        border-radius: MaterialStyleMetrics.border_radius_10;
        background: MaterialPalette.surface_container_high;

        Text {
            text: root.value;
            font-size: 14px;
            font-weight: 700;
            color: MaterialPalette.primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    StepButton {
        symbol: "−";
        clicked => { root.decrease(); }
    }

    StepButton {
        symbol: "+";
        clicked => { root.increase(); }
    }
}

// Compact selectable option card used for the two allowed marquee rates.
component ChoiceCard inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    horizontal-stretch: 1;
    height: 40px;
    border-radius: MaterialStyleMetrics.border_radius_10;
    border-width: root.selected ? 2px : 0px;
    border-color: MaterialPalette.primary;
    background: root.selected ? MaterialPalette.primary_container : MaterialPalette.surface_container_lowest;
    opacity: touch.pressed ? 0.8 : 1.0;
    animate opacity { duration: 80ms; easing: ease-out; }

    Text {
        text: root.label;
        font-size: 13px;
        font-weight: 700;
        color: root.selected ? MaterialPalette.on_primary_container : MaterialPalette.on_surface;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Theme preset card using Rectangle with Material styling (defined first for use in SettingsView)
component ThemePresetCard inherits Rectangle {
    in property <int> index;
    in property <string> name;
    in property <string> accent_name;
    in property <color> primary_color;
    in property <color> secondary_color;
    in property <bool> selected;
    callback clicked();

    width: 136px;
    height: 54px;
    border-radius: MaterialStyleMetrics.border_radius_10;
    border-width: root.selected ? 2px : 0px;
    border-color: root.primary_color;
    background: root.selected ? transparent : MaterialPalette.surface;

    VerticalLayout {
        alignment: center;
        spacing: MaterialStyleMetrics.spacing_2;

        MaterialText {
            text: root.name;
            style: MaterialTypography.label_medium;  // 12px
            color: root.primary_color;
            horizontal-alignment: center;
        }
        MaterialText {
            text: root.accent_name;
            style: MaterialTypography.label_small;  // 11px
            color: root.secondary_color;
            horizontal-alignment: center;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

// Android-style icon button for settings grid (custom component like TransportButton)
component SettingsIconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;

    width: 120px;
    height: 120px;
    border-radius: MaterialStyleMetrics.border_radius_16;  // 16px rounded
    background: root.enabled ? MaterialPalette.secondary_container : MaterialPalette.surface_container_highest;
    opacity: root.enabled ? (touch.pressed ? 0.8 : 1.0) : 0.6;
    animate opacity { duration: 80ms; easing: ease-out; }

    VerticalLayout {
        alignment: center;
        spacing: MaterialStyleMetrics.spacing_12;

        HorizontalLayout {
            alignment: center;
            Image {
                source: root.icon;
                colorize: root.enabled ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                width: MaterialStyleMetrics.icon_size_36;  // 48px
                height: MaterialStyleMetrics.icon_size_36;
                image-fit: contain;
            }
        }

        MaterialText {
            text: root.label;
            style: MaterialTypography.title_medium;  // 16px (+1 from title_small)
            color: root.enabled ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    callback clicked();
}

export component SettingsView inherits VerticalLayout {
    in property <bool> cd_enabled: false;
    in-out property <bool> show_themes: false;
    in property <int> volume_step_percent: 2;
    in property <int> volume_hud_timeout_ms: 4000;
    in property <int> volume_hud_fade_ms: 200;
    in property <int> codec_hud_timeout_ms: 30000;

    callback bluetooth_clicked();
    callback vu_meter_clicked();
    callback dsp_clicked();
    callback cd_clicked();
    callback select_theme(int);
    callback cycle_theme();
    callback set_marquee_fps(int);
    callback set_volume_step_percent(int);
    callback set_volume_hud_timeout_ms(int);
    callback set_volume_hud_fade_ms(int);
    callback set_codec_hud_timeout_ms(int);
    callback save_settings();

    padding: MaterialStyleMetrics.padding_16;  // 16px
    spacing: MaterialStyleMetrics.spacing_8;

    // View 1: Android-style icon button grid
    if !root.show_themes : VerticalLayout {
        vertical-stretch: 1;
        alignment: center;

        HorizontalLayout {
            alignment: center;
            spacing: MaterialStyleMetrics.spacing_16;

            SettingsIconButton {
                icon: @image-url("../../../assets/icons/bluetooth.svg");
                label: "Bluetooth";
                clicked => { root.bluetooth_clicked(); }
            }

            SettingsIconButton {
                icon: @image-url("../../../assets/icons/peppymeter.svg");
                label: "VU Meter";
                clicked => { root.vu_meter_clicked(); }
            }

            SettingsIconButton {
                icon: @image-url("../../../assets/icons/equalizer.svg");
                label: "DSP & EQ";
                clicked => { root.dsp_clicked(); }
            }

            SettingsIconButton {
                icon: @image-url("../../../assets/icons/config.svg");
                label: "Screen Settings";
                clicked => { root.show_themes = true; }
            }

            if root.cd_enabled : SettingsIconButton {
                icon: @image-url("../../../assets/icons/disk.svg");
                label: "CD Player";
                clicked => { root.cd_clicked(); }
            }
        }
    }

    // View 2: Screen Settings (theme, marquee, HUDs, and encoder volume)
    if root.show_themes : OutlinedCard {
        VerticalLayout {
            alignment: space-between;
            padding: MaterialStyleMetrics.padding_12;
            spacing: MaterialStyleMetrics.spacing_6;

            MaterialText {
                text: "Screen Settings";
                style: MaterialTypography.title_medium;  // 16px
                color: MaterialPalette.primary;
                horizontal-alignment: center;
            }

            MaterialText {
                text: "Theme Preset";
                style: MaterialTypography.label_large;  // 14px
                color: MaterialPalette.on_surface_variant;
                horizontal-alignment: center;
            }

            HorizontalLayout {
                alignment: center;
                spacing: MaterialStyleMetrics.spacing_4;

                ThemePresetCard {
                    index: 0;
                    name: "1. McIntosh";
                    accent_name: "Electric Cyan";
                    primary_color: #00C8FF;
                    secondary_color: #70E1FF;
                    selected: AppTheme.active_preset == 0;
                    clicked => { root.select_theme(0); }
                }

                ThemePresetCard {
                    index: 1;
                    name: "2. Marantz";
                    accent_name: "Warm Amber";
                    primary_color: #E5A93C;
                    secondary_color: #FFD166;
                    selected: AppTheme.active_preset == 1;
                    clicked => { root.select_theme(1); }
                }

                ThemePresetCard {
                    index: 2;
                    name: "3. Cyberpunk";
                    accent_name: "Synthwave Pink";
                    primary_color: #00F0FF;
                    secondary_color: #FF007F;
                    selected: AppTheme.active_preset == 2;
                    clicked => { root.select_theme(2); }
                }

                ThemePresetCard {
                    index: 3;
                    name: "4. Studio Dark";
                    accent_name: "Precision Mono";
                    primary_color: #F0F0F0;
                    secondary_color: #A0A0A0;
                    selected: AppTheme.active_preset == 3;
                    clicked => { root.select_theme(3); }
                }

                ThemePresetCard {
                    index: 4;
                    name: "5. PeppyMeter";
                    accent_name: "Vintage Gold";
                    primary_color: #F5B83D;
                    secondary_color: #FFDF85;
                    selected: AppTheme.active_preset == 4;
                    clicked => { root.select_theme(4); }
                }

                StepButton {
                    symbol: "↻";
                    clicked => { root.cycle_theme(); }
                }
            }

            MaterialText {
                text: "Marquee & Encoder";
                style: MaterialTypography.label_large;  // 14px
                color: MaterialPalette.on_surface_variant;
                horizontal-alignment: center;
            }

            HorizontalLayout {
                spacing: MaterialStyleMetrics.spacing_8;

                Rectangle {
                    horizontal-stretch: 3;
                    height: 40px;
                    border-radius: MaterialStyleMetrics.border_radius_10;
                    background: MaterialPalette.surface_container_lowest;

                    Text {
                        text: "Marquee FPS";
                        font-size: 13px;
                        font-weight: 600;
                        color: MaterialPalette.on_surface;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                ChoiceCard {
                    label: "30";
                    selected: MarqueeCompose.marquee_fps == 30;
                    clicked => { root.set_marquee_fps(30); }
                }

                ChoiceCard {
                    label: "60";
                    selected: MarqueeCompose.marquee_fps == 60;
                    clicked => { root.set_marquee_fps(60); }
                }
            }

            SettingsStepper {
                label: "Encoder Volume Step";
                value: "\{root.volume_step_percent} %";
                decrease => { root.set_volume_step_percent(root.volume_step_percent - 1); }
                increase => { root.set_volume_step_percent(root.volume_step_percent + 1); }
            }

            MaterialText {
                text: "Overlay Timings";
                style: MaterialTypography.label_large;  // 14px
                color: MaterialPalette.on_surface_variant;
                horizontal-alignment: center;
            }

            SettingsStepper {
                label: "Volume HUD Timeout";
                value: "\{root.volume_hud_timeout_ms} ms";
                decrease => { root.set_volume_hud_timeout_ms(root.volume_hud_timeout_ms - 250); }
                increase => { root.set_volume_hud_timeout_ms(root.volume_hud_timeout_ms + 250); }
            }

            SettingsStepper {
                label: "Volume HUD Fade";
                value: "\{root.volume_hud_fade_ms} ms";
                decrease => { root.set_volume_hud_fade_ms(root.volume_hud_fade_ms - 100); }
                increase => { root.set_volume_hud_fade_ms(root.volume_hud_fade_ms + 100); }
            }

            SettingsStepper {
                label: "Codec HUD Timeout";
                value: "\{root.codec_hud_timeout_ms} ms";
                decrease => { root.set_codec_hud_timeout_ms(root.codec_hud_timeout_ms - 1000); }
                increase => { root.set_codec_hud_timeout_ms(root.codec_hud_timeout_ms + 1000); }
            }

            HorizontalLayout {
                alignment: center;

                FilledButton {
                    text: "Save Settings";
                    width: 220px;
                    height: 48px;
                    clicked => { root.save_settings(); }
                }
            }
        }
    }
}
