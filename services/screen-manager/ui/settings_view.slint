import {
    MaterialPalette,
    MaterialStyleMetrics,
    MaterialText,
    MaterialTypography,
    TouchScale,
} from "@material/material.slint";
import { AppTheme } from "app_theme.slint";
import { MarqueeCompose } from "marquee_state.slint";
import { FontSizeControl, TouchScaleShowcase } from "touch_scale_widgets.slint";

// Compact +/− button used by the Advanced settings rows (Material 3 tonal
// icon-button look; scales with `MaterialStyleMetrics.size_40`).
// Uses real Material SVG icons so −/+ glyphs align.
component StepButton inherits Rectangle {
    in property <bool> plus;
    in property <bool> enabled: true;
    callback clicked;

    width: MaterialStyleMetrics.size_40;
    height: MaterialStyleMetrics.size_40;
    border-radius: self.width / 2;
    background: root.enabled ? MaterialPalette.secondary_container : MaterialPalette.surface_container_highest;
    opacity: root.enabled && touch.pressed ? 0.8 : root.enabled ? 1.0 : 0.6;
    animate opacity { duration: 80ms; easing: ease-out; }

    // "−" (remove) icon: always shown; canonical 24dp M3 icon.
    Image {
        source: @image-url("../../../assets/icons/remove.svg");
        colorize: root.enabled ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
        width: MaterialStyleMetrics.icon_size_18;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
    }

    // "+" icon: only shown when plus is true; canonical 24dp M3 icon.
    if root.plus : Image {
        source: @image-url("../../../assets/icons/add.svg");
        colorize: root.enabled ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
        width: MaterialStyleMetrics.icon_size_18;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// One Material 3 list row for a numeric Advanced setting: label text on the
// left, a −/+ stepper control on the right.
// The value column has a fixed scaled width (`96px * TouchScale.widget_scale`)
// so all −/+ buttons stay vertically aligned regardless of label width.
component SettingsStepperRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> can_decrease: true;
    in property <bool> can_increase: true;
    callback decrease();
    callback increase();

    min-height: max(MaterialStyleMetrics.size_36, row_layout.min-height);

    row_layout := HorizontalLayout {
        spacing: MaterialStyleMetrics.spacing_8;

        MaterialText {
            text: root.label;
            style: {
                font_size: MaterialTypography.body_large.font_size,
                font_weight: 600,
            };
            color: MaterialPalette.on_surface;
            vertical-alignment: center;
            horizontal-alignment: left;
            overflow: elide;
            wrap: no-wrap;
            horizontal-stretch: 1;
        }

        StepButton {
            plus: false;
            enabled: root.can_decrease;
            clicked => { root.decrease(); }
        }

        MaterialText {
            text: root.value;
            style: {
                font_size: MaterialTypography.body_large.font_size,
                font_weight: 700,
            };
            color: MaterialPalette.primary;
            vertical-alignment: center;
            horizontal-alignment: center;
            width: 96px * TouchScale.widget_scale;
            overflow: elide;
            wrap: no-wrap;
        }

        StepButton {
            plus: true;
            enabled: root.can_increase;
            clicked => { root.increase(); }
        }
    }
}

// Material 3 segmented control for the two allowed marquee rates (30 / 60):
// one outlined pill, selected segment filled with `secondary_container`.
component FpsSegmented inherits Rectangle {
    in property <int> current_fps;
    callback fps_selected(int);

    width: 168px * TouchScale.widget_scale;
    height: MaterialStyleMetrics.size_36;
    border-width: 1px;
    border-radius: self.height / 2;
    border-color: MaterialPalette.outline;

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            horizontal-stretch: 1;
            background: root.current_fps == 30 ? MaterialPalette.secondary_container : transparent;

            MaterialText {
                text: "30";
                style: {
                    font_size: MaterialTypography.label_large.font_size,
                    font_weight: root.current_fps == 30 ? 700 : 600,
                };
                color: root.current_fps == 30 ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: no-wrap;
            }

            TouchArea {
                clicked => { root.fps_selected(30); }
            }
        }

        Rectangle {
            width: 1px;
            background: MaterialPalette.outline;
        }

        Rectangle {
            horizontal-stretch: 1;
            background: root.current_fps == 60 ? MaterialPalette.secondary_container : transparent;

            MaterialText {
                text: "60";
                style: {
                    font_size: MaterialTypography.label_large.font_size,
                    font_weight: root.current_fps == 60 ? 700 : 600,
                };
                color: root.current_fps == 60 ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: no-wrap;
            }

            TouchArea {
                clicked => { root.fps_selected(60); }
            }
        }
    }
}

// Advanced list row pairing the "Marquee FPS" label with the segmented
// 30 / 60 rate selector on the right.
component FpsSegmentedRow inherits Rectangle {
    min-height: max(MaterialStyleMetrics.size_36, row_layout.min-height);
    callback set_marquee_fps(int);

    row_layout := HorizontalLayout {
        spacing: MaterialStyleMetrics.spacing_8;

        MaterialText {
            text: "Marquee FPS";
            style: {
                font_size: MaterialTypography.body_large.font_size,
                font_weight: 600,
            };
            color: MaterialPalette.on_surface;
            vertical-alignment: center;
            horizontal-alignment: left;
            overflow: elide;
            wrap: no-wrap;
            horizontal-stretch: 1;
        }

        FpsSegmented {
            current_fps: MarqueeCompose.marquee_fps;
            fps_selected(fps) => { root.set_marquee_fps(fps); }
        }
    }
}

// Theme preset card: swatch-colored border marks the active preset.
component ThemePresetCard inherits Rectangle {
    in property <string> name;
    in property <string> accent_name;
    in property <color> primary_color;
    in property <color> secondary_color;
    in property <bool> selected;
    callback clicked();

    horizontal-stretch: 1;
    min-width: 118px;
    min-height: max(50px * TouchScale.widget_scale, card_layout.min-height);
    border-radius: MaterialStyleMetrics.border_radius_10;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? root.primary_color : MaterialPalette.outline_variant;
    background: root.selected ? transparent : MaterialPalette.surface;
    opacity: touch.pressed ? 0.8 : 1.0;
    animate opacity { duration: 80ms; easing: ease-out; }

    card_layout := VerticalLayout {
        alignment: center;
        padding-left: MaterialStyleMetrics.padding_6;
        padding-right: MaterialStyleMetrics.padding_6;
        padding-top: MaterialStyleMetrics.padding_4;
        padding-bottom: MaterialStyleMetrics.padding_4;
        spacing: MaterialStyleMetrics.spacing_2;

        MaterialText {
            text: root.name;
            style: MaterialTypography.label_large;
            color: root.primary_color;
            horizontal-alignment: center;
            overflow: elide;
            wrap: no-wrap;
        }
        MaterialText {
            text: root.accent_name;
            style: MaterialTypography.label_small;
            color: root.secondary_color;
            horizontal-alignment: center;
            overflow: elide;
            wrap: no-wrap;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Android-style icon button for settings grid, scaled by `TouchScale.widget_scale`.
component SettingsIconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;

    width: 120px * TouchScale.widget_scale;
    min-height: max(120px * TouchScale.widget_scale, btn_layout.min-height);
    border-radius: MaterialStyleMetrics.border_radius_16;
    background: root.enabled ? MaterialPalette.secondary_container : MaterialPalette.surface_container_highest;
    opacity: root.enabled ? (touch.pressed ? 0.8 : 1.0) : 0.6;
    animate opacity { duration: 80ms; easing: ease-out; }

    btn_layout := VerticalLayout {
        alignment: center;
        padding: MaterialStyleMetrics.padding_8;
        spacing: MaterialStyleMetrics.spacing_12;

        HorizontalLayout {
            alignment: center;
            Image {
                source: root.icon;
                colorize: root.enabled ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                width: MaterialStyleMetrics.icon_size_36;
                height: MaterialStyleMetrics.icon_size_36;
                image-fit: contain;
            }
        }

        MaterialText {
            text: root.label;
            style: MaterialTypography.title_medium;
            color: root.enabled ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
            horizontal-alignment: center;
            overflow: elide;
            wrap: no-wrap;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    callback clicked();
}

export component SettingsView inherits VerticalLayout {
    in property <bool> cd_enabled: false;
    in-out property <bool> show_themes: false;
    in-out property <bool> show_widget_preview: false;
    in-out property <string> speaker_alias: "DietPi Speaker";
    in property <int> volume_step_percent: 2;
    in property <int> volume_hud_timeout_ms: 4000;
    in property <int> volume_hud_fade_ms: 200;
    in property <int> codec_hud_timeout_ms: 30000;

    callback bluetooth_clicked();
    callback vu_meter_clicked();
    callback dsp_clicked();
    callback cd_clicked();
    callback select_theme(int);
    callback cycle_theme();
    callback font_scale_changed(float);
    callback set_marquee_fps(int);
    callback set_volume_step_percent(int);
    callback set_volume_hud_timeout_ms(int);
    callback set_volume_hud_fade_ms(int);
    callback set_codec_hud_timeout_ms(int);

    padding: root.show_widget_preview ? 0px : MaterialStyleMetrics.padding_12;
    spacing: MaterialStyleMetrics.spacing_6;

    // View 1: Android-style icon button grid
    if !root.show_themes : VerticalLayout {
        vertical-stretch: 1;
        alignment: center;

        HorizontalLayout {
            alignment: center;
            spacing: MaterialStyleMetrics.spacing_16;

            SettingsIconButton {
                icon: @image-url("../../../assets/icons/bluetooth.svg");
                label: "Bluetooth";
                clicked => { root.bluetooth_clicked(); }
            }

            SettingsIconButton {
                icon: @image-url("../../../assets/icons/peppymeter.svg");
                label: "VU Meter";
                clicked => { root.vu_meter_clicked(); }
            }

            SettingsIconButton {
                icon: @image-url("../../../assets/icons/equalizer.svg");
                label: "DSP & EQ";
                clicked => { root.dsp_clicked(); }
            }

            SettingsIconButton {
                icon: @image-url("../../../assets/icons/config.svg");
                label: "Screen Settings";
                clicked => { root.show_themes = true; }
            }

            if root.cd_enabled : SettingsIconButton {
                icon: @image-url("../../../assets/icons/disk.svg");
                label: "CD Player";
                clicked => { root.cd_clicked(); }
            }
        }
    }

    // View 2: Screen Settings — Material 3 settings list with Theme presets,
    // Text Size slider, and live-persisted Advanced steppers.
    if root.show_themes && !root.show_widget_preview : VerticalLayout {
        vertical-stretch: 1;
        spacing: MaterialStyleMetrics.spacing_4;

        // Section 1: Theme presets
        HorizontalLayout {
            spacing: MaterialStyleMetrics.spacing_8;

            ThemePresetCard {
                name: "McIntosh";
                accent_name: "Electric Cyan";
                primary_color: #00C8FF;
                secondary_color: #70E1FF;
                selected: AppTheme.active_preset == 0;
                clicked => { root.select_theme(0); }
            }

            ThemePresetCard {
                name: "Marantz";
                accent_name: "Warm Amber";
                primary_color: #E5A93C;
                secondary_color: #FFD166;
                selected: AppTheme.active_preset == 1;
                clicked => { root.select_theme(1); }
            }

            ThemePresetCard {
                name: "Cyberpunk";
                accent_name: "Synthwave Pink";
                primary_color: #00F0FF;
                secondary_color: #FF007F;
                selected: AppTheme.active_preset == 2;
                clicked => { root.select_theme(2); }
            }

            ThemePresetCard {
                name: "Studio Dark";
                accent_name: "Precision Mono";
                primary_color: #F0F0F0;
                secondary_color: #A0A0A0;
                selected: AppTheme.active_preset == 3;
                clicked => { root.select_theme(3); }
            }

            ThemePresetCard {
                name: "PeppyMeter";
                accent_name: "Vintage Gold";
                primary_color: #F5B83D;
                secondary_color: #FFDF85;
                selected: AppTheme.active_preset == 4;
                clicked => { root.select_theme(4); }
            }
        }

        // Section divider (M3: one divider between groups, none between rows).
        Rectangle {
            height: 1px;
            background: MaterialPalette.outline_variant;
        }

        // Section 2 header: "Advanced".
        MaterialText {
            text: "Advanced";
            style: {
                font_size: MaterialTypography.title_large.font_size,
                font_weight: 700,
            };
            color: MaterialPalette.on_surface;
            vertical-alignment: center;
        }

        // Text Size ("A — Slider — A") setting, live-persisted to config.json.
        FontSizeControl {
            font_scale_changed(val) => { root.font_scale_changed(val); }
        }

        FpsSegmentedRow {
            set_marquee_fps(fps) => { root.set_marquee_fps(fps); }
        }

        // Stepper bounds mirror the Rust config domains (MIN_/MAX_* in
        // crate::config); the Rust callbacks clamp off-grid steps as well.
        SettingsStepperRow {
            label: "Encoder Volume Step";
            value: "\{root.volume_step_percent} %";
            can_decrease: root.volume_step_percent > 1;
            can_increase: root.volume_step_percent < 25;
            decrease => { root.set_volume_step_percent(root.volume_step_percent - 1); }
            increase => { root.set_volume_step_percent(root.volume_step_percent + 1); }
        }

        SettingsStepperRow {
            label: "Volume HUD Timeout";
            value: "\{root.volume_hud_timeout_ms} ms";
            can_decrease: root.volume_hud_timeout_ms > 250;
            can_increase: root.volume_hud_timeout_ms < 30000;
            decrease => { root.set_volume_hud_timeout_ms(root.volume_hud_timeout_ms - 250); }
            increase => { root.set_volume_hud_timeout_ms(root.volume_hud_timeout_ms + 250); }
        }

        SettingsStepperRow {
            label: "Volume HUD Fade";
            value: "\{root.volume_hud_fade_ms} ms";
            can_decrease: root.volume_hud_fade_ms > 0;
            can_increase: root.volume_hud_fade_ms < 2000;
            decrease => { root.set_volume_hud_fade_ms(root.volume_hud_fade_ms - 100); }
            increase => { root.set_volume_hud_fade_ms(root.volume_hud_fade_ms + 100); }
        }

        SettingsStepperRow {
            label: "Codec HUD Timeout";
            value: "\{root.codec_hud_timeout_ms} ms";
            can_decrease: root.codec_hud_timeout_ms > 250;
            can_increase: root.codec_hud_timeout_ms < 300000;
            decrease => { root.set_codec_hud_timeout_ms(root.codec_hud_timeout_ms - 1000); }
            increase => { root.set_codec_hud_timeout_ms(root.codec_hud_timeout_ms + 1000); }
        }

        // Stretch spacer keeps the settings list top-aligned in the viewport.
        Rectangle {
            vertical-stretch: 1;
        }
    }

    // View 3: 800x480 Widget Scale Audit & Interactive Showcase
    if root.show_themes && root.show_widget_preview : TouchScaleShowcase {
        vertical-stretch: 1;
        speaker_alias <=> root.speaker_alias;
        font_scale_changed(val) => {
            root.font_scale_changed(val);
        }
    }
}
