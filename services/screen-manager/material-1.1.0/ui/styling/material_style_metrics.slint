// Patched for 800x480 appliance panel (see THEME_MIGRATION_PLAN.md P4):
// `out` -> `in-out`, compact metrics (was in material_metrics_override.slint).
// Added `border_radius_10` (used by settings_view.slint, missing upstream).
export global MaterialStyleMetrics {
    // sizes
    in-out property <length> size_1: 1px;
    in-out property <length> size_2: 2px;
    in-out property <length> size_3: 3px;
    in-out property <length> size_4: 4px;
    in-out property <length> size_6: 6px;
    in-out property <length> size_8: 8px;
    in-out property <length> size_14: 14px;
    in-out property <length> size_16: 16px;
    in-out property <length> size_18: 18px;
    in-out property <length> size_20: 20px;
    in-out property <length> size_24: 24px;
    in-out property <length> size_30: 28px;
    in-out property <length> size_32: 32px;
    in-out property <length> size_36: 36px;
    in-out property <length> size_38: 36px;
    in-out property <length> size_40: 40px;
    in-out property <length> size_48: 48px;
    in-out property <length> size_49: 49px;
    in-out property <length> size_52: 52px;
    in-out property <length> size_56: 56px;
    in-out property <length> size_64: 56px;
    in-out property <length> size_72: 64px;
    in-out property <length> size_80: 72px;
    in-out property <length> size_90: 80px;
    in-out property <length> size_200: 160px;
    in-out property <length> size_256: 200px;
    in-out property <length> size_344: 280px;
    in-out property <length> size_360: 300px;
    in-out property <length> size_400: 400px;
    in-out property <length> size_480: 480px;
    in-out property <length> size_572: 480px;
    in-out property <length> size_640: 520px;

    // icon
    in-out property <length> icon_size_18: 24px;
    in-out property <length> icon_size_24: 32px;
    in-out property <length> icon_size_36: 48px;
    in-out property <length> icon_size_90: 56px;

    // padding
    in-out property <length> padding_4: 4px;
    in-out property <length> padding_6: 6px;
    in-out property <length> padding_10: 10px;
    in-out property <length> padding_12: 12px;
    in-out property <length> padding_8: 8px;
    in-out property <length> padding_14: 14px;
    in-out property <length> padding_16: 16px;
    in-out property <length> padding_20: 16px;
    in-out property <length> padding_24: 20px;
    in-out property <length> padding_28: 24px;
    in-out property <length> padding_30: 24px;
    in-out property <length> padding_44: 32px;
    in-out property <length> padding_56: 40px;

    // spacing
    in-out property <length> spacing_2: 2px;
    in-out property <length> spacing_6: 6px;
    in-out property <length> spacing_4: 4px;
    in-out property <length> spacing_8: 8px;
    in-out property <length> spacing_12: 12px;
    in-out property <length> spacing_16: 16px;
    in-out property <length> spacing_40: 24px;
    in-out property <length> spacing_52: 32px;

    // border_radius
    in-out property <length> border_radius_2: 2px;
    in-out property <length> border_radius_4: 4px;
    in-out property <length> border_radius_8: 8px;
    in-out property <length> border_radius_10: 10px;
    in-out property <length> border_radius_12: 12px;
    in-out property <length> border_radius_16: 16px;
    in-out property <length> border_radius_28: 28px;
}
