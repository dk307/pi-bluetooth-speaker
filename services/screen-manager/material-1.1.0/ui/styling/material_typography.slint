export struct TextStyle {
    font_size: length,
    font_weight: int
}

// Patched for 800x480 appliance panel (see THEME_MIGRATION_PLAN.md P4):
// `out` -> `in-out`, compact scale (was in material_typography_override.slint).
export global MaterialTypography {
    in-out property <int> regular: 400;
    in-out property <int> medium: 600;
    in-out property <int> semibold: 700;

    in-out property <TextStyle> display_large: {
        font_size: 32px,
        font_weight: root.regular
    };

    in-out property <TextStyle> display_medium: {
        font_size: 28px,
        font_weight: root.regular
    };

    in-out property <TextStyle> display_small: {
        font_size: 24px,
        font_weight: root.regular
    };

    in-out property <TextStyle> headline_large: {
        font_size: 22px,
        font_weight: root.regular
    };

    in-out property <TextStyle> headline_medium: {
        font_size: 20px,
        font_weight: root.regular
    };

    in-out property <TextStyle> headline_small: {
        font_size: 18px,
        font_weight: root.regular
    };

    in-out property <TextStyle> title_large: {
        font_size: 18px,
        font_weight: root.regular
    };

    in-out property <TextStyle> title_medium: {
        font_size: 16px,
        font_weight: root.medium
    };

    in-out property <TextStyle> title_small: {
        font_size: 14px,
        font_weight: root.medium
    };

    in-out property <TextStyle> label_large: {
        font_size: 14px,
        font_weight: root.medium
    };

    in-out property <TextStyle> label_medium: {
        font_size: 12px,
        font_weight: root.medium
    };

    in-out property <TextStyle> label_medium_prominent: {
        font_size: 12px,
        font_weight: root.semibold
    };

    in-out property <TextStyle> label_small: {
        font_size: 11px,
        font_weight: root.medium
    };

    in-out property <TextStyle> body_large: {
        font_size: 16px,
        font_weight: root.regular
    };

    in-out property <TextStyle> body_medium: {
        font_size: 14px,
        font_weight: root.regular
    };

    in-out property <TextStyle> body_small: {
        font_size: 12px,
        font_weight: root.regular
    };
}
