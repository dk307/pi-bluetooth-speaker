		iface MIXER
		name '0.1 Mono Channel Gain'
		value 0
		comment {
			access 'read write'
			type INTEGER
			count 1
			range '-110 - 0'
		}
	}
	control.25 {
		iface MIXER
		name '0.1 Crossover Frequency'
		value OFF
		comment {
			access 'read write'
			type ENUMERATED
			count 1
			item.0 OFF
			item.1 '60 Hz'
			item.2 '70 Hz'
			item.3 '80 Hz'
			item.4 '90 Hz'
			item.5 '100 Hz'
			item.6 '110 Hz'
			item.7 '120 Hz'
			item.8 '130 Hz'
			item.9 '140 Hz'
			item.10 '150 Hz'
		}
	}
}
