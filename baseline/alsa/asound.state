state.LouderRaspberry {
	control.1 {
		iface MIXER
		name '2.0 Digital Volume'
		value 103
		comment {
			access 'read write'
			type INTEGER
			count 1
			range '0 - 127'
		}
	}
	control.2 {
		iface MIXER
		name '2.0 Analog Gain'
		value 25
		comment {
			access 'read write'
			type INTEGER
			count 1
			range '0 - 31'
			dbmin -1550
			dbmax 0
			dbvalue.0 -300
		}
	}
	control.3 {
		iface MIXER
		name '2.0 Equalizer'
		value Off
		comment {
			access 'read write'
			type ENUMERATED
			count 1
			item.0 On
			item.1 Off
		}
	}
	control.4 {
		iface MIXER
		name '2.0 Channel Left Gain'
		value 0
		comment {
			access 'read write'
			type INTEGER
			count 1
			range '-110 - 0'
		}
	}
	control.5 {
		iface MIXER
		name '2.0 Channel Right Gain'
		value 0
		comment {
			access 'read write'
			type INTEGER
			count 1
			range '-110 - 0'
		}
	}
	control.6 {
		iface MIXER
		name '2.0 00020 Hz'
		value 0
