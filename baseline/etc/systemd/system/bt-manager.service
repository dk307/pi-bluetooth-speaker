[Unit]
Description=DietPi Bluetooth Manager & Cover Art Service
After=bluetooth.service bluealsa.service
Requires=bluetooth.service
Wants=bluealsa.service

[Service]
Type=simple
User=root
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/bt-manager
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
