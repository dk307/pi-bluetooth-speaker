[Unit]
Description=DietPi Auto-Brightness Service
Documentation=https://github.com/dk307/pi-bluetooth-speaker
After=local-fs.target dbus.service
Requires=dbus.service

[Service]
Type=dbus
BusName=org.speaker.Autobright
User=root
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/autobright
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
